---
import "@fontsource/inconsolata/400.css";
import "@fontsource/inconsolata/700.css";
import "../styles/global.css";
import Helix from "../components/Helix.astro";
import Hero from "../components/Hero.astro";
import SponsorColumns from "../components/SponsorColumns.astro";
import { truncateDescription } from "../lib/metadata";
import { formatEastern } from "../lib/time";

import { editionInfo, fieldLabel, publicEditions, type Edition } from "../lib/editions";

interface Props {
  title?: string;
  description: string;
  canonicalPath: string;
  lastRun?: string | null;
  landing?: boolean;
  collection?: "materials" | "energy";
  noindex?: boolean;
  edition?: Edition;
  editionSources?: string;
}

const { title = "TrendBio", description, canonicalPath, lastRun, landing = false, edition, collection } = Astro.props;
const summary = truncateDescription(description);
const canonical = new URL(canonicalPath, Astro.site).href;
const directory = canonicalPath === "/fields/";
const otherPilot = edition && edition !== "computer-information" && editionInfo[edition].stage === "Pilot" ? edition : undefined;
const fieldLink = otherPilot === "agriculture-food-veterinary" ? "Agriculture" : otherPilot === "astronomy" ? "Astronomy" : otherPilot && editionInfo[otherPilot].label;
const compBio = canonicalPath === "/" || /^\/(day|week|month|topic|topics|map|archive)(\/|$)/.test(canonicalPath);
const searchField = edition ?? collection ?? (compBio ? "computational" : undefined);
const feed = collection ? undefined : !edition ? "/feed.xml" : publicEditions.includes(edition) ? `/${edition}/feed.xml` : undefined;
const card = collection ?? edition;
const cardLabel = collection === "energy" ? "Energy Storage & Power Grids" : collection ? "Materials Science" : edition ? fieldLabel(edition) : "Computational Biology";
const feedLabel = edition ? `${fieldLabel(edition)} feed` : "TrendBio RSS";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>let t;try{t=localStorage.getItem('trendbio-theme')}catch{}document.documentElement.dataset.theme=/^(dark|light)$/.test(t)?t:matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="oklch(14.5% 0 0)" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="description" content={summary} />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    {feed && <link rel="alternate" type="application/atom+xml" title={feedLabel} href={feed} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TrendBio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL(card ? `/og/${card}.png` : "/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={card ? `TrendBio — ${cardLabel}` : "TrendBio — What moved in computational biology"} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main" tabindex="0">Skip to content</a>
    <div class="page-shell">
    <header class:list={{ "home-header": landing }}>
      <div class="header-top">
      <a class="wordmark" href="/">{landing && <Helix staticMark />}TrendBio</a>
      <nav aria-label="Main navigation">
        <div class="field-bar">
          <div class="field-links" role="group" aria-label="Science field">
            <a href="/fields/" aria-label={otherPilot ? `Browse science fields, current field: ${fieldLabel(otherPilot)}` : "Browse science fields"} aria-current={directory ? "page" : otherPilot ? "location" : undefined}>{fieldLink ?? "Fields"}</a>
            <a href="/biology/" aria-current={edition === "biology" ? "true" : undefined}>Biology</a>
            <a href="/" aria-current={compBio ? "true" : undefined}>CompBio</a>
            {publicEditions.filter(field => field !== "biology").map(field =>
              <a href={`/${field}/`} aria-current={edition === field ? "true" : undefined}>{editionInfo[field].label}</a>)}
            <a href="/computer-information/" aria-current={edition === "computer-information" ? "true" : undefined}>Computer Science</a>
          </div>
        </div>
        <div class="nav-links">
          {!edition && !collection && <>
            <a href="/">Today</a>
            <a href="/topics">Topics</a>
            <a href="/map/">Map</a>
            <a href="/archive">Archive</a>
            <a href="/about">About</a>
          </>}
          {edition && (publicEditions.includes(edition) ? <>
            <a href={`/${edition}/`}>Today</a><a href={`/${edition}/topics/`}>Topics</a>
            <a href={`/${edition}/map/`}>Map</a><a href={`/${edition}/archive/`}>Archive</a><a href="/about/">About</a>
          </> : <>
            <a href={`/${edition}/`}>Latest</a><a href={`/${edition}/#rankings`}>Topics</a>
            <a href={`/${edition}/#editions`}>Archive</a><a href={`/${edition}/#sources`}>Sources</a><a href="/about/">About</a>
          </>)}
          {collection && <><a href={`/collections/${collection}/`}>Collection</a><a href={`/collections/${collection}/#topics`}>Topics</a><a href={`/collections/${collection}/#sources`}>Sources</a><a href="/about/">About</a></>}
          <button id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false">Theme <span aria-hidden="true">☾</span></button>
        </div>
      </nav>
      </div>
      {landing && <Hero field={collection ?? edition ?? "computational"} updated={lastRun} />}
      {canonicalPath !== "/search/" && <form class="header-search" role="search" action="/search/" method="get">
        <label class="sr-only" for="header-search-query">Search topics</label>
        <input id="header-search-query" type="search" name="q" placeholder="Search topics, papers, tools" />
        {searchField && <input type="hidden" name="field" value={searchField} />}
        <div id="header-search-panel" hidden>
          <div id="header-search-options" role="listbox" aria-label="Search results"></div>
          <p id="header-search-message" data-loading="Searching…" data-empty="No results found"></p>
          <a id="header-search-all" tabindex="-1">See all results</a>
        </div>
        <span id="header-search-status" class="sr-only" role="status" aria-live="polite"></span>
      </form>}
    </header>
    <script src="../scripts/header-search.js"></script>
    <script is:inline>
      (()=>{const b=document.getElementById('theme-toggle'),h=document.documentElement;function sync(){const l=h.dataset.theme==='light';b.setAttribute('aria-label','Switch to '+(l?'dark':'light')+' theme');b.setAttribute('aria-pressed',String(l));b.lastElementChild.textContent=l?'☀':'☾'}sync();b.onclick=()=>{h.dataset.theme=h.dataset.theme==='light'?'dark':'light';try{localStorage.setItem('trendbio-theme',h.dataset.theme)}catch{}sync()}})();
    </script>
    <!--email_off--><main id="main" tabindex="-1"><slot /></main><!--/email_off-->
    <script>
      function revealTarget(hash: string) {
        if (!hash) return;
        let id: string;
        try { id = decodeURIComponent(hash.slice(1)); } catch { return; }
        const target = document.getElementById(id);
        let opened = false;
        for (let details = target?.closest("details"); details; details = details.parentElement?.closest("details")) {
          if (!details.open) { details.open = true; opened = true; }
        }
        if (opened) target?.scrollIntoView();
      }
      revealTarget(location.hash);
      window.addEventListener("hashchange", () => revealTarget(location.hash));
      document.addEventListener("click", event => {
        const link = event.target instanceof Element && event.target.closest<HTMLAnchorElement>("a[href]");
        if (!link || event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        if (link.origin === location.origin && link.pathname === location.pathname && link.search === location.search) revealTarget(link.hash);
      });
    </script>
    <SponsorColumns heroAligned={landing} />
    </div>
    <footer>
      {collection ? <p>Source records from arXiv and Crossref.</p> : <p>Auto-curated from {Astro.props.editionSources ?? (edition ? editionInfo[edition].source : "bioRxiv, arXiv, PubMed, GitHub and industry sources")}. Summaries are machine-generated.</p>}
      {feed && <p>{!edition && <><a href="/about">How this works</a> · </>}<a href={feed}>{edition ? feedLabel : "RSS"}</a></p>}
      {lastRun && <p>Last pipeline run: <time datetime={lastRun}>{formatEastern(lastRun)}</time></p>}
    </footer>
  </body>
</html>
