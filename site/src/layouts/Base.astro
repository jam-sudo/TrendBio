---
import "@fontsource/inconsolata/400.css";
import "@fontsource/inconsolata/700.css";
import "../styles/global.css";
import SponsorColumns from "../components/SponsorColumns.astro";
import { truncateDescription } from "../lib/metadata";
import { formatEastern } from "../lib/time";

interface Props {
  title?: string;
  description: string;
  canonicalPath: string;
  lastRun?: string | null;
  heroAligned?: boolean;
  noindex?: boolean;
}

const { title = "TrendBio", description, canonicalPath, lastRun, heroAligned = false } = Astro.props;
const summary = truncateDescription(description);
const canonical = new URL(canonicalPath, Astro.site).href;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>let t;try{t=localStorage.getItem('trendbio-theme')}catch{}document.documentElement.dataset.theme=/^(dark|light)$/.test(t)?t:matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="oklch(14.5% 0 0)" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="description" content={summary} />
    {Astro.props.noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/atom+xml" title="TrendBio RSS" href="/feed.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TrendBio" />
    <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TrendBio — What moved in computational biology" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell">
    <header>
      {Astro.slots.has("hero") ? <slot name="hero" /> : <a class="wordmark" href="/">TrendBio</a>}
      <nav aria-label="Main navigation">
        <div class="nav-links">
          <a href="/">Today</a>
          <a href="/topics">Topics</a>
          <a href="/map/">Map</a>
          <a href="/archive">Archive</a>
          <a href="/about">About</a>
          <button id="theme-toggle" type="button" aria-label="Switch to light theme" aria-pressed="false">Theme <span aria-hidden="true">☾</span></button>
        </div>
      </nav>
      {canonicalPath !== "/search/" && <form class="header-search" role="search" action="/search/" method="get">
        <label class="sr-only" for="header-search-query">Search topics</label>
        <input id="header-search-query" type="search" name="q" placeholder="Search topics, papers, tools" />
        <div id="header-search-panel" hidden>
          <div id="header-search-options" role="listbox" aria-label="Topics"></div>
          <p id="header-search-message"></p>
          <a id="header-search-all" tabindex="-1">See all results</a>
        </div>
        <span id="header-search-status" class="sr-only" role="status" aria-live="polite"></span>
      </form>}
    </header>
    <script src="../scripts/header-search.js"></script>
    <script is:inline>
      (()=>{const b=document.getElementById('theme-toggle'),h=document.documentElement;function sync(){const l=h.dataset.theme==='light';b.setAttribute('aria-label','Switch to '+(l?'dark':'light')+' theme');b.setAttribute('aria-pressed',String(l));b.lastElementChild.textContent=l?'☀':'☾'}sync();b.onclick=()=>{h.dataset.theme=h.dataset.theme==='light'?'dark':'light';try{localStorage.setItem('trendbio-theme',h.dataset.theme)}catch{}sync()}})();
    </script>
    <main id="main"><slot /></main>
    <SponsorColumns {heroAligned} />
    </div>
    <footer>
      <p>Auto-curated from bioRxiv, arXiv, PubMed, GitHub and industry sources. Summaries are machine-generated.</p>
      <p><a href="/about">How this works</a> · <a href="/feed.xml">RSS</a></p>
      {lastRun && <p>Last pipeline run: <time datetime={lastRun}>{formatEastern(lastRun)}</time></p>}
    </footer>
  </body>
</html>
