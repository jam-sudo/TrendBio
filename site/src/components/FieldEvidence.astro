---
import PublicationEvidence from "./PublicationEvidence.astro";
import { loadCorrection, loadItems, loadTopic } from "../lib/data";
import type { Edition } from "../lib/editions";
import type { Day, RankedTopic } from "../lib/types";

interface Props { field: Edition; day: Day; row: RankedTopic; expanded?: boolean }
const { field, day, row, expanded = false } = Astro.props;
const humanities = field === "humanities-arts";
const languageNames = new Intl.DisplayNames(["en"], { type: "language" });
const topic = loadTopic(field, row.slug);
const entry = topic?.history.find(entry => entry.date === day.date);
const papers = loadItems(field, entry?.item_ids ?? []);
const singleSource = day.run.notes.includes(`synthesis-fallback:${row.slug}`);
const synthesis = singleSource ? null
  : row.synthesis ?? (topic?.synthesized_on === day.date ? topic?.synthesis : null);
const correction = loadCorrection(field, day.date, row.slug, [row.headline, row.summary, synthesis ?? ""], entry?.item_ids ?? []);
---
{singleSource && <p><small>This headline and summary describe one supporting work.</small></p>}
{correction && <aside class="correction" role="note"><strong>Editorial correction</strong><div set:html={correction} /></aside>}
{papers.length > 0 && <details open={expanded}>
  <summary>{papers.length} supporting {humanities ? (papers.length === 1 ? "work" : "works") : (papers.length === 1 ? "paper" : "papers")}</summary>
  {synthesis && <p>{synthesis}</p>}
  <ul>{papers.map(paper => <li>{humanities || typeof paper.metadata.conference === "string" ? <PublicationEvidence paper={paper} /> : <a href={paper.url}>{paper.title}</a>}{["crossref", "drops", "oai", "europepmc", "worldbank"].includes(paper.source) && typeof paper.metadata.license === "string" && <>
    {typeof paper.metadata.conference !== "string" && <> · <span translate="no">{paper.authors.join(", ")}</span></>} · <a href={paper.metadata.license}>{paper.metadata.license.includes("/publicdomain/zero/") ? "CC0" : "CC BY"}</a></>}
    {paper.source === "worldbank" && <> · <span>Working paper</span></>}
    {paper.source === "europepmc" && paper.doi && <> · <a href={`https://doi.org/${paper.doi}`}>Publisher article</a></>}
    {paper.source === "crossref" && typeof paper.metadata.pmid === "string" && /^\d+$/.test(paper.metadata.pmid) && <> · <a href={`https://pubmed.ncbi.nlm.nih.gov/${paper.metadata.pmid}/`}>Indexed abstract</a></>}
    {typeof paper.metadata.screening_status === "string" && <> · <strong>Currently excluded from new editions</strong></>}
    {Array.isArray(paper.metadata.correction_links) && paper.metadata.correction_links.filter(link => typeof link === "string" && /^https:\/\/(?:pubmed\.ncbi\.nlm\.nih\.gov|pmc\.ncbi\.nlm\.nih\.gov|doi\.org)\//.test(link)).map(link => <> · {paper.doi && link === `https://doi.org/${paper.doi}`
      ? <a href={`https://crossmark.crossref.org/dialog/?doi=${encodeURIComponent(paper.doi)}`}>Publisher correction history</a>
      : <a href={link}>Linked correction</a>}</>)}
    {["oai", "europepmc"].includes(paper.source) && typeof paper.metadata.language === "string" && /^[a-z]{2,3}$/.test(paper.metadata.language) && <> · <span>{`Original publication in ${languageNames.of(paper.metadata.language)}`}</span></>}
    {Array.isArray(paper.metadata.preprint_dois) && paper.metadata.preprint_dois.filter(doi => typeof doi === "string" && /^10\.\d{4,9}\/\S+$/i.test(doi)).map(doi => <> · <a href={`https://doi.org/${doi}`}>Preprint version</a></>)}
    {Array.isArray(paper.metadata.dataset_dois) && paper.metadata.dataset_dois.length > 0 && <ul>{paper.metadata.dataset_dois.map(doi => <li><a href={`https://doi.org/${doi}`}>Dataset {doi}</a></li>)}</ul>}
  </li>)}</ul>
</details>}
<style>
  .correction { border-inline-start: 3px solid currentColor; padding-inline-start: .75rem; margin: 1rem 0; }
  details p { margin-top: .75rem; }
  summary { cursor: pointer; }
</style>
