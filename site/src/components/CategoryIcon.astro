---
import { categoryStyle, type CardField } from "../lib/categories";

interface Props { slug: string; size: 16 | 36; field?: CardField }
const { slug, size, field } = Astro.props;
const { hue, icon } = categoryStyle(slug, field);
---
<svg class:list={["category-icon", { "category-tile": size === 36 }]}
  viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
  style={`--category-hue: ${hue}`} set:html={icon} />

<style>
  .category-icon { display: inline-block; flex-shrink: 0; vertical-align: middle; color: oklch(var(--icon-lightness) var(--icon-chroma) var(--category-hue)); }
  .category-tile { padding: 4px; }
</style>
