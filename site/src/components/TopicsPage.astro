---
import CategoryIcon from "./CategoryIcon.astro";
import { fieldPath, fieldLabel, type Field } from "../lib/editions";
import Base from "../layouts/Base.astro";
import CategoryChips from "./CategoryChips.astro";
import { rankedTopics, latestDay, loadTaxonomy, orphanNotes } from "../lib/data";
import { topicSnapshot } from "../lib/citations";

interface Props { field?: Field }
const { field = "computational" } = Astro.props;
const prefix = fieldPath(field);
const label = field === "computational" ? "computational biology" : fieldLabel(field);
const domain = field;
const categories = loadTaxonomy(domain);
const topics = rankedTopics(domain).map(topic => {
  const { entry, issue, headline, category } = topicSnapshot(topic, field);
  return { slug: topic.slug, headline, category, categories: [category, ...(entry?.secondary_categories ?? [])],
    label: entry?.date === topic.synthesized_on && topic.label !== headline ? topic.label : null,
    lastRanked: issue?.day.date ?? entry?.date };
});
const counts = Object.fromEntries(categories.map(({ slug }) => [
  slug, topics.filter(topic => topic.categories.includes(slug)).length,
]));
for (const slug of field === "computational" ? orphanNotes(domain) : []) console.warn(`orphan note: ${slug}`);
---

<Base edition={field === "computational" ? undefined : field} description={`Browse ${label} topics and their latest rankings on TrendBio.`} canonicalPath={`${prefix}/topics/`} title="Topics — TrendBio" lastRun={latestDay(domain)?.run.finished}>
  <h1>Topics</h1>
  <CategoryChips {field} categories={categories} counts={counts} />
  <table class="topics">
    <thead><tr><th scope="col">Topic</th><th scope="col">Category</th><th scope="col">Last ranked</th></tr></thead>
    <tbody>{topics.map(topic => <tr data-topic-cats={topic.categories.join(" ")}>
      <td><a class="topic-name" href={`${prefix}/topic/${topic.slug}/`}>
        <CategoryIcon {field} slug={topic.category} size={36} />
        <span><strong>{topic.headline}</strong>{topic.label && <span class="topic-label">{topic.label}</span>}</span>
      </a></td>
      <td class="category">{categories.find(({ slug }) => slug === topic.category)?.label ?? topic.category}</td>
      <td class="date">{topic.lastRanked && <time datetime={topic.lastRanked}>{topic.lastRanked}</time>}</td>
    </tr>)}</tbody>
  </table>
</Base>
<style>
  .topic-name { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
  .topic-name:hover strong { text-decoration: underline; }
  .topic-label { display: block; color: var(--muted); font-size: var(--t3); }
  .category, .date { color: var(--muted); font-size: var(--t3); }
  .date { white-space: nowrap; }
  @media (max-width: 640px) {
    .topics, tbody { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding-block: 1rem; border-bottom: 1px solid var(--border); }
    td { padding: 0; border: 0; }
    td:first-child { grid-column: 1 / -1; padding-bottom: 0.5rem; }
    .category { padding-left: 52px; padding-right: 0.5rem; }
  }
</style>
