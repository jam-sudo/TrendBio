---
import type { TopicDay } from "../lib/types";

interface Props { history: TopicDay[] }
const { history } = Astro.props;
const sorted = [...history].sort((a, b) => a.date.localeCompare(b.date));
const latest = sorted.at(-1);
const day = 86_400_000;
const end = latest ? Date.parse(latest.date) : 0;
const start = Math.max(end - 55 * day, sorted[0] ? Date.parse(sorted[0].date) : end);
const entries = sorted.filter((entry) => Date.parse(entry.date) >= start);
const days = (end - start) / day + 1;
const maximum = Math.max(1, ...entries.map((entry) => entry.count_7d));
---

{days >= 3 && (
  <figure>
  <svg class="sparkline" viewBox={`0 0 ${days * 10 - 2} 60`} preserveAspectRatio="none" role="img"
    aria-label={`7-day item counts from ${entries[0].date} to ${latest!.date}`}>
    {entries.map((entry) => {
      // Zero days retain a baseline so the full eight-week window stays visible.
      const height = Math.max(2, entry.count_7d / maximum * 60);
      return <rect x={(Date.parse(entry.date) - start) / day * 10} y={60 - height}
        width="8" height={height} data-date={entry.date} class:list={{ today: entry.date === latest!.date }} />;
    })}
  </svg>
  <figcaption><span>Items per day, last 8 weeks</span><span>today: {latest!.count_7d}</span></figcaption>
  </figure>
)}

<style>
  figure { width: 100%; margin: 1.5rem 0; }
  figcaption { display: flex; justify-content: space-between; gap: 0.5rem; color: var(--muted); font-size: var(--t3); margin-top: 0.5rem; }
  .sparkline { display: block; width: 100%; height: 80px; }
  rect { fill: var(--muted); }
  .today { fill: var(--fg); }
</style>
