---
import { fieldPath, fieldLabel, type Field } from "../lib/editions";
import Base from "../layouts/Base.astro";
import TopicMap from "./TopicMap.astro";
import { latestDay, loadMap, loadTaxonomy } from "../lib/data";

interface Props { field?: Field }
const { field = "computational" } = Astro.props;
const prefix = fieldPath(field);
const label = field === "computational" ? "computational biology" : fieldLabel(field);
const domain = field;
const map = loadMap(domain);
---
<Base edition={field === "computational" ? undefined : field} description={`Explore connections between ${label} research topics on the TrendBio map.`} canonicalPath={`${prefix}/map/`} title="Map — TrendBio" lastRun={latestDay(domain)?.run.finished}>
  <h1>Research map</h1>
  <p>Explore how research topics connect. Nearby topics share similar research; lines link each topic to its three closest neighbours. Larger dots represent more items across its history.</p>
  {map?.points.length ? <TopicMap {field} map={map} categories={loadTaxonomy(domain)} /> :
    <p>The research map will appear after the next pipeline run. <a href={`${prefix}/topics/` }>Browse topics</a>.</p>}
</Base>
