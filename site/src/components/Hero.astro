---
import Helix from "./Helix.astro";

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <a class="wordmark" href="/"><Helix staticMark />TrendBio</a>
  <h1 id="hero-title">{title}</h1>
  <p>{subtitle}</p>
  <div class="hero-art"><Helix /></div>
</section>

<style>
  .hero { position: relative; padding: 0 0 0.5rem; text-align: center; }
  .wordmark { margin-bottom: 1.5rem; }
  h1 { position: relative; z-index: 1; max-width: 30ch; margin: 0 auto 1rem; }
  p { position: relative; z-index: 1; color: var(--muted); margin: 0 auto; }
  .hero-art { position: absolute; pointer-events: none; right: 0; top: 0; width: 28%; height: 100%; }
</style>
