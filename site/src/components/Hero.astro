---
import Helix from "./Helix.astro";

interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div>
    <h1 id="hero-title">{title}</h1>
    <p>{subtitle}</p>
  </div>
  <Helix />
</section>

<style>
  .hero {
    height: min(34vh, 320px);
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  h1 { margin: 0 0 1rem; max-width: 24ch; }
  p { color: var(--muted); font-size: var(--t3); margin: 0; }
  @media (max-width: 640px) {
    h1 { font-size: var(--t2); }
  }
</style>
