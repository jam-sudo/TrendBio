---
import type { Signals } from "../lib/types";
import { signalStats, type Stat } from "../lib/leaderboard";
interface Props { signals?: Signals; stats?: Stat[] }
const { signals, stats = signals ? signalStats(signals) : [] } = Astro.props;
const spoken = stats.map(({ label, value, spoken, context }) => spoken ??
  `${label}: ${value}${context ? ` ${context}` : ""}`).join(" · ");
---
{stats.length > 0 && <div class="signal-line">
  <span class="sr-only">{spoken}</span>
  <div class="stat-row" aria-hidden="true">
    {stats.map(({ label, value, context }) => <span class:list={["stat", { rise: label === "Rise" }]}><span class="stat-label">{label}</span><span class="stat-value">{value}</span>{context && <span class="stat-context">{context}</span>}</span>)}
  </div>
</div>}
