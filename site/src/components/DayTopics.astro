---
import CategoryChips from "./CategoryChips.astro";
import TopicCard from "./TopicCard.astro";
import { loadTaxonomy } from "../lib/data";
import type { Day } from "../lib/types";
import type { LeaderboardTopic } from "../lib/leaderboard";
import { readFileSync } from "node:fs";
import { parse } from "yaml";

interface Props {
  topics: LeaderboardTopic[];
  day?: Day | null;
  period?: "week" | "month";
}

const { day, topics: ranked, period } = Astro.props;
const { featured_n, display_open_n, top_n } = parse(readFileSync("../config/scoring.yaml", "utf8"));
const compact = ranked.filter((topic) => topic.rank > featured_n && topic.rank <= display_open_n);
const more = ranked.filter((topic) => topic.rank > display_open_n);
const categories = loadTaxonomy("computational");
const topicCategories = ranked.map((topic) => [
  topic.category, ...topic.secondary_categories,
]);
const counts = Object.fromEntries(categories.map(({ slug }) => [
  slug, topicCategories.filter((slugs) => slugs.includes(slug)).length,
]));
---

<div class="section-heading"><h2>Top {top_n}</h2><a href={period ? `/${period}/` : "/archive/"}>View all ›</a></div>
{day?.run.status === "degraded" && <p class="notice"><span class="badge">PARTIAL</span> Some sources or summaries were unavailable for this run.</p>}
{day?.run.backfilled && <p class="notice"><span class="badge">BACKFILLED</span> Code and industry signals are partial for backfilled days.</p>}
{ranked.length === 0 && <p class="notice"><span class="badge">{period ? "QUIET PERIOD" : "QUIET DAY"}</span> {period ? "No topic history in this period." : "Quiet day: no topic cleared the bar."}</p>}
<CategoryChips categories={categories} counts={counts} />
<div class="topic-list">
  {ranked.filter((topic) => topic.rank <= featured_n).map((topic) => <TopicCard ranked={topic} featured={topic.rank === 1} />)}
</div>
{compact.length > 0 && <div class="compact-list open-list">
  {compact.map((topic) => <TopicCard ranked={topic} compact period={!!period} />)}
</div>}
{more.length > 0 && <details data-more-topics>
  <summary><span class="closed-label">Show {more.length} more</span><span class="open-label">Show less</span></summary>
  <div class="compact-list">
    {more.map((topic) => <TopicCard ranked={topic} compact period={!!period} />)}
  </div>
</details>}

<style>
  .topic-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .open-list { margin-top: 0.5rem; }
  details { margin-top: 1rem; }
  summary { cursor: pointer; padding: 0.75rem 0; font-size: var(--t3); }
  .open-label, details[open] > summary .closed-label { display: none; }
  details[open] > summary .open-label { display: inline; }
  .compact-list { display: flex; flex-direction: column; gap: 4px; }
  .notice { font-size: var(--t3); color: var(--muted); margin-bottom: 1rem; }
</style>
