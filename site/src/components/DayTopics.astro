---
import { editionChanges } from "../lib/rank-changes";
import EditionComparison from "./EditionComparison.astro";
import RankingSignals from "./RankingSignals.astro";
import PeriodLinks from "./PeriodLinks.astro";
import IndustryList from "./IndustryList.astro";
import SharedList from "./SharedList.astro";
import CodeList from "./CodeList.astro";
import CategoryChips from "./CategoryChips.astro";
import TopicCard from "./TopicCard.astro";
import { loadTaxonomy } from "../lib/data";
import type { Day } from "../lib/types";
import type { LeaderboardTopic } from "../lib/leaderboard";
import { scoring } from "../lib/scoring";
import { fieldPath, isDaily, type Field } from "../lib/editions";

interface Props {
  topics: LeaderboardTopic[];
  day?: Day | null;
  period?: "week" | "month";
  field?: Field;
  issueDate?: string;
  heading?: string;
  issueUrl?: string;
  archiveDate?: string;
}

const { day, topics: ranked, period, field = "computational", issueDate = day?.date, heading, issueUrl } = Astro.props;
const { featured_n, display_open_n, top_n } = scoring;
const regular = isDaily(field), prefix = fieldPath(field);
const comparison = day && regular && !period ? editionChanges(day) : null;
const compact = ranked.slice(featured_n, display_open_n);
const more = ranked.slice(display_open_n);
const taxonomy = [...loadTaxonomy(field)];
for (const topic of ranked) {
  if (topic.categoryLabel && !taxonomy.some(category => category.slug === topic.category)) {
    taxonomy.push({ slug: topic.category, label: topic.categoryLabel, covers: "" });
  }
}
const topicCategories = ranked.map((topic) => [
  topic.category, ...topic.secondary_categories,
]);
const counts = Object.fromEntries(taxonomy.map(({ slug }) => [
  slug, topicCategories.filter((slugs) => slugs.includes(slug)).length,
]));
const categories = regular ? taxonomy : taxonomy.filter(category => counts[category.slug]);
const archive = regular ? `${prefix}/archive/` : `${prefix}/#editions`;
---

<div class="section-heading ranking-heading" id="rankings">
  <PeriodLinks {field} current={period ?? "day"} {issueDate} {issueUrl} archiveDate={Astro.props.archiveDate} />
  <h2>{heading ?? (regular ? `Top ${top_n}` : "Pilot rankings")}</h2>
  <a href={period ? `${prefix}/${period}/` : archive}>View all ›</a>
</div>
{day?.run.status === "degraded" && <p class="notice"><span class="badge">PARTIAL</span> Some sources or summaries were unavailable for this run.</p>}
{day?.run.backfilled && <p class="notice"><span class="badge">BACKFILLED</span> {field === "computational" ? "Code and industry signals are partial for backfilled days." : "This edition was assembled after the publication date."}</p>}
{ranked.length === 0 && <p class="notice"><span class="badge">{period ? "QUIET PERIOD" : "QUIET DAY"}</span> {period ? "No topic history in this period." : "Quiet day: no topic cleared the bar."}</p>}
{comparison && <EditionComparison {...comparison} field={day!.domain} />}
{ranked.length > 0 && <CategoryChips {field} categories={categories} counts={counts} />}
<div class="topic-list">
  {ranked.slice(0, featured_n).map((topic, index) => <TopicCard {field} movement={comparison?.rows.get(topic.slug)} ranked={topic} date={issueDate} featured={index === 0} />)}
</div>
{compact.length > 0 && <div class="compact-list open-list">
  {compact.map((topic) => <TopicCard {field} movement={comparison?.rows.get(topic.slug)} ranked={topic} date={issueDate} compact period={!!period} />)}
</div>}
{more.length > 0 && <details data-more-topics>
  <summary><span class="closed-label">Show {more.length} more</span><span class="open-label">Show less</span></summary>
  <div class="compact-list">
    {more.map((topic) => <TopicCard {field} movement={comparison?.rows.get(topic.slug)} ranked={topic} date={issueDate} compact period={!!period} />)}
  </div>
</details>}

{day && regular && !period && <RankingSignals {day} />}
{day && field === "computational" && <><IndustryList day={day.date} /><CodeList day={day.date} /><SharedList day={day.date} /></>}

<style>
  .ranking-heading { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; margin-bottom: 0.5rem; }
  .ranking-heading :global(.period-links) { margin-bottom: 0; }
  .ranking-heading > a { justify-self: end; }
  @media (max-width: 640px) {
    .ranking-heading { grid-template-columns: 1fr auto; gap: 0.5rem; }
    .ranking-heading :global(.period-links) { grid-column: 1 / -1; }
  }
  .topic-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .open-list { margin-top: 0.5rem; }
  details { margin-top: 1rem; }
  summary { cursor: pointer; padding: 0.75rem 0; font-size: var(--t3); }
  .open-label, details[open] > summary .closed-label { display: none; }
  details[open] > summary .open-label { display: inline; }
  .compact-list { display: flex; flex-direction: column; gap: 4px; }
  .notice { font-size: var(--t3); color: var(--muted); margin-bottom: 1rem; }
</style>
