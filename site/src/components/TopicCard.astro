---
import type { TopicMovement } from "../lib/rank-changes";
import RankChange from "./RankChange.astro";
import CrossCoverage from "./CrossCoverage.astro";
import { crossCoverage } from "../lib/shared-papers";
import ToolNames from "./ToolNames.astro";
import CategoryIcon from "./CategoryIcon.astro";
import FeaturedCard from "./FeaturedCard.astro";
import SignalLine from "./SignalLine.astro";
import { loadTaxonomy } from "../lib/data";
import { categoryStyle } from "../lib/categories";
import { datedEvidence, fieldPath, isDaily, type Field } from "../lib/editions";
import type { LeaderboardTopic } from "../lib/leaderboard";
interface Props { field?: Field; movement?: TopicMovement; ranked: LeaderboardTopic; date?: string; featured?: boolean; compact?: boolean; period?: boolean }
const { field = "computational", ranked, movement, date, featured = false, compact = false, period = false } = Astro.props;
const matches = date && isDaily(field) ? crossCoverage(field, date, ranked.slug) : [];
const category = loadTaxonomy(field).find(({ slug }) => slug === ranked.category);
const categoryLabel = ranked.categoryLabel ?? category?.label ?? ranked.category;
const secondary = ranked.secondary_categories;
const rise = ranked.stats.find(({ label }) => label === "Rise");
const identity = categoryStyle(ranked.category, field);
const url = ranked.url ?? (ranked.evidenceDate ? datedEvidence(field, ranked.evidenceDate, ranked.slug) : `${fieldPath(field)}/topic/${ranked.slug}/`);
const papersHref = date && !ranked.evidenceDate ? datedEvidence(field, date, ranked.slug) : undefined;
const correctionHref = ranked.url ?? (date && datedEvidence(field, date, ranked.slug));
const fallbackLabel = ranked.autoLabel ? (ranked.evidenceDate ? " (auto label)" : " (auto label) · Latest topic") : "";
---
{compact ? <article data-rank={ranked.rank} id={date ? ranked.slug : undefined} class:list={["compact-row", { "period-row": period, "has-tool-names": ranked.toolNames.length > 0, "has-coverage": matches.length > 0 }]}
  style={`--category-hue: ${identity.hue}`} data-topic-cats={[ranked.category, ...secondary].join(" ")}>
  <span class="rank"><span class="sr-only">Rank </span>{ranked.rank}</span>
  <CategoryIcon {field} slug={ranked.category} size={16} />
  <div class="compact-copy">
    <a class="topic-link" href={url}><span class="compact-headline">{ranked.headline}{fallbackLabel && <span class="auto-label">{fallbackLabel}</span>}</span></a>
    <ToolNames names={ranked.toolNames} />
    {ranked.correction && correctionHref && <small><a class="editorial" href={correctionHref}>Read editorial correction</a></small>}
    {date && matches.length > 0 && <CrossCoverage {matches} {date} summary={ranked.summary} />}
  </div>
  <div class="compact-meta">
    {ranked.tie && <small>{ranked.tie}</small>}
    <RankChange {movement} {papersHref} />
    {!period && rise && <span class="badge"><span aria-hidden="true">{rise.value} {rise.context}</span><span class="sr-only">{rise.spoken ?? rise.value}</span></span>}
    {ranked.fallbackSummary && <small>Fallback summary</small>}
    <span class="compact-category">{categoryLabel}</span>
  </div>
  {period && <SignalLine stats={ranked.stats} />}
</article> : <FeaturedCard {field} category={ranked.category} {categoryLabel}
  categories={[ranked.category, ...secondary]} rank={ranked.rank} id={date ? ranked.slug : undefined}
  title={ranked.headline} {url} {fallbackLabel} summary={ranked.summary} stats={ranked.stats} {featured}>
  <Fragment slot="movement">{ranked.tie && <small>{ranked.tie}</small>}<RankChange {movement} {papersHref} /></Fragment>
  <ToolNames slot="tools" names={ranked.toolNames} />
  {ranked.correction && correctionHref && <small><a class="editorial" href={correctionHref}>Read editorial correction</a></small>}
  {ranked.fallbackSummary && <small>Fallback summary from source text</small>}
  {date && matches.length > 0 && <CrossCoverage {matches} {date} />}
</FeaturedCard>}
<style>
  .editorial { position: relative; z-index: 1; display: inline-block; padding-block: .25rem; }
  .compact-copy { flex: 1; min-width: 0; }
  .compact-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem; min-width: 0; max-width: 55%; }
  .compact-row.has-tool-names, .compact-row.has-coverage { height: auto; min-height: 56px; padding-block: 0.5rem; }
  .auto-label { color: var(--muted); font-size: var(--t3); font-weight: 400; }
  .compact-row.period-row { height: auto; min-height: 64px; flex-wrap: wrap; padding-block: 0.5rem; }
  @media (max-width: 800px) {
    .period-row :global(.signal-line) { flex-basis: 100%; padding-left: 44px; }
  }
  .compact-row { position: relative; display: flex; align-items: center; gap: 0.75rem; min-height: 40px; padding: .375rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); background: oklch(var(--tint-lightness) 0.015 var(--category-hue)); text-decoration: none; font-size: var(--t3); min-width: 0; }
  .compact-row:hover { border-color: var(--muted); }
  .compact-row .rank { width: 24px; flex-shrink: 0; color: var(--muted); }
  .compact-copy > .topic-link { display: block; min-height: 24px; align-content: center; }
  .compact-headline { display: block; min-width: 0; overflow-wrap: anywhere; }
  .compact-row .badge { max-width: 100%; white-space: normal; }
  .compact-category { max-width: 210px; overflow-wrap: anywhere; font-size: .8125rem; color: var(--muted); }
  @media (max-width: 480px) {
    .compact-row { gap: 6px; padding: 0 6px; font-size: var(--t3); }
    .compact-category { max-width: none; font-size: .8125rem; }
    .compact-row .badge { padding: 2px 4px; }
  }
  @media (width < 640px) {
    .compact-row { display: grid; grid-template-columns: 24px 16px minmax(0, 1fr); height: auto; min-height: 56px; padding-block: 0.5rem; }
    .compact-headline, .compact-category { overflow: visible; text-overflow: clip; white-space: normal; overflow-wrap: anywhere; }
    .compact-meta { grid-column: 3; gap: 0.5rem; max-width: none; }
    .compact-category { max-width: none; }
    .period-row :global(.signal-line) { grid-column: 3; padding-left: 0; }
  }
</style>
