---
import ToolNames from "./ToolNames.astro";
import CategoryIcon from "./CategoryIcon.astro";
import SignalLine from "./SignalLine.astro";
import { loadTaxonomy } from "../lib/data";
import { categoryStyle, rankMedal } from "../lib/categories";
import type { LeaderboardTopic } from "../lib/leaderboard";
interface Props { ranked: LeaderboardTopic; featured?: boolean; compact?: boolean; period?: boolean }
const { ranked, featured = false, compact = false, period = false } = Astro.props;
const category = loadTaxonomy("computational").find(({ slug }) => slug === ranked.category);
const secondary = ranked.secondary_categories;
const rise = ranked.stats.find(({ label }) => label === "Rise");
const identity = categoryStyle(ranked.category);
---
{compact ? <article class:list={["compact-row", { "period-row": period, "has-tool-names": ranked.toolNames.length > 0 }]}
  style={`--category-hue: ${identity.hue}`} data-topic-cats={[ranked.category, ...secondary].join(" ")}>
  <span class="rank"><span class="sr-only">Rank </span>{ranked.rank}</span>
  <CategoryIcon slug={ranked.category} size={16} />
  <div class="compact-copy">
    <a class="topic-link" href={`/topic/${ranked.slug}/`}><span class="compact-headline">{ranked.headline}{ranked.autoLabel && <span class="auto-label"> (auto label)</span>}</span></a>
    <ToolNames names={ranked.toolNames} />
  </div>
  <div class="compact-meta">
    {!period && rise && <span class="badge" aria-label={rise.spoken}>{rise.value}</span>}
    <span class="compact-category">{category?.label ?? ranked.category}</span>
  </div>
  {period && <SignalLine stats={ranked.stats} />}
</article> : <article class:list={["topic-card", { featured }]}
  style={`--category-hue: ${identity.hue}`} data-topic-cats={[ranked.category, ...secondary].join(" ")}>
  <span class="rank"><span aria-hidden="true">{rankMedal(ranked.rank)}</span><span class="sr-only">Rank {ranked.rank}</span></span>
  <CategoryIcon slug={ranked.category} size={36} />
  <div class="topic-copy">
    <p class="rank-category">{category?.label ?? ranked.category}</p>
    <h2><a class="topic-link" href={`/topic/${ranked.slug}/`}>{ranked.headline}{ranked.autoLabel && <span class="auto-label"> (auto label)</span>}</a></h2>
    <ToolNames names={ranked.toolNames} />
    {ranked.summary && <p class="summary">{ranked.summary}</p>}
  </div>
  <SignalLine stats={ranked.stats} />
</article>}
<style>
  .topic-link { text-decoration: none; }
  .topic-link::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius); }
  .topic-link:focus-visible { outline: none; }
  .topic-link:focus-visible::after { outline: 2px solid var(--fg); outline-offset: 4px; }
  .compact-copy { flex: 1; min-width: 0; }
  .compact-meta { display: contents; }
  .compact-row.has-tool-names { height: auto; min-height: 56px; padding-block: 0.5rem; }
  .auto-label { color: var(--muted); font-size: var(--t3); font-weight: 400; }
  .compact-row.period-row { height: auto; min-height: 64px; flex-wrap: wrap; padding-block: 0.5rem; }
  @media (max-width: 800px) {
    .period-row :global(.signal-line) { flex-basis: 100%; padding-left: 44px; }
  }
  .compact-row { position: relative; display: flex; align-items: center; gap: 0.75rem; height: 40px; padding: 0 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); background: oklch(var(--tint-lightness) 0.015 var(--category-hue)); text-decoration: none; font-size: var(--t3); min-width: 0; }
  .compact-row:hover { border-color: var(--muted); }
  .compact-row .rank { width: 24px; flex-shrink: 0; color: var(--muted); }
  .compact-headline { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .compact-row .badge { flex-shrink: 0; white-space: nowrap; }
  .compact-category { max-width: 210px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; color: var(--muted); }
  .topic-card { position: relative; display: grid; grid-template-columns: 24px 36px minmax(0, 1fr) auto; align-items: center; gap: 1rem; border: 1px solid var(--border); border-radius: var(--radius); background: oklch(var(--tint-lightness) 0.015 var(--category-hue)); padding: 1.25rem; min-width: 0; overflow-wrap: anywhere; text-decoration: none; }
  .topic-card:hover { border-color: var(--muted); }
  .rank { text-align: center; }
  .rank-category { width: fit-content; font-size: 9px; font-weight: 700; color: var(--fg); background: oklch(var(--tile-lightness) 0.06 var(--category-hue)); padding: 2px 8px; border-radius: 4px; margin: 0 0 0.5rem; }
  h2 { margin: 0 0 0.375rem; }
  .summary { font-size: var(--t3); color: var(--muted); margin: 0; }
  .featured .summary { font-size: var(--t2); }
  @media (max-width: 800px) {
    .topic-card { grid-template-columns: 24px 36px minmax(0, 1fr); gap: 0.75rem; padding: 1rem; }
    .topic-card :global(.signal-line) { grid-column: 3; }
  }
  @media (max-width: 480px) {
    .compact-row { gap: 6px; padding: 0 6px; font-size: 12px; }
    .compact-category { max-width: 65px; font-size: 10px; }
    .compact-row .badge { padding: 2px 4px; }
    .topic-card { grid-template-columns: 24px 36px minmax(0, 1fr); align-items: start; }
    .topic-copy { grid-column: 1 / -1; }
    .rank-category { position: absolute; top: 1rem; right: 1rem; max-width: calc(100% - 110px); margin: 0; }
    .topic-card :global(.signal-line) { grid-column: 1 / -1; padding-top: 0.5rem; border-top: 1px solid var(--border); }
    .rank { align-self: center; }
    .topic-card :global(.category-tile) { grid-column: 2; }
  }
  @media (width < 640px) {
    .compact-row { display: grid; grid-template-columns: 24px 16px minmax(0, 1fr); height: auto; min-height: 56px; padding-block: 0.5rem; }
    .compact-headline, .compact-category { overflow: visible; text-overflow: clip; white-space: normal; overflow-wrap: anywhere; }
    .compact-meta { grid-column: 3; display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; min-width: 0; }
    .compact-category { max-width: none; }
    .period-row :global(.signal-line) { grid-column: 3; padding-left: 0; }
  }
</style>
