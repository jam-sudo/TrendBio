---
import { loadPeriods } from "../lib/period-data";
import { fieldPath, isDaily, type Field } from "../lib/editions";
interface Props { current: "day" | "week" | "month"; field?: Field; issueDate?: string; issueUrl?: string; archiveDate?: string; index?: boolean }
const { current, field = "computational", issueDate, issueUrl, archiveDate, index } = Astro.props;
const prefix = fieldPath(field);
const data = isDaily(field) ? loadPeriods(field) : null;
const week = archiveDate ? data?.weeks.find(p => p.start <= archiveDate && archiveDate <= p.end) : data?.weeks[0];
const month = archiveDate ? data?.months.find(p => p.start <= archiveDate && archiveDate <= p.end) : data?.months[0];
const links = data ? [
  { kind: "day", label: archiveDate ? "Day" : "Today", href: archiveDate ? `${prefix}/day/${archiveDate}/` : `${prefix}/` },
  { kind: "week", label: index ? "Weeks" : archiveDate ? "Week" : "This week", href: !index && week ? `${prefix}/week/${week.id}/` : `${prefix}/week/` },
  { kind: "month", label: index ? "Months" : archiveDate ? "Month" : "This month", href: !index && month ? `${prefix}/month/${month.id}/` : `${prefix}/month/` },
] : [
  { kind: "day", label: issueDate ?? "Pilot", href: issueUrl ?? `${prefix}/` },
  { kind: "archive", label: "Editions", href: `${prefix}/#editions` },
];
---
<nav class="period-links" aria-label="Ranking period">
  {links.map(({ kind, label, href }) => <a href={href} aria-current={kind === current ? "page" : undefined}>{label}</a>)}
</nav>
<style>
  .period-links { display: flex; width: fit-content; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 4px; margin-bottom: 1.5rem; background: var(--card); }
  a { padding: 0.375rem 0.75rem; border-radius: 4px; text-decoration: none; font-size: var(--t3); }
  a[aria-current] { background: var(--accent); color: var(--bg); font-weight: 700; }
</style>
