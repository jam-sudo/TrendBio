---
import { loadPeriods } from "../lib/period-data";
interface Props { current: "day" | "week" | "month" }
const { current } = Astro.props;
const { weeks, months } = loadPeriods();
const links = [
  { kind: "day", label: "Today", href: "/" },
  { kind: "week", label: "This week", href: weeks[0] ? `/week/${weeks[0].id}/` : "/week/" },
  { kind: "month", label: "This month", href: months[0] ? `/month/${months[0].id}/` : "/month/" },
];
---
<nav class="period-links" aria-label="Ranking period">
  {links.map(({ kind, label, href }) => <a href={href} aria-current={kind === current ? "page" : undefined}>{label}</a>)}
</nav>
<style>
  .period-links { display: flex; width: fit-content; border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 4px; margin-bottom: 1.5rem; background: var(--card); }
  a { padding: 0.375rem 0.75rem; border-radius: 4px; text-decoration: none; font-size: var(--t3); }
  a[aria-current] { background: var(--accent); color: var(--bg); font-weight: 700; }
</style>
