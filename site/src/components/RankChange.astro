---
import type { RankChange } from "../lib/rank-changes";
interface Props { change?: RankChange }
const { change } = Astro.props;
---
{change && <span class="rank-change"><span aria-hidden="true">{change.label}</span><span class="sr-only">{change.description}</span></span>}
<style>
  .rank-change { color: var(--muted); font-size: 11px; font-weight: 400; white-space: nowrap; flex-shrink: 0; }
</style>
