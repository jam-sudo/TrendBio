---
import geometry from "./helix-paths.json";
interface Props { staticMark?: boolean }
const { staticMark = false } = Astro.props;
const id = staticMark ? "dna-mark" : "dna-hero";
const width = staticMark ? geometry.pitch : geometry.period;
---

<svg class={staticMark ? "logo-mark" : "helix"} viewBox={`0 0 ${width} 120`}
  aria-hidden="true" role="presentation" focusable="false">
  <defs>
    <clipPath id={`${id}-window`}><rect width={width} height="120" /></clipPath>
    <g id={`${id}-period`} clip-path={`url(#${id}-window)`} fill="none" stroke-linecap="round">
      {[false, true].map(front => <g>
        {geometry.rungs.flatMap(rung => rung.segments.filter(segment => segment.front === front).map(segment =>
          <line x1={segment.x1} y1={segment.y1} x2={segment.x2} y2={segment.y2}
            stroke="var(--muted)" stroke-width={staticMark ? 5 : 1.5} stroke-opacity={segment.opacity} />))}
        {geometry.backbones.flatMap(backbone => backbone.segments.filter(segment => segment.front === front).map(segment =>
          <path d={segment.d} stroke="var(--fg)" stroke-width={staticMark ? 9 : 2.5} stroke-opacity={front ? 1 : 0.35} />))}
      </g>)}
    </g>
  </defs>
  <g clip-path={`url(#${id}-window)`}>
    <g class:list={{ "helix-flow": !staticMark }} style={`--period: -${geometry.period}px`}>
      <use href={`#${id}-period`} />
      {!staticMark && <use href={`#${id}-period`} x={geometry.period} />}
    </g>
  </g>
</svg>

<style is:inline>
  .helix { display: block; width: 320px; max-width: 100%; height: 120px; }
  .logo-mark { width: 20px; height: 20px; }
  @media (prefers-reduced-motion: no-preference) {
    .helix-flow { animation: helix-turn 8s linear infinite; }
    @keyframes helix-turn { to { transform: translateX(var(--period)); } }
  }
</style>
