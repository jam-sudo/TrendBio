---
interface Props { staticMark?: boolean }
const { staticMark = false } = Astro.props;
const points = Array.from({ length: 21 }, (_, index) => ({
  y: 20 + index * 10,
  phase: index / 10,
}));
---

<svg class={staticMark ? "logo-mark" : "helix"} viewBox={staticMark ? "100 0 160 240" : "0 0 360 240"} aria-hidden="true" focusable="false">
  {[0, 1].map((strand) => (
    <g class={strand === 0 ? "helix-accent" : "helix-ink"}>
      {points.map(({ y, phase }) => (
        <circle
          cx="180" cy={y} r="4"
          style={`--offset: ${Math.cos((phase + strand) * Math.PI) * 64}px; --delay: ${-(phase + strand) * 4}s;`}
        />
      ))}
    </g>
  ))}
</svg>

<style is:inline>
  .helix { width: 100%; height: 100%; opacity: 0.10; }
  .logo-mark { width: 20px; height: 20px; }
  .logo-mark circle { transform: translateX(var(--offset)); }
  .helix-accent { fill: var(--accent); }
  .helix-ink { fill: var(--fg); }
  .helix circle { transform: translateX(var(--offset)); }
  @media (prefers-reduced-motion: no-preference) {
    .helix circle { animation: helix-turn 8s ease-in-out infinite; animation-delay: var(--delay); }
    @keyframes helix-turn {
      0%, 100% { transform: translateX(64px); }
      50% { transform: translateX(-64px); }
    }
  }
</style>
