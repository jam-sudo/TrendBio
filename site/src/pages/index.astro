---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PeriodLinks from "../components/PeriodLinks.astro";
import { dailyRows } from "../lib/leaderboard";
import DayTopics from "../components/DayTopics.astro";
import { latestDay } from "../lib/data";

const day = latestDay("computational");
---

<Base description={`Today's leading computational biology topic: ${day?.ranked.find(({ rank }) => rank === 1)?.headline ?? "No topic cleared the bar today"}.`} canonicalPath="/" heroAligned lastRun={day?.run.finished}>
  <Hero slot="hero"
    title="What moved in computational biology today"
    subtitle="bioRxiv, arXiv, PubMed, GitHub and industry."
    updated={day?.run.finished}
  />
  <PeriodLinks current="day" />
  <DayTopics day={day} topics={dailyRows(day)} />
</Base>
