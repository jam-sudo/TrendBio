---
import Base from "../layouts/Base.astro";
import { dailyRows } from "../lib/leaderboard";
import DayTopics from "../components/DayTopics.astro";
import { latestDay } from "../lib/data";

const day = latestDay("computational");
---

<Base description={`Today's leading computational biology topic: ${day?.ranked.find(({ rank }) => rank === 1)?.headline ?? "No topic cleared the bar today"}.`} canonicalPath="/" landing lastRun={day?.run.finished}>
  <DayTopics day={day} topics={dailyRows(day)} />
</Base>
