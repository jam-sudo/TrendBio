---
import Base from "../layouts/Base.astro";
import { editionInfo, fieldLabel, scienceGroups, type Field } from "../lib/editions";
---
<Base title="Science fields — TrendBio" description="Browse daily research rankings and dated pilot editions by scientific field." canonicalPath="/fields/">
  <article class="prose">
    <h1>Science fields</h1>
    <p>Choose a field to read its rankings and supporting papers. Pilot editions cover selected dates.</p>
    {Object.entries(scienceGroups).map(([group, fields]) => <section>
      <h2>{group}</h2>
      <dl>{(Object.keys(fields) as Field[]).filter(field => !fields[field]?.parent).map(field => <div>
        <dt><a href={field === "computational" ? "/" : `/${field}/`}>{fieldLabel(field)}</a>
          <small>{field === "computational" || !editionInfo[field].stage ? "Daily" : field === "biology" ? "Daily · Beta" : "Pilot"}</small></dt>
        <dd>{fields[field]?.scope}
          {Object.values(fields).some(child => child?.parent === field) && <ul aria-label={`${fieldLabel(field)} editions`}>
            {(Object.keys(fields) as Field[]).filter(child => fields[child]?.parent === field).map(child =>
              <li><a href={child === "computational" ? "/" : `/${child}/`}>{fieldLabel(child)}</a>
                <small>{child === "computational" ? "Daily" : "Pilot"}</small>
                <p>{fields[child]?.scope}</p></li>)}
          </ul>}
        </dd>
      </div>)}</dl>
    </section>)}
  </article>
</Base>
<style>
  dl > div { margin-block: .9rem; }
  dt { font-weight: 600; }
  small { margin-inline-start: .7em; color: var(--muted); font-weight: normal; }
  li { margin-block: .5rem; }
  li p { margin: .15rem 0; }
  dd { margin: .2em 0 0; }
</style>
