---
import CategoryIcon from "../../components/CategoryIcon.astro";
import { rankMedal } from "../../lib/categories";
import Base from "../../layouts/Base.astro";
import SignalBadges from "../../components/SignalBadges.astro";
import Sparkline from "../../components/Sparkline.astro";
import EditorNote from "../../components/EditorNote.astro";
import EvidenceList from "../../components/EvidenceList.astro";
import { latestDay, loadItems, loadNote, loadTaxonomy, loadTopic } from "../../lib/data";
import { topicPages } from "../../lib/period-data";
import type { Topic } from "../../lib/types";

export function getStaticPaths() {
  return topicPages().map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props { topic: Topic }
const { topic } = Astro.props;
const domain = "computational";
const history = [...topic.history].sort((a, b) => b.date.localeCompare(a.date));
const latestEntry = history[0];
const ranked = history.filter((entry) => entry.rank !== null);
const latestRanked = ranked[0];
const category = loadTaxonomy(domain).find(({ slug }) => slug === topic.category)?.label ?? topic.category;
const related = topic.related.map((slug) => loadTopic(domain, slug)).filter((entry): entry is Topic => entry !== null).slice(0, 3);
const headline = topic.headline ?? topic.label;
---

<Base description={headline} canonicalPath={`/topic/${topic.slug}/`} title={`${headline} — TrendBio`} lastRun={latestDay(domain)?.run.finished}>
  <article class="prose">
    {latestRanked && <nav aria-label="Breadcrumb"><a href={`/day/${latestRanked.date}/`}>← {latestRanked.date}</a></nav>}
    <p class="rank-category"><CategoryIcon slug={topic.category} size={36} /> <span>{latestRanked ? `#${latestRanked.rank}` : "Topic"} · {category}</span></p>
    <h1>{headline}</h1>
    {latestEntry && <SignalBadges signals={latestEntry.signals} />}
    <Sparkline history={topic.history} />
    {topic.synthesis !== null && <p>{topic.synthesis}</p>}
    <EditorNote html={loadNote(topic.slug)} />
    <EvidenceList items={loadItems(domain, [...(latestEntry?.item_ids ?? []), ...(latestEntry?.attached_item_ids ?? [])])} oneLiners={topic.item_one_liners} />
    {related.length > 0 && <section id="related-topics" aria-labelledby="related-heading">
      <h2 id="related-heading">Related topics</h2>
      <ul>{related.map((entry) => <li>{entry.history.some((day) => day.rank !== null)
        ? <a href={`/topic/${entry.slug}/`}>{entry.label}</a> : entry.label}</li>)}</ul>
    </section>}
    <section id="topic-history" aria-labelledby="history-heading">
      <h2 id="history-heading">Topic history</h2>
      <table>
        <thead><tr><th scope="col">Date</th><th scope="col">Rank</th></tr></thead>
        <tbody>{ranked.map((entry) => <tr><td><a href={`/day/${entry.date}/`} aria-label={`${entry.date} · #${entry.rank}`}><time datetime={entry.date}>{entry.date}</time></a></td><td><span aria-hidden="true">{rankMedal(entry.rank!)}</span><span class="sr-only">#{entry.rank}</span></td></tr>)}</tbody>
      </table>
    </section>
  </article>
</Base>

<style>
  article { overflow-wrap: anywhere; }
  nav { margin-bottom: 1.5rem; font-size: var(--t3); }
  .rank-category { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; color: var(--muted); font-size: var(--t3); }
  h1 { margin-top: 0; }
  section { margin-top: 2.5rem; }
</style>
