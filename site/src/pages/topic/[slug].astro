---
import { readingParagraphs } from "../../lib/reading-paragraphs";
import TopicIntro from "../../components/TopicIntro.astro";
import { rankMedal } from "../../lib/categories";
import Base from "../../layouts/Base.astro";
import EditorNote from "../../components/EditorNote.astro";
import EvidenceList from "../../components/EvidenceList.astro";
import CrossCoverage from "../../components/CrossCoverage.astro";
import { crossCoverage } from "../../lib/shared-papers";
import { latestDay, loadDay, loadNote, loadTaxonomy, loadTopic } from "../../lib/data";
import { hasPapers, topicEvidence } from "../../lib/citations";
import { topicPages } from "../../lib/period-data";
import type { Topic } from "../../lib/types";
import { datedEvidence, topicAppearances } from "../../lib/editions";

export function getStaticPaths() {
  return topicPages().map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

interface Props { topic: Topic }
const { topic } = Astro.props;
const domain = "computational";
const history = [...topic.history].sort((a, b) => b.date.localeCompare(a.date));
const latestEntry = history[0];
const ranked = history.filter((entry) => entry.rank !== null);
const latestRanked = ranked[0];
const category = loadTaxonomy(domain).find(({ slug }) => slug === topic.category)?.label ?? topic.category;
const related = topic.related.map((slug) => loadTopic(domain, slug)).filter((entry): entry is Topic => entry !== null).slice(0, 3);
const headline = topic.headline ?? topic.label;
const publishedDates = new Set(topicAppearances(domain).get(topic.slug)?.map(({ day }) => day.date));
function historyLink(date: string) {
  if (publishedDates.has(date)) return datedEvidence(domain, date, topic.slug);
  return loadDay(domain, date) ? `/day/${date}/` : undefined;
}
const evidence = topicEvidence(topic);
const previousRanked = ranked.find((entry) => entry.date < latestEntry.date);
---

<Base description={headline} canonicalPath={`/topic/${topic.slug}/`} title={`${headline} — TrendBio`} lastRun={latestDay(domain)?.run.finished}>
  <article class="prose" data-pagefind-body data-pagefind-filter={`category:${category}`}>
    <TopicIntro field={domain} category={topic.category} categoryLabel={category} rank={latestRanked?.rank} title={headline} summary={topic.summary}
      history={topic.history} signals={latestEntry?.signals} signalDate={latestEntry?.date} date={latestRanked?.date}
      backUrl={latestRanked && loadDay(domain, latestRanked.date) ? `/day/${latestRanked.date}/` : undefined} />
    {topic.synthesis !== null && readingParagraphs(topic.synthesis).map(paragraph => <p>{paragraph}</p>)}
    <EditorNote html={loadNote(topic.slug)} />
    {hasPapers(evidence) && <p data-pagefind-ignore><a href={`/topic/${topic.slug}/citations.bib`} download>Export citations (BibTeX)</a></p>}
    <EvidenceList items={evidence} oneLiners={topic.item_one_liners} previousRanked={previousRanked} />
    {latestRanked && <CrossCoverage date={latestRanked.date} matches={crossCoverage(domain, latestRanked.date, topic.slug)} />}
    {related.length > 0 && <section id="related-topics" aria-labelledby="related-heading" data-pagefind-ignore>
      <h2 id="related-heading">Related topics</h2>
      <ul>{related.map((entry) => <li>{entry.history.some((day) => day.rank !== null)
        ? <a href={`/topic/${entry.slug}/`}>{entry.label}</a> : entry.label}</li>)}</ul>
    </section>}
    <section id="topic-history" aria-labelledby="history-heading" data-pagefind-ignore>
      <h2 id="history-heading">Topic history</h2>
      {ranked.length > 0 ? <table>
        <thead><tr><th scope="col">Date</th><th scope="col">Rank</th></tr></thead>
        <tbody>{ranked.map(entry => {
          const href = historyLink(entry.date);
          return <tr><td>{href ? <a {href} aria-label={`${entry.date} · #${entry.rank}`}><time datetime={entry.date}>{entry.date}</time></a>
            : <time datetime={entry.date}>{entry.date}</time>}</td><td><span aria-hidden="true">{rankMedal(entry.rank!)}</span><span class="sr-only">#{entry.rank}</span></td></tr>;
        })}</tbody>
      </table> : <p>No ranked appearances have been recorded for this topic.</p>}
    </section>
  </article>
</Base>

<style>
  article { overflow-wrap: anywhere; }
  section { margin-top: 2.5rem; }
</style>
