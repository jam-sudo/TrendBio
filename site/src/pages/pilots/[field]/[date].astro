---
import EditionRanking from "../../../components/EditionRanking.astro";
import { editions, type Edition } from "../../../lib/editions";
import { pilotIssues } from "../../../lib/pilot-topics";
export function getStaticPaths() {
  return editions.flatMap(field => pilotIssues(field).map(date => ({ params: { field, date } })));
}
const field = Astro.params.field as Edition, date = Astro.params.date!;
---
<EditionRanking {field} pilotDate={date} path={`/pilots/${field}/${date}/`} />
