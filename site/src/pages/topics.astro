---
import { categoryStyle } from "../lib/categories";
import Base from "../layouts/Base.astro";
import CategoryChips from "../components/CategoryChips.astro";
import { rankedTopics, latestDay, loadTaxonomy, orphanNotes } from "../lib/data";

const domain = "computational";
const categories = loadTaxonomy(domain);
const topics = rankedTopics(domain).map((topic) => ({
  topic,
  lastRanked: topic.history.filter((entry) => entry.rank !== null).map((entry) => entry.date).sort().at(-1) ?? "",
}));
const counts = Object.fromEntries(categories.map(({ slug }) => [
  slug, topics.filter(({ topic }) => [topic.category, ...topic.secondary_categories].includes(slug)).length,
]));
for (const slug of orphanNotes(domain)) console.warn(`orphan note: ${slug}`);
---

<Base title="Topics — TrendBio" lastRun={latestDay(domain)?.run.finished}>
  <h1>Topics</h1>
  <CategoryChips categories={categories} counts={counts} />
  <table class="topics">
    <thead><tr><th scope="col">Topic</th><th scope="col">Category</th><th scope="col">Last ranked</th></tr></thead>
    <tbody>{topics.map(({ topic, lastRanked }) => <tr data-topic-cats={[topic.category, ...topic.secondary_categories].join(" ")}>
      <td><a class="topic-name" href={`/topic/${topic.slug}/`}>
        <span class="category-tile" style={`--category-hue: ${categoryStyle(topic.category).hue}`} aria-hidden="true">{categoryStyle(topic.category).emoji}</span>
        <span><strong>{topic.headline ?? topic.label}</strong>{topic.headline && <span class="topic-label">{topic.label}</span>}</span>
      </a></td>
      <td class="category">{categories.find(({ slug }) => slug === topic.category)?.label ?? topic.category}</td>
      <td class="date">{lastRanked && <time datetime={lastRanked}>{lastRanked}</time>}</td>
    </tr>)}</tbody>
  </table>
</Base>
<style>
  .topic-name { display: flex; align-items: center; gap: 1rem; text-decoration: none; }
  .topic-name:hover strong { text-decoration: underline; }
  .topic-label { display: block; color: var(--muted); font-size: var(--t3); }
  .category, .date { color: var(--muted); font-size: var(--t3); }
  .date { white-space: nowrap; }
  @media (max-width: 640px) {
    .topics, tbody { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding-block: 1rem; border-bottom: 1px solid var(--border); }
    td { padding: 0; border: 0; }
    td:first-child { grid-column: 1 / -1; padding-bottom: 0.5rem; }
    .category { padding-left: 52px; padding-right: 0.5rem; }
  }
</style>
