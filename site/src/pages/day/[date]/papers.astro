---
import Base from "../../../layouts/Base.astro";
import FieldEvidence from "../../../components/FieldEvidence.astro";
import { loadPeriods } from "../../../lib/period-data";
import { periodHeadline } from "../../../lib/periods";
import { tiedScore } from "../../../lib/leaderboard";
import { datedTopic } from "../../../lib/editions";
import type { Day } from "../../../lib/types";

export function getStaticPaths() {
  return loadPeriods().paperDays.map(day => ({ params: { date: day.date }, props: { day } }));
}
interface Props { day: Day }
const { day } = Astro.props;
const path = `/day/${day.date}/`;
const rows = [
  ...day.ranked.map(row => ({ ...row, tie: tiedScore(day, row) })),
  ...Array.from(loadPeriods().supplemental.get(day.date)?.values() ?? [])
    .filter(topic => !day.ranked.some(row => row.slug === topic.slug))
    .map(topic => ({ slug: topic.slug, headline: periodHeadline(topic), summary: "", rank: null, tie: undefined })),
];
---
<Base title={`CompBio papers · ${day.date} — TrendBio`} canonicalPath={`${path}papers/`}
  description={`Supporting papers and topic summaries from the ${day.date} computational biology rankings.`} lastRun={day.run.finished}>
  <article class="prose">
    <h1>CompBio papers · <time datetime={day.date}>{day.date}</time></h1>
    <p><a href={path}>View this day’s rankings</a></p>
    {rows.map(row => <section id={row.slug} tabindex="-1">
      <p class="context">CompBio · <time datetime={day.date}>{day.date}</time> · {row.rank ? `Rank ${row.rank}` : "Period ranking · Auto label"}{row.tie && ` · ${row.tie}`}</p>
      <h2>{row.headline}</h2>
      {row.summary && <p>{row.summary}</p>}
      <FieldEvidence field="computational" {day} {row} expanded />
      <p class="links">
        {row.rank ? <a href={datedTopic("computational", day.date, row.slug)}>Rank in this edition</a> : <a href={path}>Daily rankings</a>}
        <a href={`/topic/${row.slug}/`}>Latest topic</a>
      </p>
    </section>)}
  </article>
</Base>
<style>
  section { border-top: 1px solid var(--border); padding-block: 1.5rem; overflow-wrap: anywhere; }
  section:focus-visible { outline-offset: 3px; }
  .context { color: var(--muted); margin-bottom: .25rem; }
  h2 { margin-top: 0; }
  .links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: 1rem; }
</style>
