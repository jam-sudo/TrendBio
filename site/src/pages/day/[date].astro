---
import Base from "../../layouts/Base.astro";
import PeriodLinks from "../../components/PeriodLinks.astro";
import { dailyRows } from "../../lib/leaderboard";
import DayTopics from "../../components/DayTopics.astro";
import { loadDays } from "../../lib/data";
import type { Day } from "../../lib/types";

export function getStaticPaths() {
  return loadDays("computational").map((day) => ({ params: { date: day.date }, props: { day } }));
}

interface Props {
  day: Day;
}

const { day } = Astro.props;
---

<Base title={`${day.date} — TrendBio`} lastRun={day.run.finished}>
  <h1 class="day-title"><time datetime={day.date}>{day.date}</time></h1>
  <PeriodLinks current="day" />
  <DayTopics day={day} topics={dailyRows(day)} />
</Base>
