---
import Base from "../layouts/Base.astro";
import { loadDays, loadTaxonomy } from "../lib/data";
import CategoryIcon from "../components/CategoryIcon.astro";
const categories = loadTaxonomy("computational");
const days = loadDays("computational");
---
<Base title="Archive — TrendBio" lastRun={days[0]?.run.finished}>
  <h1>Archive</h1>
  <table class="archive">
    <thead><tr><th scope="col">Date</th><th scope="col">Top 5 topics</th></tr></thead>
    <tbody>{days.map((day) => <tr>
      <th scope="row"><a href={`/day/${day.date}/`}><time datetime={day.date}>{day.date}</time></a></th>
      <td><ol>{day.ranked.map((topic) => <li><a href={`/topic/${topic.slug}/`}><CategoryIcon slug={topic.category} size={16} /><span class="sr-only">{categories.find(({ slug }) => slug === topic.category)?.label ?? topic.category}: </span> {topic.headline}</a></li>)}</ol>
        {day.ranked.length === 0 && <span class="quiet">Quiet day: no topic cleared the bar.</span>}
      </td>
    </tr>)}</tbody>
  </table>
</Base>
<style>
  th[scope="row"] { white-space: nowrap; width: 150px; }
  ol { padding: 0; margin: 0; list-style: none; }
  li + li { margin-top: 0.75rem; }
  li a { text-decoration: none; }
  li a:hover { text-decoration: underline; }
  .quiet { color: var(--muted); font-size: var(--t3); }
  @media (max-width: 640px) { th[scope="row"] { width: auto; } td { padding-left: 0.75rem; } }
</style>
