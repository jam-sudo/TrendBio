---
import Base from "../layouts/Base.astro";
import { loadTaxonomy } from "../lib/data";
import { fieldLabel, editions, pilotDates, type Field } from "../lib/editions";
import { pilotRows } from "../lib/pilot-topics";
const fields: Field[] = ["computational", ...editions];
const categories = new Map<string, Field[]>();
for (const field of fields) {
  const labels = new Set(loadTaxonomy(field).map(c => c.label));
  if (field !== "computational") for (const date of pilotDates(field)) {
    for (const row of pilotRows(field, date)) labels.add(row.category);
  }
  for (const label of labels) {
    categories.set(label, [...(categories.get(label) ?? []), field]);
  }
}
---

<Base title="Search — TrendBio" description="Search research topics, paper titles and tools across TrendBio editions." canonicalPath="/search/" noindex>
  <section class="prose" aria-labelledby="search-heading">
    <h1 id="search-heading">Search topics</h1>
    <p id="search-help">Search topic headlines, summaries, syntheses, paper titles and tool names.</p>
    <noscript><p>Search needs JavaScript. Enable it to search topics.</p></noscript>
    <form role="search" hidden>
      <label for="search-query">Search topics</label>
      <input id="search-query" name="q" type="search" aria-describedby="search-help" />
      <label for="search-field">Field</label>
      <select id="search-field">
        <option value="">All fields</option>
        <option value="energy">Energy Storage &amp; Power Grids collection</option>
        <option value="materials">Materials Science collection</option>
        {fields.map(field => <option value={field}>{fieldLabel(field)}</option>)}
      </select>
      <label for="search-category">Category</label>
      <select id="search-category">
        <option value="">All categories</option>
        <option data-fields="energy">Energy Storage &amp; Power Grids</option>
        <option data-fields="materials">Materials Science</option>
        {Array.from(categories, ([label, fields]) => <option value={label} data-fields={fields.join(" ")}>{label}</option>)}
      </select>
      <button type="submit">Search</button>
    </form>
    <p id="search-status" role="status" aria-live="polite" tabindex="-1"></p>
    <a id="search-all-fields" hidden>Search all fields</a>
    <ul id="search-results" aria-label="Search results"></ul>
    <button id="search-more" type="button" hidden>Show more results</button>
    <template id="search-result">
      <li><h2><a></a></h2><p class="result-meta"><span class="result-field"></span><span class="category"></span></p><p class="excerpt"></p></li>
    </template>
  </section>
</Base>

<script>
  import { loadSearch } from '../lib/load-search.js';

  const form = document.querySelector('form[role="search"]');
  const input = document.getElementById('search-query');
  const field = document.getElementById('search-field');
  const category = document.getElementById('search-category');
  const status = document.getElementById('search-status');
  const allFields = document.getElementById('search-all-fields');
  const list = document.getElementById('search-results');
  const more = document.getElementById('search-more');
  const template = document.getElementById('search-result');
  let pages, request = 0, timer;

  async function showResults(current) {
    if (!pages || more.disabled || current !== request) return;
    const moveFocus = document.activeElement === more;
    more.disabled = true;
    let batch;
    try {
      batch = await pages.next(() => current === request);
    } catch {
      if (current === request) {
        status.textContent = 'Results could not load. Try loading this page of results again.';
        more.textContent = 'Retry loading results';
        more.hidden = false;
      }
      return;
    } finally {
      if (current === request) more.disabled = false;
    }
    if (!batch || current !== request) return;
    let firstLink;
    for (const result of batch.page) {
      const row = template.content.cloneNode(true);
      const link = row.querySelector('a');
      link.href = result.url;
      link.textContent = result.meta.title;
      firstLink ??= link;
      row.querySelector('.result-field').textContent = result.meta.field ? result.meta.field + ' · ' : '';
      row.querySelector('.category').textContent = result.filters.category.join(', ');
      // Pagefind escapes indexed text before adding its <mark> highlights.
      row.querySelector('.excerpt').innerHTML = result.excerpt;
      list.append(row);
    }
    more.hidden = !batch.more;
    more.textContent = 'Show more results';
    status.textContent = batch.count
      ? `${batch.count} ${batch.count === 1 ? 'result' : 'results'} found${batch.complete ? '' : ' so far'}. Showing ${batch.shown}.`
      : 'No results found. Try another term or category.';
    if (moveFocus && (document.activeElement === more || document.activeElement === document.body)) (firstLink ?? status).focus();
  }

  async function search() {
    clearTimeout(timer);
    const current = ++request;
    const query = input.value.trim();
    const url = new URL(location.href);
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');
    for (const [key, select] of [['field', field], ['category', category]]) {
      if (select.value) url.searchParams.set(key, select.value);
      else url.searchParams.delete(key);
    }
    history.replaceState(null, '', url);
    allFields.hidden = !field.value;
    const allUrl = new URL(url);
    allUrl.searchParams.delete('field');
    allUrl.searchParams.delete('category');
    allFields.href = allUrl.href;
    list.replaceChildren();
    more.hidden = true;
    more.disabled = false;
    more.textContent = 'Show more results';
    pages = null;
    if (!query) {
      status.textContent = 'Enter a term to search topic headlines, summaries, syntheses, paper titles and tool names.';
      return;
    }
    status.textContent = 'Searching…';
    try {
      const [pagefind, match] = await loadSearch();
      const filters = { ...(field.value && { field: field.value }), ...(category.value && { category: category.value }) };
      const search = await pagefind.search(query, { filters });
      if (current !== request) return;
      pages = match.matchingPages(query, search.results);
      await showResults(current);
    } catch {
      if (current === request) status.textContent = 'Search could not load. Please try again.';
    }
  }

  form.hidden = false;
  function updateCategories() {
    for (const option of category.options) {
      const unavailable = !!(field.value && option.value && !option.dataset.fields.split(' ').includes(field.value));
      option.hidden = option.disabled = unavailable;
      if (unavailable && option.selected) category.value = '';
    }
  }
  const params = new URLSearchParams(location.search);
  input.value = (params.get('q') ?? '').trim();
  for (const [name, select] of [['field', field], ['category', category]]) {
    select.value = params.get(name) ?? '';
    if (select.selectedIndex < 0) select.selectedIndex = 0;
  }
  updateCategories();
  if (!input.value && params.has('q')) input.focus();
  form.addEventListener('submit', event => { event.preventDefault(); search(); });
  input.addEventListener('input', () => {
    ++request;
    pages = null;
    more.hidden = true;
    clearTimeout(timer);
    timer = setTimeout(search, 150);
  });
  category.addEventListener('change', search);
  field.addEventListener('change', () => { updateCategories(); search(); });
  more.addEventListener('click', () => showResults(request));
  search();
</script>

<style>
  form { display: grid; gap: 0.5rem; margin-bottom: 1.5rem; }
  input, select, button { min-width: 0; max-width: 100%; padding: 0.65rem; border: 1px solid var(--muted); border-radius: var(--radius-sm); font: inherit; background: var(--card); color: var(--fg); }
  button { justify-self: start; cursor: pointer; }
  ul { list-style: none; padding: 0; }
  li { padding-block: 1.25rem; border-top: 1px solid var(--border); overflow-wrap: anywhere; }
  h2 { margin: 0 0 0.25rem; }
  .result-meta { color: var(--muted); font-size: var(--t3); margin-bottom: 0.5rem; }
  .excerpt { margin: 0; }
  .excerpt :global(mark) { background: var(--raised); color: var(--fg); font-weight: 700; }
</style>
