---
import EditionRanking from "../../components/EditionRanking.astro";
import FieldReading from "../../components/FieldReading.astro";
import TopicsPage from "../../components/TopicsPage.astro";
import MapPage from "../../components/MapPage.astro";
import ArchivePage from "../../components/ArchivePage.astro";
import PeriodPage from "../../components/PeriodPage.astro";
import PeriodIndex from "../../components/PeriodIndex.astro";
import { editions, type Edition } from "../../lib/editions";
import { fieldPages } from "../../lib/field-pages";
import { pilotIssues } from "../../lib/pilot-topics";

export function getStaticPaths() {
  return editions.flatMap(field => fieldPages(field).map(page => ({
    params: { field, edition: page.path || undefined }, props: { page },
  })));
}
interface Props { page: ReturnType<typeof fieldPages>[number] }
const { page } = Astro.props;
const field = Astro.params.field as Edition;
const path = page.path ? `/${field}/${page.path}/` : `/${field}/`;
const pilotDate = page.view === "landing" && page.date && pilotIssues(field).includes(page.date) ? page.date : undefined;
---
{(page.view === "landing" || page.view === "day") &&
  <EditionRanking {field} day={!pilotDate && page.day?.date === page.date ? page.day : undefined} {pilotDate} {path} landing={page.view === "landing"} />}
{page.view === "papers" && <FieldReading {field} day={page.day!} />}
{page.view === "topics" && <TopicsPage {field} />}
{page.view === "map" && <MapPage {field} />}
{page.view === "archive" && <ArchivePage {field} />}
{(page.view === "week" || page.view === "month") && (page.period
  ? <PeriodPage {field} kind={page.view} period={page.period} /> : <PeriodIndex {field} kind={page.view} />)}
