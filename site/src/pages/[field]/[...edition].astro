---
import Base from "../../layouts/Base.astro";
import PublicationEvidence from "../../components/PublicationEvidence.astro";
import { loadCorrection, loadDays, loadEditionVenues, loadItems, loadTaxonomy, loadTopic, NOTES_ROOT } from "../../lib/data";
import type { Day } from "../../lib/types";
import { existsSync, readdirSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse } from "yaml";
import { editionInfo, editions, type Edition } from "../../lib/editions";

export function getStaticPaths() {
  return editions.flatMap(field => {
    const days = loadDays(field);
    return [
      { params: { field, edition: undefined }, props: { day: days[0] ?? null } },
      ...days.map(day => ({ params: { field, edition: `day/${day.date}` }, props: { day } })),
    ];
  });
}

interface Props { day: Day | null }
const { day } = Astro.props;
const field = Astro.params.field as Edition;
const biology = field === "biology";
const humanities = field === "humanities-arts";
const { label, stage } = editionInfo[field];
const days = loadDays(field);
const categories = new Map(loadTaxonomy(field).map(category => [category.slug, category.label]));
const source = parse(readFileSync(resolve("../config/sources", `${field}.yaml`), "utf8"));
const archives: string[] = source.arxiv?.categories ?? [];
const archiveGroups = Map.groupBy(archives, code => categories.get(source.hints.arxiv_category[code][0]) ?? code);
const earth = field === "earth-environment";
const editionVenues = earth && day ? loadEditionVenues(field, day.date) : null;
const journals: string[] = editionVenues ?? source.crossref?.journal_titles ?? Object.keys(source.hints?.journal ?? {});
const followsCrossref = source.crossref && (!day || (day.run.source_status.crossref && day.run.source_status.crossref !== "skipped"));
const medicalJournals: { title: string }[] = source.europepmc?.journals ?? [];
const conferences: string[] = source.drops?.conferences ?? [];
const publishers: { title: string; endpoint: string }[] = source.oai?.journals ?? [];
const collections: { title: string; set: string }[] = source.openedition?.venues ?? [];
const languageNames = new Intl.DisplayNames(["en"], { type: "language" });
const path = Astro.params.edition ? `/${field}/${Astro.params.edition}/` : `/${field}/`;
const correctionDir = day && resolve(NOTES_ROOT, field, day.date);
const corrections = new Set(correctionDir && existsSync(correctionDir) ? readdirSync(correctionDir) : []);
const rows = (day?.ranked ?? []).map(row => {
  const topic = loadTopic(field, row.slug);
  const entry = topic?.history.find(entry => entry.date === day?.date);
  const papers = loadItems(field, entry?.item_ids ?? []);
  const singleSource = day?.run.notes.includes(`synthesis-fallback:${row.slug}`);
  const synthesis = singleSource ? null
    : row.synthesis ?? (topic?.synthesized_on === day?.date ? topic?.synthesis : null);
  const correction = corrections.has(`${row.slug}.md`)
    ? loadCorrection(`${field}/${day!.date}/${row.slug}`, [row.headline, row.summary, synthesis ?? ""], entry?.item_ids ?? [])
    : null;
  return { row, papers, synthesis, correction, singleSource };
});
---

<Base edition={field} editionSources={field === "physics-expanded" && !followsCrossref ? "arXiv" : undefined}
  title={day ? `${label} · ${day.date} — TrendBio` : `${label} — TrendBio`}
  description={humanities ? "Humanities and arts research from journals and scholarly books." : `Daily ${label.toLowerCase()} research trends with the papers behind each ranking.`}
  canonicalPath={path} lastRun={day?.run.finished}>
  <div class="prose">
    <h1>{label}{stage && <small> {stage}</small>}</h1>
    {biology && <p class="coverage">Experimental, observational and computational biology from selected bioRxiv subjects and PubMed journals.</p>}
    {archives.length > 0 && <p class="coverage">Following {Array.from(archiveGroups, ([category, codes], i) => <>{i > 0 && " · "}
      {codes.length === 1 ? <a href={`https://arxiv.org/list/${codes[0]}/recent`}>{category}</a> : <>
        <span>{category}</span> ({codes.map((code, index) => <>{index > 0 && ", "}<a href={`https://arxiv.org/list/${code}/recent`} translate="no">{code}</a></>)})
      </>}</>)} on arXiv.</p>}
    {followsCrossref && journals.length > 0 && <p class="coverage">{earth
      ? (editionVenues ? "Journals represented in this edition’s collection include" : "The current pilot follows")
      : "Research articles from"} <span translate="no">{journals.join(", ")}</span>.</p>}
    {medicalJournals.length > 0 && <p class="coverage">Research articles indexed in Europe PMC from <span translate="no">{medicalJournals.map(j => j.title).join(", ")}</span>.</p>}
    {source.worldbank && <p class="coverage">Working papers from the <a href={`https://openknowledge.worldbank.org/collections/${source.worldbank.collection}`}>World Bank Policy Research Working Papers series</a>.</p>}
    {conferences.length > 0 && <p class="coverage">Regular conference papers from {conferences.map((name, i) => <>{i > 0 && " · "}<a href={`https://drops.dagstuhl.de/entities/conference/${name}`} translate="no">{name}</a></>)} (DROPS).</p>}
    {publishers.length > 0 && <p class="coverage">Publisher records from {publishers.map((journal, i) => <>{i > 0 && " · "}<a href={new URL(".", journal.endpoint).href} translate="no">{journal.title}</a></>)}.</p>}
    {source.thoth && <p class="coverage">Monographs and edited books from <a href="https://thoth.pub/books" translate="no">Thoth</a>.</p>}
    {collections.length > 0 && <p class="coverage">OpenEdition journals and presses in this pilot {collections.map(({ set, title }, i) => {
      const [platform, name] = set.split(":");
      return <>{i > 0 && " · "}<a href={`https://${platform}.openedition.org/${name}/`} translate="no">{title}</a></>;
    })}.</p>}
    {day ? <>
      <h2>Research trends · <time datetime={day.date}>{day.date}</time></h2>
      {day.run.status === "degraded" && <p>Some sources or summaries were unavailable for this edition.</p>}
      {rows.length === 0 && <p>No topic cleared the ranking threshold for this date.</p>}
      <ol class="rankings">
        {rows.map(({ row, synthesis, papers, correction, singleSource }) => <li value={row.rank} id={row.slug}>
          <p class="category">{categories.get(row.category) ?? row.category}</p>
          <h3>{row.headline}</h3>
          <p>{row.summary}</p>
          {singleSource && <p><small>This headline and summary describe one supporting work.</small></p>}
          {correction && <aside class="correction" role="note"><strong>Editorial correction</strong><div set:html={correction} /></aside>}
          {papers.length > 0 && <details>
            <summary>{papers.length} supporting {humanities ? (papers.length === 1 ? "work" : "works") : (papers.length === 1 ? "paper" : "papers")}</summary>
            {synthesis && <p>{synthesis}</p>}
            <ul>{papers.map(paper => <li>{humanities ? <PublicationEvidence paper={paper} /> : <a href={paper.url}>{paper.title}</a>}{["crossref", "drops", "oai", "europepmc", "worldbank"].includes(paper.source) && typeof paper.metadata.license === "string" && <> · <span translate="no">{paper.authors.join(", ")}</span> · <a href={paper.metadata.license}>{paper.metadata.license.includes("/publicdomain/zero/") ? "CC0" : "CC BY"}</a></>}
              {paper.source === "worldbank" && <> · <span>Working paper</span></>}
              {paper.source === "europepmc" && paper.doi && <> · <a href={`https://doi.org/${paper.doi}`}>Publisher article</a></>}
              {paper.source === "europepmc" && typeof paper.metadata.screening_status === "string" && <> · <strong>Currently excluded from new editions</strong></>}
              {paper.source === "europepmc" && Array.isArray(paper.metadata.correction_links) && paper.metadata.correction_links.filter(link => typeof link === "string" && /^https:\/\/(?:pubmed\.ncbi\.nlm\.nih\.gov|pmc\.ncbi\.nlm\.nih\.gov|doi\.org)\//.test(link)).map(link => <> · <a href={link}>Linked correction</a></>)}
              {["oai", "europepmc"].includes(paper.source) && typeof paper.metadata.language === "string" && /^[a-z]{2,3}$/.test(paper.metadata.language) && <> · <span>{`Original publication in ${languageNames.of(paper.metadata.language)}`}</span></>}
              {Array.isArray(paper.metadata.preprint_dois) && paper.metadata.preprint_dois.filter(doi => typeof doi === "string" && /^10\.\d{4,9}\/\S+$/i.test(doi)).map(doi => <> · <a href={`https://doi.org/${doi}`}>Preprint version</a></>)}
              {Array.isArray(paper.metadata.dataset_dois) && paper.metadata.dataset_dois.length > 0 && <ul>{paper.metadata.dataset_dois.map(doi => <li><a href={`https://doi.org/${doi}`}>Dataset {doi}</a></li>)}</ul>}
            </li>)}</ul>
          </details>}
        </li>)}
      </ol>
      {Astro.params.edition ? <p class="archive"><a href={`/${field}/#editions`}>Browse {field} editions</a></p> : <details class="archive" id="editions"><summary>{label} editions by date</summary>
        <ul>{days.map(({ date }) => <li><a href={`/${field}/day/${date}/`}>{date}</a></li>)}</ul>
      </details>}
    </> : <p>The first {field} ranking will appear after the first collection run.</p>}
  </div>
</Base>

<style>
  .coverage, .category { color: var(--muted); }
  .rankings { padding-inline-start: 2.5rem; }
  .rankings > li { border-top: 1px solid var(--border); padding: 1rem 0 1rem .5rem; }
  .rankings > li::marker { font-weight: 700; }
  .category { margin: 0; font-size: var(--t3); }
  h3 { margin: .25rem 0; font-size: 1.15rem; }
  .rankings p { margin-bottom: .5rem; }
  .correction { border-inline-start: 3px solid currentColor; padding-inline-start: .75rem; margin: 1rem 0; }
  details p { margin-top: .75rem; }
  summary { cursor: pointer; }
  .archive { margin-block-start: 2rem; }
</style>
