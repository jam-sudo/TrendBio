  "item_one_liners": {},
  "label": "Biomolecular Complex Structure Prediction",
  "related": [
    "sequences-promoter-38cf",
    "protein-drug-1198",
    "models-brain-b963"
  ],
  "secondary_categories": [],
  "slug": "cryo-structure-34d6",
  "summary": "Preprints and a benchmark now test AlphaFold 3 and Boltz-2 on antibody, nanobody and protein-ligand complexes, exposing confidence limits.",
  "synthesis": "The dominant thread is evaluation and guidance of deep-learning structure predictors for biomolecular complexes, mainly antibody-antigen and protein-ligand systems. A benchmark reports that AlphaFold 3 leads on viral nanobody-antigen complexes and that ipTM and CDR3 pLDDT cutoffs help filter predictions, while a protein-ligand co-folding study finds confidence scores barely outperform random selection and proposes the CORE Score, based on agreement among predictions. Methods that supply external information are new: PIPER rigid-body docking templates lift antibody-antigen success from 56.2% to 63.4% for AlphaFold 3 and Boltz-2 on a leakage-free set, and APEs retrieves public evidence to predict ranked epitope residues. A Perspective shows explicit potassium ions shift AF3 predictions, and GSP offers a multi-scale metric for 3D RNA and RNP predictions. Together they point to confidence estimation and external guidance as the open problems.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-28"
}
