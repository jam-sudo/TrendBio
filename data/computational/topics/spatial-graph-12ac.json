  "item_one_liners": {},
  "label": "Deep Learning Histopathology Image Analysis",
  "related": [
    "protein-prediction-3337",
    "learning-omics-c285",
    "untitled-topic-53a8"
  ],
  "secondary_categories": [],
  "slug": "spatial-graph-12ac",
  "summary": "Recent work extends deep models from histology and microscopy to synthetic training data, staged segmentation, and molecular readouts inferred from morphology.",
  "synthesis": "The dominant thread is deep learning applied to histology and microscopy images to extract quantitative readouts from stained tissue. A multi-stage ViT-B/16 framework segments muscularis, myenteric plexus, and ganglion cells in colon whole-slide images for Hirschsprung disease diagnosis, evaluated on 30 slides with 5-fold cross-validation. Diffusion-generated brightfield images improve YOLO and RT-DETR single-cell detection, and experts could not tell them from real images. Pathology foundation models are benchmarked for tertiary lymphoid structure detection in H&E images of PDAC and HNSCC, while MISO predicts spatial transcriptomics from H&E tumor histology across 72 Visium and 348 MOSAIC samples. ReMAC extends ReMasker to spitzoid tumor classification from DNA methylation data, a non-image modality, under complete and incomplete data. What is new is attention to how supervision is supplied: synthetic images, decomposed staged models, and molecular readouts inferred from routine morphology.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-30"
}
