  "item_one_liners": {},
  "label": "Single Cell Computational Inference",
  "related": [
    "sequencing-genome-dba8",
    "spatial-hi-18ec",
    "local-ancestry-105b"
  ],
  "secondary_categories": [],
  "slug": "untitled-topic-1773",
  "summary": "Explicit objective formulations now drive cell identity, marker, and composition inference from single-cell, spatial, and bulk data.",
  "synthesis": "The dominant thread is explicit formulation of inference as an optimization problem over single-cell, spatial and bulk accessibility data. WAD deconvolves cell-type proportions from bulk ATAC-seq via wavelet-based L1-minimal linear programming, while SepSolve selects small marker sets through a linear program that enforces c-separation of cell types. geneCover offers a label-free route to minimally redundant marker panels from gene-gene correlations, and SIID uses joint nonnegative factorization to impute and deconvolve genes across paired Xenium and Visium platforms. ALPINE applies supervised nonnegative matrix factorization to separate technical from phenotypic factors in multicondition data. The subspace clustering method models each cell type as an affine subspace of linear constraints on scRNA-seq profiles. What is new is the constraint or objective itself, such as L1 reconstruction loss, c-separation or affine subspace membership, used as the basis of identity and composition inference.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-12-05"
}
