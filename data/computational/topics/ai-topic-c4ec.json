  "item_one_liners": {},
  "label": "Omics Predictive Model Benchmarking",
  "related": [
    "open-electrophysiological-e8a5",
    "annular-mean-passage-f2b7",
    "size-detection-antimicrobial-da52"
  ],
  "secondary_categories": [],
  "slug": "ai-topic-c4ec",
  "summary": "Perturbation predictors, gene selection, clustering and benchmarks of network and disease-relation methods appeared together, stressing evaluation of omics model inputs.",
  "synthesis": "The common thread is predictive modeling on omics data, with attention to which inputs and design choices drive performance. Several preprints target unseen-perturbation response prediction: S1Pert uses a frozen encoder with Welch/equivalence testing labels, OCCAM combines denoised representations with interaction, text and protein features, and GFM couples knowledge graphs with latent flow matching. CellSieve selects small gene sets for cell-type classification, and the Geneformer-based clustering and scAdaG2M address cell population identification. Evaluation-focused work includes SigMatch, showing sample tissue strongly biases transcriptomic disease-relationship predictions, a benchmark of precision matrix estimators for differential co-expression networks, and BI-SCUDO Regression, reported to outperform LASSO, RF and XGBoost on TCGA survival prediction. New here is the pairing of perturbation predictors with explicit scrutiny of input features, context and noise.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-20"
}
