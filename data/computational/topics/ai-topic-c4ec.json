  "item_one_liners": {},
  "label": "Evaluating Omics Models And Agents",
  "related": [
    "diabetes-type-4df1",
    "graph-attention-90e2",
    "phenotype-biomedical-corpus-b5a5"
  ],
  "secondary_categories": [
    "single-cell"
  ],
  "slug": "ai-topic-c4ec",
  "summary": "Benchmarks test single-cell and DNA models against simple baselines and replicates, while agentic and SQL interfaces aim for grounded, checkable outputs.",
  "synthesis": "The main thread is stricter evaluation of what omics foundation models and LLM systems add beyond simple baselines and experimental ceilings. A benchmark of five single-cell foundation models against simple baselines covers annotation, in silico perturbation and GRN inference, and finds the models help mainly in limited settings. Attribution diagnostics probe scGPT, Cell2Sentence and STATE. GENESIS, trained with an energy score, predicts single-cell response distributions approaching replicate reproducibility. BEND 2.0 extends DNA language model benchmarking to sequence design and reports gains from linear readouts and post-training. In synthetic-lethality prediction, degree-matched AUROC dissociates from screen retrieval: near-chance models still gave 2.62-fold enrichment. On the LLM side, CellCanon proposes an agentic cellular world model with evidence-grounded explanation and observation-driven updating. SPaRTA offers a 7,500-pair text-to-spatial-SQL benchmark with failure-mode analysis. A Rosalind assessment compares GPT-5.2 and Claude Sonnet 4.6 with expert and human answers. SurvXAI generates local LLM narratives from SurvSHAP attributions.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-05"
}
