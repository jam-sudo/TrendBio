  "label": "Generative Single Cell Perturbation Modeling",
  "related": [
    "regulatory-gene-9c82",
    "amr-cabbage-cdaf",
    "learning-causation-2f3a"
  ],
  "secondary_categories": [],
  "slug": "ai-topic-c4ec",
  "summary": "New preprints pair full-gene, graph-guided and disentangled generative perturbation predictors with simulators and benchmarks for evaluating single-cell methods.",
  "synthesis": "The dominant thread is generative prediction of single-cell perturbation responses, with emphasis on separating treatment effects from confounding variation. PertVI disentangles mitotic phase, cell state, batch and treatment. A normalized HSIC kernel regularizer for concept bottleneck models targets nonlinear dependence between known and unknown factors in counterfactual generation. For generalization, scBIG++ models all genes using gene-module clustering across genetic and chemical perturbations. Graph-guided Flow Matching combines knowledge graphs with latent flow matching for unseen Perturb-seq perturbations, and LingoCell links single-cell and spatial transcriptomics with language for in silico perturbation. Evaluation infrastructure appears alongside these models. scDeepSim uses a structured VAE with latent diffusion to intervene on biological and technical factors for controlled benchmarking. A community benchmark assesses 11 generative methods for synthetic bulk RNA-seq. Mechanistic noise modeling, including PhysInfer for transcriptional bursting and stochprofIC for noise-corrected state variability, addresses technical versus biological variation in single-cell data.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-16"
}
