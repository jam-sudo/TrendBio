  "item_one_liners": {},
  "label": "Cancer Progression Multi Omics Signatures",
  "related": [
    "ensemble-expression-4332",
    "biomarkers-machine-fb4f",
    "fetal-preeclampsia-cfc2"
  ],
  "secondary_categories": [
    "single-cell"
  ],
  "slug": "promotes-progression-f353",
  "summary": "Multi-omics, spatial, and machine learning approaches now resolve prognostic signatures and stromal programs across several cancer types.",
  "synthesis": "The dominant thread is multi-omics integration paired with machine learning or survival modeling to nominate prognostic and regulatory candidates in tumor progression. Examples include a pan-cancer and single-cell analysis nominating UBE2C in breast cancer, a multi-omics deep neural network for cervical cancer survival, and a single-cell-derived osteosarcoma signature. Stromal biology is the most explicit recurring theme: GPC1 and CHPF mark an ADAM12-associated cancer-associated fibroblast program in colorectal cancer, and ALKBH5 in fibroblasts drives pancreatic metastasis. Epitranscriptomic regulation (METTL14, hnRNPC, ALYREF) recurs across items. Not every item shares this thread; the platelet RNA glioblastoma and TSPAN13 studies are more loosely connected. What is new is the combination of scRNA-seq, spatial transcriptomics, and in situ sequencing to define risk-stratifying subclusters, such as epithelial subcluster epi8 in LSIL cervical lesions.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-04"
}
