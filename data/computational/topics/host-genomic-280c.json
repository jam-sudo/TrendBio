  "item_one_liners": {},
  "label": "Fitness Landscape Model Inference",
  "related": [
    "criticality-mechanism-robust-5b90",
    "gene-expression-5e8d",
    "fungal-calibrated-8715"
  ],
  "secondary_categories": [
    "ml-ai",
    "systems"
  ],
  "slug": "host-genomic-280c",
  "summary": "Data-driven inference of population and fitness models is now being checked against curated landscapes and interpretable summary statistics.",
  "synthesis": "The three items share a concern with inferring structure from data in evolutionary and population models rather than specifying it a priori. A convolutional neural network trained in population genetics is interrogated with SHAP to determine which learned features track summary statistics such as heterozygosity and linkage disequilibrium, offering a route to interpreting otherwise opaque predictors. On the GFP random mutagenesis fitness landscape, Power Transforms are tested as a means of addressing nonlinearity; Box-Cox reduces local pairwise epistasis by 19.4%, suggesting that the measurement scale on which fitness is expressed alters the apparent epistatic structure. The published WSINDy extension learns structured population models with heterogeneous dynamics and boundary processes. What is new is the joint emphasis on interpretability and on measurement scale as determinants of inferred nonlinearity, though the items address these concerns to differing degrees.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-12-13"
}
