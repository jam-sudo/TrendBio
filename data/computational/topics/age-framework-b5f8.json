  "item_one_liners": {},
  "label": "Stochastic Gene Expression Dynamics",
  "related": [
    "mechanisms-viral-a1e5",
    "driven-topic-569d",
    "model-coupling-c52b"
  ],
  "secondary_categories": [],
  "slug": "age-framework-b5f8",
  "summary": "Recent preprints extract transmission and timing properties directly from stochastic gene-expression dynamics rather than introducing new model classes.",
  "synthesis": "The dominant thread is theoretical and computational analysis of how stochastic production and degradation shape dynamical outputs in gene expression and cell signaling. A martingale-based framework links degradation, bursting and cycle variability to the transmission of gene-expression rhythms and is fitted to p53 data. A separate preprint derives optimal feedback that minimizes first-passage-time variability under bursty production and degradation. A third analyzes how steady-state dose-response curves govern information transmission in single- and multi-step cell signaling. The fourth presents GeneRegulatorySystems.jl, which uses a biophysical chemical master equation for exact stochastic simulation of nonlinear gene regulation. What is new is the extraction of transmission and timing properties directly from stochastic dynamics rather than the introduction of new model classes. All four are preprints without published validation, and rhythm filtering, event timing and information transmission are treated separately rather than unified.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-03"
}
