  "item_one_liners": {},
  "label": "Stochastic Models Of Cell State",
  "related": [
    "microbe-comprehensive-mapping-583d",
    "amino-acid-6d41",
    "protein-topic-c613"
  ],
  "secondary_categories": [],
  "slug": "age-framework-b5f8",
  "summary": "New models connect stochastic RNA repair, transcriptome folding energy and kinetic parameter uncertainty to cell state and metabolic predictions.",
  "synthesis": "The dominant thread is the use of mechanistic quantitative models to link molecular-scale variability or constraints to cell-level state. A stochastic model of Rtc-mediated RNA repair in E. coli yields bimodal translational capacity and switching between resistant and susceptible cells. A thermodynamic model relates shifts in transcriptome RNA folding energy to growth state across the cell cycle, drug-stressed cancer cells and E. coli. The metabolic items are less directly about stochastic expression: GEM-CM couples reaction-diffusion models with random-forest surrogates of genome-scale models for P. aeruginosa in gels, and kinGEMs uses uncertainty-aware stochastic tuning of deep learning-predicted kcat values for enzyme-constrained models across 93 organisms. Novelty lies in attributing state switching and growth dependence to these descriptions. Three of the four items are preprints, and only kinGEMs is published.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-10"
}
