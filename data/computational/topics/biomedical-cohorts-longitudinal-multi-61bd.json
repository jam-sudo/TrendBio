  "label": "De Novo Peptide Sequencing Pipelines",
  "related": [
    "spectrum-prediction-35c1",
    "design-automated-f642",
    "arny-comprehensive-web-6066"
  ],
  "secondary_categories": [
    "ml-ai"
  ],
  "slug": "biomedical-cohorts-longitudinal-multi-61bd",
  "summary": "Three 2026 preprints extend deep learning de novo sequencing to unlabeled spectra, TMTpro-labeled phosphopeptides, and integrated rescoring workflows.",
  "synthesis": "The common thread is computational improvement of peptide identification from tandem mass spectra, pursued through model training and post-search processing. SemiNovo applies a semi-supervised framework that learns from unlabeled spectra using the DarkSpec corpus and mass-constrained modelling. Casanovo-TMT extends the Casanovo de novo model to TMTpro-labeled peptides and phosphopeptides, reporting 84.7% exact-peptidoform accuracy. MSGFLEX provides an end-to-end proteomics and metaproteomics pipeline built on MS-GF+, adding XPECTRA XGBoost rescoring and QUANTIX protein quantification, and is reported to outperform Percolator. What is new is the extension of deep learning sequencing to labeled and modified peptides and the integration of rescoring with quantification in one workflow. The items are heterogeneous in scope: SemiNovo concerns training data, while MSGFLEX concerns pipeline design and quantification.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-23"
}
