  "item_one_liners": {},
  "label": "Noise Aware Drug Response Modelling",
  "related": [
    "neuronal-state-4725",
    "ai-topic-c4ec",
    "000-100-7630"
  ],
  "secondary_categories": [],
  "slug": "metabolic-trait-robustness-microbial-e869",
  "summary": "New preprints model assay and label noise in drug-response and siRNA prediction, while benchmarks and multi-omics survival methods address evaluation and interpretability.",
  "synthesis": "The dominant thread is explicit treatment of measurement error and uncertainty in pharmacological prediction. DeepCINET models viability-assay noise in cancer cell line screens within a ranking framework, and siGMA uses a heteroscedastic multimodal model with aleatoric and epistemic uncertainty for chemically modified siRNA efficacy. Evaluation is a parallel concern: the Virtual Cell Challenge 2026 metrics are calibrated on experimental repeats, and a benchmark of 12 joint dimension reduction methods on 18 TCGA datasets finds JIVE and RGCCA strongest for survival prediction. Other work enriches features or interpretability, including site-resolved PTM states (PTM-BDL), spatial transcriptomic signatures, transcriptional program reversal scoring (ProReT), signalling-network synergy simulation (TRAFIKK), and zero- and few-shot pan-cancer survival (UniPanSurv). These do not all model noise directly.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-27"
}
