  "item_one_liners": {},
  "label": "Single Cell Perturbation Modeling",
  "related": [
    "open-electrophysiological-e8a5",
    "regulatory-gene-9c82",
    "model-elucidating-325c"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "flow-matching-continuous-molecular-a38a",
  "summary": "Several new preprints pair generalizable perturbation-response predictors with explicit regulatory, pathway or dynamical structure in single-cell data.",
  "synthesis": "The dominant thread is predicting single-cell transcriptional responses to genetic or chemical perturbation and attributing them to regulatory structure. Predictive approaches diverge in architecture. CytoWave uses two-stage perturbation-centric pretraining across datasets. RELAY conditions on measured control–perturbed pairs via relational in-context learning. SPEAR uses flow-based generation with spectral Laplacian gene encodings. EMBER probes frozen contextualized gene embeddings for single, digenic and drug responses. GRAFT transfers genetic perturbation information to zero-shot drug-response prediction across cell types. On the mechanistic side, REGA-perturb resolves TF–regulatory element–gene paths using Perturb-seq latent programs and reference epigenomes. RAPTORGraph pairs a beta-VAE with a graph pathway encoder for causal discovery. ExPert inverts the task, inferring causal perturbations from observed states across 12 contexts. Adjacent work covers regulator prioritization in reprogramming (FateDriver), gene-set selection for GRN inference (GSET), context-dependent rewiring via sparse ODEs (Co2ODE), and age-indexed gene sets (MAGE). What is new is coupling cross-context or cross-modality generalization with explicit regulatory, pathway or dynamical constraints.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-05"
}
