  "item_one_liners": {},
  "label": "Perturbation Response And Regulatory Inference",
  "related": [
    "structure-fast-6329",
    "open-electrophysiological-e8a5",
    "regulatory-gene-9c82"
  ],
  "secondary_categories": [],
  "slug": "flow-matching-continuous-molecular-a38a",
  "summary": "New preprints pair perturbation response generation with causal GRN and regulatory-path inference from Perturb-seq, scATAC and lineage data.",
  "synthesis": "The dominant thread is moving from descriptive single-cell modeling toward mechanistic and causal accounts of perturbation. SPEAR predicts perturbation responses with flow-based generation and spectral Laplacian gene encodings. RAPTORGraph and CausalODE target causal structure in Perturb-seq, through a graph pathway encoder in a beta-VAE and a causal reach metric over latent mediator dynamics, respectively. REGA-perturb resolves perturbation effects along TF-regulatory element-gene paths using reference epigenomes. A related group infers regulation from other axes: GSET uses temporal embeddings and optimal transport residuals, scPhyloGRN uses lineage topology, MUSS uses sequence plus scATAC and scRNA, and VIGAT uses a vision-language model for scATAC gene activity. scCont adds attribution-based interpretability for state transitions. Evidence here is preprint-level, and the items do not report head-to-head comparisons across these approaches.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-09"
}
