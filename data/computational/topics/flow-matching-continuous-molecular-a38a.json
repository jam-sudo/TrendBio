  "item_one_liners": {},
  "label": "Perturbation Response And Regulatory Inference",
  "related": [
    "structure-fast-6329",
    "language-large-018c",
    "open-electrophysiological-e8a5"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "flow-matching-continuous-molecular-a38a",
  "summary": "Preprints now pair perturbation prediction with causal graph inference and multimodal regulatory models for single-cell data.",
  "synthesis": "The common thread is a shift from descriptive single-cell modeling toward mechanistic and causal accounts of gene regulation and perturbation. CausalODE and RAPTORGraph infer causal gene regulatory structure from Perturb-seq, using a causal reach metric over latent mediator dynamics and a graph pathway encoder in a beta-VAE, respectively. SPEAR addresses response prediction with flow-based generation and spectral Laplacian gene encodings. Regulatory inference is also approached through other evidence axes: MUSS integrates DNA sequence with scATAC-seq peaks and scRNA-seq, CellReg3D combines DNA language model embeddings with Hi-C 3D chromatin interactions, and scPhyloGRN uses cellular phylogeny to prioritize TF-target edges. scCont adds Shapley-based attribution for gene programs along an EMT timecourse. Most items are preprints, and none reports head-to-head comparisons across these approaches.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-10"
}
