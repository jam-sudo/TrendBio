  "label": "Eeg Model Evaluation Controls",
  "related": [
    "cross-aligned-3a51",
    "brain-topic-e0aa",
    "nucleic-acid-835d"
  ],
  "secondary_categories": [],
  "slug": "mural-cerebral-88f6",
  "summary": "Leakage and artifact controls now determine whether EEG decoding claims, from imagined speech to LLM-layer context, survive scrutiny.",
  "synthesis": "The shared thread is interrogation of what an EEG decoder actually reflects. In cross-subject imagined-speech decoding from scalp EEG, leakage-controlled evaluation on three public corpora finds that no participant pair transfers above chance. Per-layer decoding of Llama-3.1-8B from EEG during silent reading shows word identity peaking early while passage-level context rises with depth, with controls excluding session artifacts. A duration-aware RSSM world model for sleep staging learns stage dwell times and enforces minimum dwell as a hard decoding-time constraint. What is new is the explicit use of controls and structural constraints to qualify what decoded content means, rather than treating accuracy as the primary output.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-16"
}
