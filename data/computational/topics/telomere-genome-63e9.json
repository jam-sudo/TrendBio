  "item_one_liners": {},
  "label": "Genome Scale Metabolic Modeling",
  "related": [
    "networks-cycles-e4e1",
    "metabolic-topic-372f",
    "computational-lymphangion-493f"
  ],
  "secondary_categories": [
    "metabolomics"
  ],
  "slug": "telomere-genome-63e9",
  "summary": "Curated genome-scale reconstructions and learned models now operate directly on isotope labeling, flux, and essentiality data.",
  "synthesis": "The common thread is the construction and extension of genome-scale metabolic frameworks, increasingly coupled to data-driven inference. iJL1143 was built as a curated model of Fusarium venenatum A3/5 from an A. niger template, using rule-based curation and validation against batch fermentation biomass data. coralME v1.3 extends ME-model analysis to non-canonical amino acid translation, protein and RNA degradation reactions, arbitrary coupling coefficients, and cofactor essentiality in bacterial models; it is primarily a software and analysis extension rather than a learning method. On the inference side, HyperGenie applies directed hypergraph neural networks to genome-scale models to predict bacterial gene essentiality from wild-type flux features, and Flux Transformer infers mass-balanced fluxes from isotope labeling and measured reaction rates. The new element is learned models operating directly on curated reconstructions and labeling data. This pattern describes the dominant thread across these four preprints, not every item.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-22"
}
