  "item_one_liners": {},
  "label": "Genome Scale Metabolic Modeling",
  "related": [
    "molecules-diffusion-cbc9",
    "metabolic-topic-372f",
    "alignment-biological-discovery-performer-8956"
  ],
  "secondary_categories": [],
  "slug": "telomere-genome-63e9",
  "summary": "Expanded ME-model and curated genome-scale frameworks now test stoichiometric and proteome-level constraints across bacteria and fungi.",
  "synthesis": "The common thread is constraint-based reconstruction of microbial metabolism, in which genome-scale resources are curated, extended, and tested against experimental data. A curated model of the mycoprotein fungus Fusarium venenatum A3/5, iJL1143, was built from an Aspergillus niger template through rule-based curation and validated against batch fermentation biomass data. coralME v1.3 extends ME-model analysis to non-canonical amino acid translation, protein and RNA degradation, arbitrary coupling coefficients, and cofactor essentiality in bacterial models. A separate study introduces an unbiased method to quantify catabolism-anabolism stoichiometry in genome-scale models, applied to heterotrophic microbial catabolism. What is new is the extension of model scope into recoding, proteostasis, RNA decay, and the stoichiometric structure of objectives. The studies differ in organism and method, and the shared element is reliance on curated genome-scale frameworks to connect genotype to predicted metabolic function.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-18"
}
