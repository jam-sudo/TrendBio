  "label": "Microbial Genome Knowledgebases",
  "related": [
    "structural-diversity-c91f",
    "networks-cycles-e4e1",
    "influenza-virus-evolution-biology-83d3"
  ],
  "secondary_categories": [],
  "slug": "telomere-genome-63e9",
  "summary": "Expanded metabolic models, pathway annotation, and enzyme prediction tools are updating how microbial genome-scale function is inferred from sequence.",
  "synthesis": "The dominant thread is computational inference of microbial metabolic function from curated or large-scale genomic and metagenomic resources. GapMind 2026 updates pathway annotation with newly validated enzymes for amino acid biosynthesis and halves unexplained gaps per genome. A systematic review and benchmark of EC number prediction from reaction chemical structures compares similarity-based and ML/deep approaches. Metabolic modeling extends in two directions: coralME v1.3 adds non-canonical amino acid translation, protein and RNA degradation, and arbitrary coupling coefficients, while genome-scale models of 105 C. difficile strains show that diet affects commensal interactions more than strain differences. Deep learning applied to metagenomes identifies over 46,000 putative environmental beta-lactamases, expanding the characterized diversity of this enzyme family. The studies differ in method and scale; they share reliance on curated or large-scale reference resources that connect sequence to predicted function.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-17"
}
