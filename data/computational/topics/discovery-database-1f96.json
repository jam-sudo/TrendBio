  "secondary_categories": [],
  "slug": "discovery-database-1f96",
  "summary": "Updated curated resources now add AI-assisted curation, sequence-level fusion data, and expanded rat variant and disease coverage.",
  "synthesis": "The three updates describe major releases of established curated resources, each expanding what is stored and how it can be computed on. CIViC 2026 extends its open cancer variant knowledgebase with Feature entities, Molecular Profiles, AI-guided curation, and ClinVar submission. The Rat Genome Database reports new rat reference and strain assemblies, variant data for 118 strains, reprocessed GEO RNA-Seq, new disease portals, and redesigned tools. FusionGDB 3.0 integrates breakpoints from 156K fusion genes derived from RNA-seq and WGS data, generates personalized fusion protein sequences, and infers tumorigenic scenarios. The common element is the combination of expanded primary data with computational layers, including AI-assisted curation, personalized sequence generation, and reprocessing of public datasets.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-26"
}
