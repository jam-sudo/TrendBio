  "label": "Curated Biomedical Database Updates",
  "related": [
    "consortium-2026-0b54",
    "receptor-peptides-6d28",
    "aspidoscelis-whiptail-0f6c"
  ],
  "secondary_categories": [],
  "slug": "discovery-database-1f96",
  "summary": "Recent 2026 releases of curated genome-function, cancer, rat, and fusion-gene resources expand stored data and computational access.",
  "synthesis": "The five items are updates to, or descriptions of, established curated and integrated resources spanning genome function, cancer variant interpretation, rat disease models, fusion genes, and null-allele phenotypes. The dominant shared thread is the pairing of expanded primary data with computational layers. CIViC 2026 adds Feature entities, Molecular Profiles, AI-guided curation, and ClinVar submission to its open cancer variant knowledgebase. FusionGDB 3.0 integrates breakpoints from 156K fusion genes derived from RNA-seq and WGS data, generates personalized fusion protein sequences, and infers tumorigenic scenarios. The Rat Genome Database reports variant data for 118 strains and reprocessed GEO RNA-Seq alongside redesigned tools. The MorPhiC Data Portal integrates uniformly analyzed functional genomics datasets, including Perturb-seq and SLAM-seq. The IGVF Data Portal, a preprint, offers a public repository and API with knowledge-graph-integrated results. What is new is less the existence of these resources than the reprocessing and computational interpretation applied to public and consortium data.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-27"
}
