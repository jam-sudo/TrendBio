  "item_one_liners": {},
  "label": "Generalization Aware Binding Model Benchmarking",
  "related": [
    "cryo-structure-34d6",
    "builder-capsid-20a5",
    "model-rna-906f"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "optimal-transport-flow-matching-ea35",
  "summary": "New benchmarks for pose ranking, enzyme mutant prioritization and ligand-aware binding sites test transfer regimes rather than aggregate accuracy.",
  "synthesis": "The dominant thread is that how a held-out set is constructed increasingly determines what a binding or activity predictor is claimed to achieve. The OneProt profiling study reports that dataset properties dominate encoder architecture and modality choice for allosteric versus orthosteric site classification. EnzyArena groups enzyme kinetic data by campaign and evaluates 20 models for mutant prioritization, with zero-shot consensus best and a 150-mutant experimental check. Pyrite builds a 1,500-pair benchmark for ranking cofolding poses, with LLM agents reaching up to 74% accuracy. A ligand-aware benchmark evaluates residue-level binding-site prediction from PLM and SMILES-based CLM embeddings under explicit generalization splits, while contrastive learning on M2OR is assessed by cross-dataset transfer to iOBPdb. Architecturally varied entries — Bonbon's zero-shot emergent binding-site and covalent-bond behaviors, DTBNet, MBFGNK — are differentiated chiefly by the regimes under which they are tested.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-13"
}
