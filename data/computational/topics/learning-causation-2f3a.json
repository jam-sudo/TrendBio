  "item_one_liners": {},
  "label": "Calibrated Inference For Compositional Omics",
  "related": [
    "sequencing-genome-dba8",
    "automated-microscopy-2e31",
    "untitled-topic-1773"
  ],
  "secondary_categories": [
    "single-cell"
  ],
  "slug": "learning-causation-2f3a",
  "summary": "New benchmarks and resampling tests address confounding and calibration in microbiome and related omics inference, alongside tools for longitudinal and circadian data.",
  "synthesis": "The dominant thread is statistical inference for compositional and high-dimensional omics data under confounding and weak calibration. A benchmark of 71 single-cohort and 63 multi-cohort confounder-aware differential abundance strategies releases xConDA, and a separate benchmark evaluates 12 differential composition methods on three population-scale scRNA-seq datasets using real data, permutations and simulations. ssGSEA3.0 replaces feature-label permutation with feature-level bootstrap resampling to improve significance calibration. IsoVita learns interpretable compositional features along continuous covariates with change point and spline tests. TensorPLS adds tensor-based PLS-DA for longitudinal omics, and scCircaSim and CircaVal support circadian analysis. What is new is systematic benchmarking across single- and multi-cohort settings and resampling schemes that replace permutation-based null models.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-07"
}
