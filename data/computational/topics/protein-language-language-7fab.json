  "label": "Protein Language Model Interaction Prediction",
  "related": [
    "em-chain-3b35",
    "venom-variation-b328",
    "resistance-analysing-antifungal-a8e9"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "protein-language-language-7fab",
  "summary": "Recent papers couple protein language model embeddings with graph, contrastive, and reinforcement learning for binding and design tasks.",
  "synthesis": "The dominant thread is the use of pretrained protein language model embeddings, or residue-level representations derived from them, as inputs to task-specific predictors of molecular interactions and properties. Most items are supervised binding or interaction tasks: MPFIL predicts mutation-induced changes in protein-protein binding affinity from wild-type and mutant complex features, PDI-Spot identifies energetic hotspots in protein-DNA complexes, PRIDA predicts protein-RNA interactions, and pMHCBind predicts MHC class I-peptide interactions. Methodological novelty lies in the training regime rather than the representation alone: ECL-Net adds an EGNN and contrastive learning for thermostability, PRIDA uses conditional domain-adversarial learning for cross-domain transfer, AbLWR recasts affinity prediction as listwise ranking under positive-unlabeled learning, and AbOptimizer applies reinforcement learning with Pareto rewards to antibody sequence editing.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-29"
}
