  "item_one_liners": {},
  "label": "Multiomics Cancer Biomarker Discovery",
  "related": [
    "ab-ab-initio-b4d4",
    "sperm-challenges-current-65bb",
    "chemical-modifications-polyphenism-6869"
  ],
  "secondary_categories": [
    "transcriptomics"
  ],
  "slug": "risk-type-815e",
  "summary": "Multi-omics studies across cancer types are now pairing several data layers with candidate biomarker and prognostic readouts.",
  "synthesis": "The common thread is integrative multiomics applied to candidate biomarker and prognostic discovery, dominated by cancer. Examples include a MOFA+ integration of paired scRNA-seq and scATAC-seq in two NMIBC patients, yielding a BCG-associated HSPC factor with an adverse prognostic association in tumour; a pooled analysis of 7,527 pancreatic adenocarcinoma tumours linking ancestry to SNV density and GNAS driver frequency; and pan-cancer analyses of WASHC2C across 4365 tumors and APOBEC family members across 9653 TCGA tumors. Newer elements add spatial and single-cell resolution, including HPV integration architecture classified in 197 tumours, lineage tracing with parallel single-cell multiome after ARID1A deficiency, and tertiary lymphoid structures scored by spatial-functional state rather than density. Not every item shares this framing; two are reviews, and candidate markers remain largely hypothesis-generating.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-10"
}
