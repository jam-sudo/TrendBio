  "item_one_liners": {},
  "label": "Evidence Grounded Biomedical Knowledge Graphs",
  "related": [
    "molecular-graph-18ef",
    "brain-gpc-b1f5",
    "eeg-topic-c715"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "concentrate-contacts-62cb",
  "summary": "Biomedical knowledge graphs and subgraph tools increasingly need traceable evidence to support hypothesis generation and target assessment.",
  "synthesis": "The dominant thread is making inference over biomedical knowledge graphs traceable to underlying evidence. SPIDER grounds knowledge-graph relations in PubMed evidence through a multi-agent framework and builds SPIDER-KG as an incrementally updated evidence resource. BiomedCAT takes a different route to the same end, converting biomedical slides into user-shaped RTX-KG2c subgraphs with a vision-language model and a typing agent, intended to support mechanistic hypothesis generation. BRIDGE applies the same logic to genetic support for therapeutic targets, propagating evidence over coupled protein and disease networks and raising target-indication coverage from 5.1% to 9.5%. What is new is that the graph itself is treated as an auditable object: relations are tied to literature, subgraphs are scoped by the user, and network propagation is evaluated by coverage. The items address different tasks, so this thread describes their shared emphasis rather than a uniform method.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-20"
}
