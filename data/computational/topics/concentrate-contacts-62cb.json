  "item_one_liners": {},
  "label": "Evidence Grounded Biomedical Knowledge Graphs",
  "related": [
    "molecular-graph-18ef",
    "eeg-topic-c715",
    "brain-gpc-b1f5"
  ],
  "secondary_categories": [
    "ml-ai",
    "systems"
  ],
  "slug": "concentrate-contacts-62cb",
  "summary": "Four November 2026 preprints make knowledge-graph inference traceable to literature, user-scoped subgraphs, and genetic propagation metrics.",
  "synthesis": "The dominant thread is making inference over biomedical knowledge graphs auditable against underlying evidence. SPIDER grounds graph relations in PubMed evidence through a multi-agent framework and maintains SPIDER-KG as an incrementally updated resource. BiomedCAT converts biomedical slides into user-shaped RTX-KG2c subgraphs using a vision-language model and a typing agent, aimed at mechanistic hypothesis generation. BRIDGE propagates genetic evidence over coupled protein and disease networks, raising target-indication coverage from 5.1% to 9.5%. The uncertainty-conditioned path-energy preprint maps genomic model predictions over AlzKB and Hetionet to phenotype hypotheses, carrying uncertainty through the graph. What is new is that the graph is treated as an object whose relations are tied to literature, whose subgraphs are scoped by the user, and whose propagation is judged by coverage. The tasks differ, so this describes a shared emphasis rather than a uniform method.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-20"
}
