  "item_one_liners": {},
  "label": "Evidence Grounded Biomedical Knowledge Graphs",
  "related": [
    "molecular-graph-18ef",
    "brain-gpc-b1f5",
    "disease-mri-fab5"
  ],
  "secondary_categories": [
    "tools-infra"
  ],
  "slug": "concentrate-contacts-62cb",
  "summary": "Five preprints tie knowledge-graph inference to PubMed evidence, user-scoped subgraphs, genetic propagation and topology-bias correction for target prioritisation.",
  "synthesis": "The dominant thread is making knowledge-graph reasoning more evidence-aware and less distorted by graph structure. SPIDER grounds graph relations in PubMed evidence and maintains SPIDER-KG as an incrementally updated resource. BiomedCAT builds user-shaped RTX-KG2c subgraphs from slides to support mechanistic hypothesis generation. The uncertainty-conditioned path-energy framework maps genomic model predictions over AlzKB and Hetionet to phenotype hypotheses. For target prioritisation, BRIDGE propagates genetic evidence over coupled protein and disease networks, raising target-indication coverage from 5.1% to 9.5%, and Inverse Node Frequency normalises metapath features to reduce hub bias in target-adverse event prediction. The tasks and methods differ, so the shared emphasis is on provenance, scoping and topological correction rather than a common architecture.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-21"
}
