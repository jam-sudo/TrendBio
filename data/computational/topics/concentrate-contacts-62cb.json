  "item_one_liners": {},
  "label": "Auditable Biomedical Ml Evaluation",
  "related": [
    "aware-topic-51b6",
    "biomedical-decision-dimensionality-reduction-0c53",
    "disease-mri-fab5"
  ],
  "secondary_categories": [],
  "slug": "concentrate-contacts-62cb",
  "summary": "Recent items pair leakage-aware evaluation protocols with architectures for scaffold heterogeneity and conflicting evidence in drug and molecular modeling.",
  "synthesis": "The dominant thread is making generalization under distribution shift explicit and testable in biomedical ML. A fixed solvent-level out-of-distribution benchmark on 103,262 BigSolDB v2.1 records moves solubility evaluation from random splits to unseen solvents, where QM-derived σ-moment surface descriptors improve held-out solvent R2. A perspective on cold-start evaluation of drug-drug and drug-target interaction models frames such claims as auditable, proposing an L0-L5 framework and a leakage checklist. Method papers target specific settings: FedSPL shares embedding prototypes alongside model parameters under scaffold heterogeneity, MIRAGE-DTA arbitrates conflicting multimodal evidence for affinity prediction using modality masks and training-only retrieval, and ViSRTI approximates NORMAN-predicted retention time indices from 3D molecular geometry. What is new is pairing stricter protocols with architectures built for heterogeneity and conflict. The items address different tasks, so this is the dominant thread rather than a property shared by every item.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-16"
}
