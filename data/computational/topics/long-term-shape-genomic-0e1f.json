  "item_one_liners": {},
  "label": "Assembly Quality And Reference Bias",
  "related": [
    "genome-assembly-e9c4",
    "environmental-microbiomes-e3ba",
    "genome-evolution-3106"
  ],
  "secondary_categories": [],
  "slug": "long-term-shape-genomic-0e1f",
  "summary": "Long-read and telomere-to-telomere assemblies now expose structural errors and reference dependence that affect downstream genomic comparisons.",
  "synthesis": "The dominant thread is that assembly quality and reference choice constrain downstream genomic comparison. The Bombyx study finds six long-read W chromosome assemblies structurally inconsistent, yet a curated W repeat library still recovers strongly reduced repeat diversity, indicating that some biological signal survives assembly error. PhyloRBT addresses reference dependence at the phylogenomic level by testing BUSCO loci for reference bias across multiple reference genomes. The Cupressus and Nelumbo papers supply high-continuity resources, a 10 Gb chromosome-scale conifer assembly and two telomere-to-telomere lotus genomes, the kind of reference such comparisons depend on. What is new is treating reference dependence as a testable variable rather than an assumed one. The items do not establish a shared evolutionary mechanism.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-07-30"
}
