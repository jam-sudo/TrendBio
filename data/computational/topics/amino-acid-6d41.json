  "item_one_liners": {},
  "label": "Microbial Genome Mining And Modeling",
  "related": [
    "microbe-comprehensive-mapping-583d",
    "influenza-virus-evolution-biology-83d3",
    "age-framework-b5f8"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "amino-acid-6d41",
  "summary": "Recent work pairs protein language models, deep kcat prediction, ML surrogates and pangenome factorization to mine and model microbial genomes.",
  "synthesis": "The dominant thread is the use of learned models to extract function from microbial sequence data and to make mechanistic simulations tractable. On the mining side, protein language models combined with ensemble learning identify over 46,000 putative environmental beta-lactamases from metagenomes, with inverse folding used to probe their mutational potential. Non-negative matrix factorization of 1,398 S. aureus genomes decomposes the accessory pangenome into 24 additive gene modules that separate lineage-associated content from content linked to adaptation and virulence. On the modeling side, kinGEMs pairs CPI-Pred, a deep learning kcat predictor, with uncertainty-aware stochastic tuning to build enzyme-constrained metabolic models for 93 organisms. GEM-CM couples reaction-diffusion models to random-forest surrogates of genome-scale models to simulate P. aeruginosa PA14 in gels. gcPathogen 2.0 adds an expanded multi-omics resource for pathogen surveillance. Together, these items show learned predictors parameterizing or coarse-graining mechanistic microbial models and scaling sequence-based discovery.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-13"
}
