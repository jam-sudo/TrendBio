  "item_one_liners": {},
  "label": "Microbial Sequence Language Models",
  "related": [
    "foundation-models-encoder-9f80",
    "metabolism-proteomics-41aa",
    "microbe-comprehensive-mapping-583d"
  ],
  "secondary_categories": [
    "genomics",
    "systems"
  ],
  "slug": "amino-acid-6d41",
  "summary": "New preprints adapt ESM-2, ProGen and DNA language models to AMP design, AMR annotation and metagenomic taxonomy, alongside ML-augmented metabolic models.",
  "synthesis": "The dominant thread is the adaptation of pretrained sequence language models to antimicrobial and microbial annotation tasks. On the protein side, multi-task LoRA fine-tuning of ESM-2 (150M) jointly predicts AMP antibacterial potency and hemolytic toxicity under 60% homology splits. XAMPGen fine-tunes ProGen for AMP generation and uses probing classifiers and self-attention analysis to interpret the model. BacLLM fuses UniProt annotation priors into protein language models for AMR gene and mechanism analysis. On the nucleotide side, MicrobeRT fine-tunes Nucleotide Transformer, DNABERT and HyenaDNA for metagenomic read taxonomy and resistance gene detection. A secondary thread uses ML within constraint-based metabolism. kinGEMs tunes deep-learning-predicted kcat values to build enzyme-constrained models across 93 organisms. GEM-CM couples reaction-diffusion with random-forest surrogates of P. aeruginosa GEMs. NanoPAMDA (Cas9 PAM characterization) and VENAS2 (bidirectional-mutation surveillance networks) are adjacent rather than shared-method work.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-09"
}
