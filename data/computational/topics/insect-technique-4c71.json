  "item_one_liners": {},
  "label": "Interpretable Single Cell Modeling",
  "related": [
    "amr-cabbage-cdaf",
    "graph-neural-networks-a7c7",
    "lineage-aware-stochastic-8331"
  ],
  "secondary_categories": [
    "transcriptomics"
  ],
  "slug": "insect-technique-4c71",
  "summary": "Trajectory-aware models now expose stage-specific markers, fate commitment metrics, and 3D spatial expression fields rather than leaving them implicit.",
  "synthesis": "The shared thread is making structure that is usually implicit in embeddings explicit and inspectable. FusedFCR uses a regularized forward continuation-ratio model with lasso and fusion penalties to select stage-specific markers along cell-fate trajectories and projects cells onto a pseudotime-like axis. scCS quantifies fate commitment, speed, affinity and entropy via discounted future-fate propagation within a scverse-compatible Python framework. Loom brings pseudo-temporal trajectories to spatial transcriptomics, pairing cross-sample comparison with local microenvironment analysis. Spaceland extends spatial profiling to whole-organ scale, reconstructing continuous high-resolution 3D gene-expression fields from sparse spatial transcriptomics and serial H&E histology. What is new is the attempt to attach interpretable quantities, such as marker sets, fate metrics, and spatial fields, directly to the modeled process.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-07-30"
}
