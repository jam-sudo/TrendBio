  "item_one_liners": {},
  "label": "Ml Candidate Prioritization Models",
  "related": [
    "database-genome-3c30",
    "reveals-family-e2f1",
    "execution-topic-7655"
  ],
  "secondary_categories": [],
  "slug": "conformational-protein-8241",
  "summary": "Recent preprints pair candidate-ranking models with conformal intervals, evidence attribution, and temporal validation.",
  "synthesis": "The dominant thread is supervised or graph-based machine learning that scores candidate variants, residues, proteins or features for prioritization. AGVarPred applies a gradient-boosted classifier to gnomAD frequency, VEP annotations and AlphaGenome features for germline pathogenicity across SNVs and indels. The Tclin-likeness study ranks non-Tclin human proteins by resemblance to approved drug targets using knowledge-graph models with temporally withheld validation. ProbJanusDDG adds standard and adaptive conformal prediction intervals to a protein-stability predictor to flag mutations with resolved stabilizing or destabilizing effects. ESMfluc predicts residue-level backbone variability from ESM2/ESM3 embeddings and decomposes attention to expose per-position evidence. The Boruta study examines how Random Forest tree depth and sample-quality-associated features affect feature selection on RNA-seq classification. What is new is calibrated uncertainty, attribution of model evidence, and temporal validation, though the items do not share a single design.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-29"
}
