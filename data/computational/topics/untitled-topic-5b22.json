  "item_one_liners": {},
  "label": "Phylogenetic Inference Uncertainty",
  "related": [
    "cloud-platform-9ba7",
    "phylogenetic-tree-be52",
    "pangenome-graphs-9c95"
  ],
  "secondary_categories": [
    "genomics"
  ],
  "slug": "untitled-topic-5b22",
  "summary": "Assumptions and support values in phylogenetic and phylodynamic inference are now tested explicitly rather than taken as given.",
  "synthesis": "The common thread is the evaluation of assumptions built into phylogenetic and phylodynamic inference, and of the support values reported from them. A benchmark of fixed-tree-topology strategies on viral datasets finds substitution-model parameters robust, contrasted with clock rates and node ages. Adjusted pairwise composite likelihood offers faster Bayesian node dating than full-likelihood MCMC and greater robustness to fossil calibration uncertainty. Net Bootstrap Support provides efficient confidence limits that flag phylogenetic signal heterogeneity and overconfidence in phylogenomic relationships. Bayesian model averaging over parametric coalescent growth models addresses model choice for phylodynamic inference. What is new is treating topology, calibration, model selection, and support as explicit objects of uncertainty quantification.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-12-03"
}
