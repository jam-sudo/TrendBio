  "item_one_liners": {},
  "label": "Tumour Atlases And Spatial Resources",
  "related": [
    "annular-mean-passage-f2b7",
    "000-100-7630",
    "resolving-significance-5c78"
  ],
  "secondary_categories": [],
  "slug": "automated-microscopy-2e31",
  "summary": "New tumour databases and spatial methods pair expanded single-cell and spatial datasets with tools for annotation, imputation and cross-modal integration.",
  "synthesis": "The dominant thread is the consolidation of tumour transcriptomic data into public, queryable resources, with spatial data increasingly part of the analysis layer. TISCH3 expands to 477 datasets, including 69 spatial transcriptomics collections. A pan-cancer single-cell screen of 42 cancers reports conserved tumour microenvironment programs and releases an atlas with scTME software. PDAC BioPortal merges bulk, single-nucleus and spatial pancreatic cohorts, and DriverDBv5 and X-BCRdb add multi-omics driver and BCR-paired single-cell databases. Methods address data limits: SpaceMACE adds spatial context to tumour-cell annotation, ARC-Impute regularises cell-to-spot mapping for gene imputation, and GatorAnchor and HIT-Fuse target multimodal integration. Siphon-seq is a platelet RNA-seq method and sits outside the tumour-atlas thread.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-22"
}
