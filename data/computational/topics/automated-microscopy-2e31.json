  "item_one_liners": {},
  "label": "Tumour Immune State Modelling",
  "related": [
    "database-omics-6e2f",
    "flux-performance-8290",
    "controlled-peptide-2d9b"
  ],
  "secondary_categories": [],
  "slug": "automated-microscopy-2e31",
  "summary": "Multimodal graph learning and mechanistic pathway models now link immune evasion, T cell specificity and cytokine signalling to molecular states.",
  "synthesis": "The common thread is integrative modelling of immune and tumour states from heterogeneous molecular data. BYSTER fuses transcriptomic and paired TCR data in a graph neural network to separate bystander from tumour-specific T cells. The genomic burden study shows that genetic alterations and reversible regulatory programs jointly shape tumour states across cancers. SMG1 inhibition in NSCLC H838 cells remodels the HLA class I immunopeptidome, linking regulatory perturbation to immunogenicity. An IL-10 pathway model connects pSTAT1 and pSTAT3 levels to transcriptomic changes and anti- versus pro-inflammatory bias. The Sjögren's study, concerning autoimmunity rather than cancer, derives IFN and CD40 signatures from whole-blood transcriptomic and methylation data. What is new is the pairing of multimodal inference, such as TCR-transcriptome graph learning, with mechanistic signalling models.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-27"
}
