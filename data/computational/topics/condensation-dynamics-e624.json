  "item_one_liners": {},
  "label": "Polymer Models Of Chromatin Folding",
  "related": [
    "web-single-e509",
    "cov-polymerase-drives-sars-db55",
    "active-levy-differential-dynamic-7827"
  ],
  "secondary_categories": [
    "epigenomics"
  ],
  "slug": "condensation-dynamics-e624",
  "summary": "Megabase-scale atomistic DNA ensembles and live-cell locus tracking now test polymer models against experimental chromatin measurements.",
  "synthesis": "The common thread is the use of explicit polymer and coarse-grained models to connect measured chromatin behavior to underlying physical mechanism. Live-cell imaging paired with polymer simulations attributes coherent locus motion to ATP-driven, spatially correlated fluctuations that shape encounter frequency. HCG-DNA extends atomically detailed modeling to megabase-scale DNA and chromatin ensembles assembled from tetranucleotide libraries, recovering experimental measurements. The coarse-grained RNA condensate study is a related but distinct case, linking multidentate Mg2+ phosphate coordination to spatial ion gradients and does not address chromatin directly. What is new here is the explicit coupling of correlated fluctuations to encounter frequency in living chromatin, alongside atomic-resolution ensembles at gene scale.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-20"
}
