  "item_one_liners": {},
  "label": "Polymer Models Of Chromatin Folding",
  "related": [
    "web-single-e509",
    "active-levy-differential-dynamic-7827",
    "cov-polymerase-drives-sars-db55"
  ],
  "secondary_categories": [
    "epigenomics"
  ],
  "slug": "condensation-dynamics-e624",
  "summary": "Single-molecule-calibrated and atomistic models now quantify cohesin extrusion, chromatin locus dynamics, and megabase-scale DNA ensembles against experimental data.",
  "synthesis": "The dominant thread is the use of physically explicit polymer and coarse-grained models to connect measured chromatin behavior to underlying mechanism. A mesoscale jump-diffusion model of cohesin loop extrusion, parametrized from single-molecule data, accounts for stall force, kinetic phases and CTCF barrier function. Live-cell imaging paired with polymer simulations attributes coherent locus motion to ATP-driven, spatially correlated fluctuations that shape encounter frequency. HCG-DNA extends atomically detailed modeling to megabase-scale DNA and chromatin ensembles built from tetranucleotide libraries, recovering experimental measurements. Coarse-grained RNA condensate simulations are a related but distinct case, linking multidentate Mg2+ phosphate coordination to spatial ion gradients. What is new is the calibration of mechanistic models directly against single-molecule data and the explicit linkage of correlated fluctuations to encounter frequency.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-19"
}
