  "item_one_liners": {},
  "label": "Ion Identity In Molecular Structure",
  "related": [
    "binder-design-proton-fb1e",
    "assembly-cytomotive-design-self-cba0",
    "lipid-composition-c3e1"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "condensation-dynamics-e624",
  "summary": "Microsecond and coarse-grained simulations now resolve how specific ion species and scaffolding proteins shift conformational dynamics.",
  "synthesis": "The dominant thread is molecular simulation used to attribute conformational behavior to specific ions and their coordination. In the Sorcin study, microsecond all-atom molecular dynamics (~90 μs on Anton 3) of the dimer indicates that Ca2+ loss drives inactivation, supporting a coordination-biased conformational selection mechanism. Coarse-grained simulations of the bacterial 70S ribosome show that K+ versus Mg2+ identity alters flexibility and long-range coupling across the particle. The CheW preprint addresses a different system, a structure-based Ising lattice model of the chemosensory array, in which the scaffolding protein tunes response cooperativity, sensitivity, and fluctuations. It shares the focus on structure-to-response relationships but not the ion-specific framing. What is new across these studies is the explicit treatment of ion identity and coordination as determinants of structure, rather than ions as a uniform background.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-24"
}
