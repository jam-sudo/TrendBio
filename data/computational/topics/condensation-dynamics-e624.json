  "item_one_liners": {},
  "label": "Polymer Models Of Chromatin Folding",
  "related": [
    "active-levy-differential-dynamic-7827",
    "web-single-e509",
    "rna-folding-3942"
  ],
  "secondary_categories": [
    "epigenomics"
  ],
  "slug": "condensation-dynamics-e624",
  "summary": "Polymer and coarse-grained simulations now test how well microscopy and single-molecule measurements constrain chromatin looping and loop extrusion.",
  "synthesis": "The dominant thread is the use of physically explicit polymer and coarse-grained models to bridge experimental readouts and mechanism at chromatin scale. A ground-truth polymer study shows that thresholding noisy 3D microscopy distances misestimates looping probability, lifetime and search time, so inferred looping parameters depend on the analysis choice. A mesoscale jump-diffusion model of cohesin extrusion, parametrized from single-molecule data, accounts for stall force, kinetic phases and CTCF barrier function. Outside chromatin proper, coarse-grained simulations of RNA condensates link multidentate phosphate coordination of Mg2+ to spatial ion gradients, and HCG-DNA builds atomically detailed megabase-scale ensembles that recover experimental measurements. What is new here is explicit validation of how well measurements constrain looping, together with mechanistic models calibrated directly against single-molecule data.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-18"
}
