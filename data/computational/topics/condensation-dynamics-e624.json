  "item_one_liners": {},
  "label": "Ion Mediated Structural Dynamics",
  "related": [
    "assembly-cytomotive-design-self-cba0",
    "binder-design-proton-fb1e",
    "homeostatic-feedback-959b"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "condensation-dynamics-e624",
  "summary": "Recent simulation studies treat ion identity and competition as explicit determinants of structure rather than a uniform background.",
  "synthesis": "The shared thread is the use of molecular simulation to attribute structural and functional behavior to specific ion species and their coordination geometry. In the RNA condensate study, coarse-grained simulations link multidentate Mg2+ phosphate coordination to spatial ion gradients and heterogeneous organization within condensates. The XPR1 study, combining over 110 µs of MD with free-energy calculations, attributes phosphate selectivity between H2PO4- and HPO4^2- to protein-phosphate interactions together with direct ion-ion competition. The bacterial 70S ribosome study shows that K+ versus Mg2+ identity alters flexibility and long-range coupling across the particle. What is new is the explicit treatment of ion identity and competition as determinants of structure, rather than ions as a uniform background. The items span different systems, so the common element is methodological and mechanistic rather than a shared biological context.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-22"
}
