  "item_one_liners": {},
  "label": "Donor Aware Disease Cell Modeling",
  "related": [
    "graph-neural-networks-a7c7",
    "graph-functional-6d04",
    "immune-aging-cb9d"
  ],
  "secondary_categories": [
    "ml-ai"
  ],
  "slug": "neuronal-state-4725",
  "summary": "Several new methods treat donors as the unit of inference in case-control single-cell and spatial cohorts, prioritizing interpretable disease attribution.",
  "synthesis": "The dominant thread is attributing disease signal in multi-donor single-cell and spatial cohorts to specific cells, genes or programs while respecting donor structure. IDC contrasts within-donor gene covariation between cases and controls to score disease-associated cells and per-donor burden without batch correction. TriSCOPE combines multivariate predictive modeling, donor-aware differential expression and pseudotime across ~4.2M nuclei from 627 donors to resolve genetically anchored, cell-type-specific Alzheimer's programs. scCody uses generative optimal transport over cohorts to separate aging-aligned from divergent disease-associated remodeling, addressing age as a confounding axis. SPIN scales this to spatial omics, integrating cell-type co-expression networks with Bayesian regression for clinical prediction. scMINA emphasizes interpretability via XAI-based regulatory prioritization in paired multiome data. Peripheral items extend individualized modeling to fMRI brain communities (IC-GNN) and brain cell-type protein representations (SEMPER), sharing the individual- or cell-type-specific framing rather than the case-control design.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-14"
}
