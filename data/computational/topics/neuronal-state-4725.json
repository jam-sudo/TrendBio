  "item_one_liners": {},
  "label": "Interpretable Case Control Cell Modeling",
  "related": [
    "graph-neural-networks-a7c7",
    "graph-functional-6d04",
    "automated-microscopy-2e31"
  ],
  "secondary_categories": [],
  "slug": "neuronal-state-4725",
  "summary": "Five preprints propose cohort-level frameworks that resolve disease, aging or covariate-linked signal in single-cell, isoform, microbiome and fMRI data.",
  "synthesis": "The current items do not address bioimage segmentation; the common thread is modeling structured variation across donors or individuals to isolate disease- or covariate-associated signal. IDC contrasts within-donor gene covariance between cases and controls to score disease-associated cells and donor burden without batch correction. scCody uses generative optimal transport on single-cell cohorts to separate aging-aligned from divergent disease-associated remodeling. IsoVita learns interpretable compositional isoform features along continuous covariates with change point and spline tests. RoDPAA integrates multi-view microbiome data via dissimilarity-based principal angles without log-ratio transforms, and IC-GNN builds individualized brain communities from resting-state fMRI. These are linked by goal and statistical framing, not by shared data modality or direct benchmarking.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-13"
}
