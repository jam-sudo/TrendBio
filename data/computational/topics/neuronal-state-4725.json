  "item_one_liners": {},
  "label": "Deep Learning Bioimage Segmentation",
  "related": [
    "alzheimer-disease-f0f8",
    "coherence-optical-cc9c",
    "assessment-atrial-electromechanical-0756"
  ],
  "secondary_categories": [],
  "slug": "neuronal-state-4725",
  "summary": "New segmentation tools span brightfield organoids, 3D fluorescence and volume EM, alongside graph-network methods for spatial transcriptomics and fMRI.",
  "synthesis": "The dominant thread is learned segmentation and morphological quantification across imaging scales. Organotchi segments brightfield neural organoids, profiles ten morphological features and tracks organoids longitudinally. SubCellSeg is a single jointly trained 3D model for subcellular structures in hiPS cell fluorescence images (mean Dice 0.909 across 13 structures). AstroSeg-vEM uses a lightweight transformer for 3D astrocyte reconstruction from volume EM (Dice 0.92 on held-out mouse data). Graph neural network items, IC-GNN for individualized brain communities from fMRI and SpatialDG for spatial domain identification, are related only by method class. What is new is the emphasis on open, generalist or lightweight tools. The items do not show direct organoid single-cell profiling or cross-system transfer.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-12"
}
