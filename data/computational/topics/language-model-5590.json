  "item_one_liners": {},
  "label": "Computational Fragment Binding Methods",
  "related": [
    "reference-learning-6805",
    "discovery-bivalent-55cd",
    "docking-complexes-d43f"
  ],
  "secondary_categories": [],
  "slug": "language-model-5590",
  "summary": "Recent publications extend fragment-level binding computation with faster sampling, quantum-informed interaction models, and explicit water treatment.",
  "synthesis": "The dominant thread is the accuracy-cost trade-off in computing fragment-scale binding, although the methods differ considerably. Fragment dissolved molecular dynamics is extended with Gaussian accelerated MD to speed binding site identification and binding mode elucidation. A QM-AI approach trains neural networks on 1.4M MP2/TZVPP halobenzene-benzene interaction energies to predict halogen···π interactions. Separated-topologies relative binding free energy calculations are added to the BAT.py workflow and implemented in AMBER and OpenMM. A glycomimetic pipeline grafts drug-like fragments onto carbohydrate scaffolds, using a genetic algorithm with MD and MM-PBSA scoring. What is new is the explicit attention to solvent placement: crystallographic and predicted water molecules are evaluated statistically in fragment redocking and cross-docking, and the Frag2Lead benchmark is introduced for this purpose.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-30"
}
