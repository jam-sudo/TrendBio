  "item_one_liners": {},
  "label": "Single Cell Tumor Immune Profiling",
  "related": [
    "cell-single-cell-66e7",
    "ensemble-expression-4332",
    "promotes-progression-f353"
  ],
  "secondary_categories": [],
  "slug": "circadian-bioinformatics-platform-2fc7",
  "summary": "Recent multiomic studies across glioma, colorectal, pancreatic, melanoma and breast cancer link tumor cell states to immune evasion and therapy response.",
  "synthesis": "The common thread is multiomic dissection of tumor-immune microenvironments, combining scRNA-seq, snRNA-seq, spatial transcriptomics and proteomics to resolve malignant cell states alongside myeloid, dendritic, NK and T-cell compartments. Several studies are large-scale: a 69-tumor diffuse glioma atlas links IDH status to malignant and immune architecture, and a >2-million-cell CTCL atlas from 116 patients maps immune escape features. Others connect specific cell states to therapeutic outcome, including senescent-like BHLHE40+ neutrophils in colorectal liver metastasis, early neutrophil interferon signaling linked to anti-PD1 resistance in triple-negative breast cancer models, and spatial biomarkers of anti-PD1 non-response in melanoma. Newer elements are perturbation-based: CRISPR screens with single-cell readouts in pancreatic cancer identify stress pathways that sensitize tumors to CAR T cells, and PTPN22 knockout enhances NK and CAR-NK cytotoxicity.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-04"
}
