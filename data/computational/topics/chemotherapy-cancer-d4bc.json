  "item_one_liners": {},
  "label": "Quantitative Models Of Tumor Dynamics",
  "related": [
    "cancer-adaptation-cancers-df6a",
    "epidemiological-immunity-reinfection-ce00",
    "maintaining-noise-b919"
  ],
