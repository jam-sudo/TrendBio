  "item_one_liners": {},
  "label": "Benchmarking High Dimensional Omics Inference",
  "related": [
    "cellular-viral-consistency-proteome-c1e2",
    "framework-multimodal-learning-omics-e91b",
    "viral-fast-5f30"
  ],
  "secondary_categories": [],
  "slug": "mediation-error-models-bb3a",
  "summary": "Transfer and annotation claims in single-cell and pathology omics are now being checked against controlled benchmarks rather than accepted at face value.",
  "synthesis": "The shared thread is controlled testing of whether inferred single-cell and pathology outputs hold when context, dataset, or reference changes. PerturbMap transports source perturbation responses to recipient contexts using ridge experts weighted by validation performance. scOPE transfers frozen, driver-associated expression axes from bulk tumors to single cells and attaches a ground-truth-free confidence score. A patient-level benchmark of 11 pathology foundation models on 285 TCGA-BRCA patients reports that embeddings predict held-out gene programmes with rho 0.25-0.56. A controlled study finds discrete Ricci curvature utility for ranking transition regions depends on the dataset, across lineage graphs including Paul15 and Pancreas. scINTILLA scores learnability and internal consistency of cell-type labels to flag ambiguous annotations. What is new is treating transfer and graph-augmentation claims as conditional on context, with explicit checks on where they hold.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-07-31"
}
