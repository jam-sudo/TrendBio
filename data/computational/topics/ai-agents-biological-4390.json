  "item_one_liners": {},
  "label": "Predictive Model Validation Benchmarks",
  "related": [
    "optimal-transport-flow-matching-ea35",
    "screening-web-server-dda8",
    "infection-dynamics-5c07"
  ],
  "secondary_categories": [],
  "slug": "ai-agents-biological-4390",
  "summary": "Recent ML studies benchmark predictions against resistance phenotypes, transporter inhibition data, and experimental Mössbauer measurements rather than predicted activity alone.",
  "synthesis": "The common thread across these items is that predictive models are assessed against experimentally or clinically grounded endpoints rather than ranked on a single computed score. A leave-one-out cross-validated classifier predicts artemisinin resistance in P. falciparum Kelch13 mutants from structure-derived physicochemical features, targeting a phenotype of direct clinical relevance. Classic and graph-based QSAR models trained on P-gp, BCRP and MRP1 inhibition data address transporter-mediated drug-drug interaction risk. Chemprop models predict experimental Mössbauer isomer shift and quadrupole splitting for Fe complexes and protein sites, with accuracy reported as matching DFT. The items are heterogeneous in task, so this reflects a dominant methodological direction rather than a uniform finding. What is new is the explicit orientation of validation toward resistance, transport and spectroscopic endpoints.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-13"
}
