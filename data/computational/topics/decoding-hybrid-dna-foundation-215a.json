  "label": "Model Guided Binder Design",
  "related": [
    "learning-biology-small-c2ee",
    "acid-nucleic-3d5f",
    "screening-web-server-dda8"
  ],
  "secondary_categories": [
    "ml-ai"
  ],
  "slug": "decoding-hybrid-dna-foundation-215a",
  "summary": "Recent preprints and a published competition test generative and structure-based models across antibody, CAR-T minibinder, and LasB inhibitor design.",
  "synthesis": "The shared thread is coupling generative or predictive models to explicit structural, chemical, or assay context rather than using them as one-shot predictors. OFAntibody performs all-atom de novo design of monoclonal and bispecific antibodies with epitope conditioning. Hyper Screening X pairs a generative flow network encoding reaction logic with structure-based design to search an 11-trillion-compound make-on-demand space. The LasB study integrates fragment-based generative design with alchemical absolute binding free-energy ranking and experimental validation. kitAb applies AutoML over 59 interpretable Fv descriptors for assay-specific developability modeling. The Bits to Binders competition evaluated 12,000 AI-designed CD20-targeting minibinders in CAR-T cells, with 707 designs showing enrichment. What is new is the extension of context-aware generation to antibodies, minibinders, and small molecules, with prospective experimental checks. Evidence remains preliminary and largely preprint-based.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-13"
}
