  "item_one_liners": {},
  "label": "Integrative Multiomics Immune Disease Pipelines",
  "related": [
    "metabolomic-extract-96e7",
    "bacterial-host-868b",
    "regulatory-3p-6abe"
  ],
  "secondary_categories": [],
  "slug": "engineering-stability-9aac",
  "summary": "Public transcriptomic and genetic datasets are increasingly combined with single-cell analysis, machine learning, and causal inference to prioritize targets.",
  "synthesis": "The dominant thread is the layering of public or cohort omics with genetic causal inference, single-cell resolution, and machine-learning feature selection to nominate candidate genes and compounds. Mendelian randomization with colocalization or SMR appears in vitiligo, gastric cancer, psoriasis ferroptosis, and diabetic neuropathy, alongside single-cell eQTL or scRNA-seq analyses in keratoconus, psoriasis, and vitiligo. Immune and inflammatory programs anchor many items, including GM2A in psoriasis, LIPA and LTA4H in vitiligo, and CSF3R in diabetic myocardial injury. What is new is the extension of this pipeline to non-immune endpoints, such as ovarian pubertal timing, prostate cancer ageing biomarkers, and ER stress genes, and to splicing-level analysis in IBD. Most predictions remain hypothesis-generating; experimental validation is explicit in only a few items, such as the CASP3 granulosa-cell assays and the GM2A functional analyses.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-28"
}
