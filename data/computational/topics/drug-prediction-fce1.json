  "label": "Protein Conformational Dynamics Modeling",
  "related": [
    "active-levy-differential-dynamic-7827",
    "framework-viral-032a",
    "application-machine-5ed4"
  ],
  "secondary_categories": [],
  "slug": "drug-prediction-fce1",
  "summary": "Recent preprints and publications extend MD-based conformational modeling to membrane, condensate and disordered systems, with experimental validation.",
  "synthesis": "The dominant thread is the use of molecular simulation and ensemble modeling to describe how protein conformational states and energy landscapes are shaped by their environment, with predictions tested against experimental observables. Refined all-atom protein force fields are validated against SAXS and NMR, and crystallographic ensemble modeling of the SARS-CoV-2 Mac1 macrodomain links conformational entropy to ITC binding thermodynamics. Membrane context recurs across several studies: anionic lipids and bicarbonate shift the AE1 outward-to-inward transition barrier, lipid association restricts asymmetric TNF conformations in multi-microsecond MD, and membrane orientation of the SynGAP C2 domain is linked to pathogenic missense mutations that impair diffusion. What is new is extension to disordered and condensate-forming systems, with Slab-PTM adding PMF-derived coarse-grained parameters for phosphorylated, acetylated and dimethylated residues in CALVADOS and Mpipi.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-30"
}
