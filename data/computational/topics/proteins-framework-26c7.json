  "item_one_liners": {},
  "label": "Effective Population Dynamics Models",
  "related": [
    "disturbances-eco-07dc",
    "bacterial-model-9fd0",
    "coupled-mutation-quasilocalization-5c48"
  ],
  "secondary_categories": [
    "genomics"
  ],
  "slug": "proteins-framework-26c7",
  "summary": "Recent preprints derive effective descriptions of T-cell clone fixation, recurrent epidemics, alternating-environment persistence, and replicator evolution.",
  "synthesis": "The dominant thread is the reduction of stochastic or evolutionary dynamics to effective descriptions with interpretable parameters. The asymmetrically regulated birth-death study derives an effective population size and fixation results applicable to T-cell clones. The antigenic-variant study shows that population immunity carried over from past epidemics shapes recurrent epidemics according to the antigenic similarity of new variants. The alternating-environment study shows that a species losing in both environments can persist if it switches fast enough, with implications for alternating drug failure. The replicator study applies a two-timescale model of evolving fitness landscapes with an LP-based algorithm on four canonical systems. These works do not share a single mechanism; the shared element is the reduction strategy. New here are the explicit two-timescale, LP-based treatment of non-degenerate replicator landscapes and the effective population size derived for asymmetric regulation.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-07-07"
}
