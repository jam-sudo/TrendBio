  "item_one_liners": {},
  "label": "Repurposing Single Cell Foundation Models",
  "related": [
    "omics-biopsies-9eab",
    "insect-technique-4c71",
    "regulatory-gene-9c82"
  ],
  "secondary_categories": [],
  "slug": "design-principle-hypometabolism-df23",
  "summary": "scAnyOmics, MUTUAL and Top2All reuse frozen or pretrained single-cell models for cross-modality tasks, while BioTrajX adds trajectory plausibility metrics.",
  "synthesis": "The dominant thread is reuse of pretrained single-cell representations beyond their original scope. scAnyOmics distills a frozen single-cell foundation model into a multimodal student for any-to-any completion of RNA, protein and ATAC. MUTUAL aligns frozen foundation-model embeddings into a shared RNA-ATAC latent space trained on 3.0M multiome cells, enabling cross-modality analysis. Top2All benchmarks a Geneformer-based model that reconstructs transcriptome-wide expression from sparse high-expression genes in mouse adrenal RNA-seq across sex- and sex-steroid-defined conditions. Evaluation work runs alongside: BioTrajX scores pseudotime plausibility via Directionality, Order Consistency and Endpoint Validity, and a published review gives a unified mathematical categorization of 16 cell potency estimators. A second strand addresses dynamics and lineage through ManifoldVelo (joint pseudotime and RNA velocity), bowside (trajectories coupled to GRNs), LOTUS (lineage-aware unbalanced optimal transport) and lineage inpainting. VIGAT, CloneVI and IsoPrism cover gene activity, mitochondrial clones and isoform usage. The set is heterogeneous, so this is a dominant pattern, not a shared method.",
  "synthesis_model": "claude-opus-5-5",
  "synthesized_on": "2026-11-04"
}
