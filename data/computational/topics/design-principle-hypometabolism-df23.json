  "item_one_liners": {},
  "label": "Repurposing Single Cell Foundation Models",
  "related": [
    "omics-biopsies-9eab",
    "immune-aging-cb9d",
    "annular-mean-passage-f2b7"
  ],
  "secondary_categories": [],
  "slug": "design-principle-hypometabolism-df23",
  "summary": "Preprints now treat frozen single-cell foundation models as fixed backbones for multiomic completion, alignment, and imputation.",
  "synthesis": "The dominant thread is reuse of pretrained single-cell representations beyond their original scope. scAnyOmics distills a frozen single-cell foundation model into a multimodal student for any-to-any completion of RNA, protein, and ATAC modalities. MUTUAL aligns frozen foundation model embeddings into a shared RNA-ATAC latent space trained on 3.0M multiome cells, enabling cross-modality analysis. Top2All benchmarks a Geneformer-based model that reconstructs transcriptome-wide expression from sparse high-expression genes in mouse adrenal RNA-seq across sex- and sex-steroid-defined conditions. What is new is treating the foundation model as a fixed backbone for cross-modal and imputation tasks rather than retraining it. VIGAT, CloneVI and IsoPrism address gene activity quantification, mitochondrial clone inference and isoform usage with different approaches, so this pattern does not cover the full set.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-05"
}
