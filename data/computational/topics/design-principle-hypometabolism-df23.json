  "item_one_liners": {},
  "label": "Dynamics Inference From Snapshot Omics",
  "related": [
    "automated-microscopy-2e31",
    "lineage-aware-stochastic-8331",
    "insect-technique-4c71"
  ],
  "secondary_categories": [],
  "slug": "design-principle-hypometabolism-df23",
  "summary": "Seven preprints this week extend snapshot single-cell and spatial data to continuous trajectories, clonal fate and interactions, using OT, bridges and generative models.",
  "synthesis": "The dominant thread is inferring continuous dynamics and latent structure from static single-cell or spatial snapshots. ManifoldVelo jointly infers pseudotime and RNA velocity on an expression manifold, a Latent Cell-State Model treats transitions as a Markov chain with interpretable states, LOTUS applies lineage-aware unbalanced optimal transport to barcoded time-resolved scRNA-seq, and CytoBridge uses an unbalanced mean-field Schrodinger bridge on spatial transcriptomics snapshots. New is the coupling of trajectory inference with additional constraints such as topology, lineage barcodes, spatial context and interpretable states. CloneVI, CRISP and OncoSpot are adjacent: mitochondrial clone inference from cell state, cross-signal interaction analysis, and a cancer spatial simulator for benchmarking. They do not share the dynamics framing, and none of these items shows foundation model reuse.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-08"
}
