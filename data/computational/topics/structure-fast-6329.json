  "item_one_liners": {},
  "label": "Protein Property Prediction Models",
  "related": [
    "framework-deep-residual-b311",
    "ai-generated-computations-8bc2",
    "diffusion-models-60b8"
  ],
  "secondary_categories": [],
  "slug": "structure-fast-6329",
  "summary": "Recent preprints and papers combine multiple protein representations or site-aware modules to predict function, kinetics, temperature, and variant effects.",
  "synthesis": "The shared thread is moving beyond a single sequence embedding toward multimodal fusion or context-aware representation. AltereGO combines score-level predictions from four protein representations for Gene Ontology molecular function, and KINBERT pairs a protein language model with phospho-PCA pooled screening and Bayesian hierarchical modeling for kinase-substrate interactions. SAEKP fuses enzyme and substrate representations with a site attention module that reweights them to predict kcat, Km, and Ki. MIL-BC instead represents proteins as bags of automatically detected domains for EC number prediction, improving F1 by 0.03-0.17 over a sequence baseline. AdventML and ESMRank are less representation-centric: AdventML predicts optimal temperature from transformer embeddings with resampling for extremes, and ESMRank applies learning-to-rank with overlap-aware rank fusion across about 1100 deep mutational scans. The items do not share a single method; what is new is the emphasis on combining modalities or explicit site and domain structure.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-01"
}
