  "item_one_liners": {},
  "label": "Context Resolved Genomic Mechanisms",
  "related": [
    "machine-learning-3480",
    "fast-barcode-db0f",
    "identify-regions-39e0"
  ],
  "secondary_categories": [
    "single-cell"
  ],
  "slug": "advances-challenges-binning-c093",
  "summary": "Preprints and publications now pair sequence models and single-cell sequencing to link genomic context to methylation and repair mechanisms.",
  "synthesis": "The common thread is context-resolved inference of genomic mechanism from sequence, methylation, and sequencing data. MAGIC tests differential methylation in WGBS data using learned genomic contexts and context-specific dispersion shrinkage, while Melody predicts locus-specific methylation from 10-kb sequence across 39 human tissues. DNA shape, methylation and H3K27me3 profiles are linked to repair mechanisms of human structural variants, and CRISPR mutational spectra are used to infer DNA repair gene roles. Single-cell resolution is added by scWGS detection of ongoing chromosomal instability, ScisTreeCNA lineage reconstruction from SNVs and CNAs, and scATAC-seq of 38 breast cancer samples yielding 22,775 cells and 224,585 candidate cis-regulatory elements. This thread is not shared by every item, as LongPhase-S addresses somatic haplotyping and purity from long-read tumor-normal data. What is new is resolution at the level of locus, cell, and repair pathway rather than population-level association alone.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-30"
}
