  "item_one_liners": {},
  "label": "Graph Informed Transcriptomic Inference",
  "related": [
    "untitled-topic-1773",
    "learning-prediction-f8b4",
    "transcriptomics-single-ab11"
  ],
  "secondary_categories": [],
  "slug": "inference-gene-4e7e",
  "summary": "Recent preprints and papers pair graph structure or optimal transport with foundation-model embeddings for transcriptomic prediction.",
  "synthesis": "The dominant thread is inference of cellular, regulatory, or molecular structure from transcriptomic data using learned graphs or representations. DRIFT applies heat kernel diffusion on spatial graphs to single-cell foundation model embeddings, and PertAdapt adds a plug-in perturbation adapter with adaptive loss to such models for predicting transcriptional responses to single genetic perturbations. CASPER uses cross-attention over scRNA-seq centroid representations to predict unmeasured genes in spatial transcriptomics. Graph formulations also target regulatory and drug biology: Meta-TGLink casts few-shot gene regulatory network inference as link prediction with GNNs, TransMarker aligns multilayer networks across cancer states using GAT embeddings and Gromov-Wasserstein optimal transport, and SynCell predicts cell-line-contextualized drug synergy on a unified graph. What is new is the explicit coupling of graph neighbourhood or alignment structure with foundation-model representations or optimal transport, with scKGBERT adding knowledge enhancement to expression-based pretraining.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-25"
}
