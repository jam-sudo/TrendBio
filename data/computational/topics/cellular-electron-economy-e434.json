  "item_one_liners": {},
  "label": "Constraining Pretrained Nucleic Acid Generators",
  "related": [
    "protein-folding-pathway-a90a",
    "ancestry-inference-0cee",
    "comprehensive-domains-metabolic-network-80a9"
  ],
  "secondary_categories": [],
  "slug": "cellular-electron-economy-e434",
  "summary": "Recent preprints steer or re-decode pretrained generators with oracles and chemical constraints, spanning RNA, DNA, antibody and conjugate design.",
  "synthesis": "The dominant thread is controlling or repurposing pretrained biomolecular models at inference or through light adaptation rather than retraining from scratch. Structured Re-Decoding and GENECraft are training-free: the former recombines candidate outputs across molecule, protein, RNA and antibody inference, and the latter couples a genomic language model with a functional oracle for regulatory DNA. REGAL uses reinforcement learning under sequence-to-function oracles for enhancer grammar, and CupOFMoCA imposes cross-component chemical constraints in discrete flows for PROTAC and peptide-drug conjugates. B-RANKO and GenNA are foundation models, with bidirectional decoding for ncRNA and natural-language conditioning for nucleotide generation. MARRI injects mechanistic terms into RNA foundation model representations. The shared novelty is explicit functional or physical constraints on pretrained priors.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-19"
}
