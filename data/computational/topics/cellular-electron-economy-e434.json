  ],
  "secondary_categories": [],
  "slug": "cellular-electron-economy-e434",
  "summary": "Three preprints propose reduced, physically structured models of protein fluctuations, with scaling gains for B-factors and MD reduction up to 738 dimensions.",
  "synthesis": "The common thread is compact, physically structured descriptions of protein fluctuations derived from C-alpha or MD-scale data. One preprint derives a discrete Hasimoto-elasticity torsion model with a generalized von Mises density, fit on ATLAS MD chains. Another introduces a local magnitude representation for B-factor prediction from C-alpha structure, reducing factorization cost from O(N^3) to O(Nk^3). The third uses contact-gated GENERIC stochastic operators with sparse Cholesky estimation to reduce MD dynamics of proteins up to 738 dimensions, with sub-linear scaling. What is new is the emphasis on analytic or sparse reductions that retain statistical or dynamical structure at lower computational cost. The items address different observables, so the shared emphasis on reduction should not be read as a common benchmark or experimental validation.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-09"
}
