  "item_one_liners": {},
  "label": "Adapting Pretrained Biomolecular Generators",
  "related": [
    "protein-folding-pathway-a90a",
    "untitled-topic-0775",
    "protein-binding-e2f9"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "cellular-electron-economy-e434",
  "summary": "Pretrained generative models are being reused beyond their original scope for protein complexes, DNA restoration, and molecular inference.",
  "synthesis": "The dominant thread is reuse of pretrained biomolecular models for tasks outside their original formulation. ZeUS converts pretrained SE(3)-equivariant generative backbones into zero-shot symmetric protein complex generators via quotient-space symmetrization. CPDD adapts an autoregressive phage DNA language model into a bidirectional discrete diffusion model for masked and corrupted base restoration. Structured Re-Decoding operates on existing outputs rather than model weights: it is training-free and recombines candidates to expand feasible outputs for molecule, protein, RNA and antibody inference. What is new is the emphasis on starting from existing generative architectures or their outputs, with ZeUS and Re-Decoding requiring no task-specific training. The remaining entries are less direct. The Biophysical Transformer changes the pretraining target to electrostatic potential fields, and the Evoformer study probes internal layers of OpenFold rather than adapting them.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-17"
}
