  "item_one_liners": {},
  "label": "Surrogate Models Replacing Costly Computation",
  "related": [
    "protein-folding-pathway-a90a",
    "autoregressive-diffusion-mol-3e64",
    "viral-virus-606d"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "cellular-electron-economy-e434",
  "summary": "A C-alpha B-factor model cuts factorization from O(N^3) to O(Nk^3), alongside ML surrogates for solubility, Mössbauer and retention index prediction.",
  "synthesis": "Only the preprint addresses reduced protein dynamics directly: a local magnitude representation predicts B-factors from C-alpha structure and lowers factorization cost from O(N^3) to O(Nk^3), replacing dense global computation with local description. The published studies address other observables but share a surrogate-for-expensive-calculation motif. QM-derived σ-moment surface descriptors improve held-out solvent R2 from 0.541 on a fixed solvent-level OOD benchmark of 103,262 BigSolDB v2.1 records. ML models, notably Chemprop, predict Mössbauer isomer shift and quadrupole splitting for Fe complexes and protein sites at DFT-level accuracy with 218-fold lower cost. ViSRTI uses 3D geometry-aware representations to approximate NORMAN-predicted retention time indices. These are not a common benchmark, so the dynamics-reduction thread rests on the B-factor work.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-11"
}
