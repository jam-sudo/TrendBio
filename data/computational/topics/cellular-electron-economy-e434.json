  "item_one_liners": {},
  "label": "Adapting Pretrained Biomolecular Generators",
  "related": [
    "autoregressive-diffusion-mol-3e64",
    "protein-binding-e2f9",
    "untitled-topic-0775"
  ],
  "secondary_categories": [
    "ml-ai"
  ],
  "slug": "cellular-electron-economy-e434",
  "summary": "Reusing existing generative architectures and their outputs enables zero-shot and training-free design across protein complexes, molecules, RNA, and antibodies.",
  "synthesis": "The common thread is reuse of generative machinery for biomolecular design problems that fall outside a model's original scope. ZeUS converts pretrained SE(3)-equivariant generative backbones into zero-shot symmetric protein complex generators through quotient-space symmetrization. Structured Re-Decoding is training-free: it recombines candidate outputs to enlarge the feasible output set for molecule, protein, RNA and antibody inference. The remaining entries are less explicitly adaptations. CupOFMoCA applies a discrete generative method with coupled objectives to enforce cross-component chemical constraints in PROTAC and peptide-drug conjugate assembly. PFM uses a perturbed conditional probability path within flow matching for protein pocket-conditioned 3D molecule generation. What is new is the emphasis on operating on existing generative architectures or their outputs, supported most directly by ZeUS and Re-Decoding. The four works differ in modality and mechanism and share primarily this adaptation theme.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-17"
}
