  "label": "Biomolecular Conformational Dynamics Modeling",
  "related": [
    "ai-generated-computations-8bc2",
    "reveals-family-e2f1",
    "database-genome-3c30"
  ],
  "secondary_categories": [],
  "slug": "cellular-electron-economy-e434",
  "summary": "Ensemble generators and reduced dynamical operators are being tested against SAXS and MD-derived backbone statistics.",
  "synthesis": "The shared thread across these preprints is modeling conformational distributions rather than single structures. Sequence-conditioned generation of C-alpha ensembles at specified folding fractions (FoldScape) and an ablation of a C-alpha flow-matching ensemble generator both target ensemble-level outputs, with the ablation benchmarked against SAXS. A discrete elasticity model with a generalized von Mises density describes backbone torsion statistics fit on ATLAS MD chains, and a contact-gated GENERIC stochastic operator reduces MD dynamics of proteins up to 738 dimensions with sub-linear scaling. What is new here is the emphasis on reduced, statistically defined representations of dynamics. Experimental coupling appears only in the SAXS benchmark; the FoldScape summary does not show observable-level constraints, so that link should not be assumed for the group as a whole.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-08"
}
