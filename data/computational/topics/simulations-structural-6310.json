  ],
  "secondary_categories": [],
  "slug": "simulations-structural-6310",
  "summary": "New benchmarks and tools test predicted structures against MD, bilayer geometry and ensemble behavior, exposing gaps that static metrics miss.",
  "synthesis": "The dominant thread is evaluating predicted or designed structures beyond a single static fold. BILBY-PRO/BILBY-MD reports that static refolding success overstates dynamical fidelity of scaffolded motifs. Cadense is trained to reproduce MD-derived antibody Fv ensembles from sequence, and bAIes is extended across six structure predictors to generate disordered-protein ensembles judged by inter-residue distance distributions. AlphaFold3 pseudo-ensembles are tested on beta-sheet organization in amyloidogenic peptides, while ~189k AlphaFold-Multimer transmembrane complexes are checked against bilayer geometry. The PyTorch Frustratometer adds GPU-scale local frustration analysis. New here is the explicit pairing of AI predictors with MD or physical-geometry checks; the items share this orientation rather than one method.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-12"
}
