  ],
  "secondary_categories": [],
  "slug": "sequences-promoter-38cf",
  "summary": "Savant predicts affinity from sequence and SMILES alone, while GPU scoring, flow matching and consensus selection refine structure-based modeling.",
  "synthesis": "Savant is the clearest structure-free item: it predicts protein-ligand dissociation constants from amino acid sequence and SMILES without structure, docking or GPU, and uses a leakage-controlled evaluation. The other items are structure-oriented and show a looser common thread of computational efficiency and pose quality. ShEPhERD-score provides GPU-accelerated differentiable 3D similarity scoring and alignment, benchmarked on DUDE-Z. CrypticFlow uses hierarchical flow matching with Cartesian C-alpha anchors and internal-coordinate midpoints for apo-to-holo generation. AbPoolRank selects antibody-antigen models from mixed predictor pools by cross-pose agreement and geometry. Infernal-GPU parallelizes covariance-model search for RNA, and TopoPPI maps interfaces into low-distortion 2D atlases. The summaries give no quantitative comparisons, so relative performance of structure-free and structure-based routes remains unestablished.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-23"
}
