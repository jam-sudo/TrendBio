  "label": "Structure Free Binding Prediction Models",
  "related": [
    "conformational-protein-8241",
    "builder-capsid-20a5",
    "learning-biology-small-c2ee"
  ],
  "secondary_categories": [],
  "slug": "sequences-promoter-38cf",
  "summary": "Five reports tailor architectures to binding affinity, Koff, kcat-like turnover and property prediction without explicit complex structures.",
  "synthesis": "The dominant thread is architecture design for predicting protein-ligand and related molecular quantities from learned representations of sequences, fingerprints and graphs, not from explicit complex geometry. STORM is presented as a lightweight structure-free binding affinity model. MGCA combines ESM2 and Morgan fingerprints in a multi-granularity cross-attention mixture-of-experts for dissociation kinetics (Koff). EnzRef adapts frozen protein language models with reference-centered cross-attention and role-aware recomposition of reactant/product conditions for enzyme turnover. ReMoD-Mol (modality weighting plus descriptor-guided distillation) and ontology pre-training for metabolites extend the representation question to property prediction. The summaries give no validation protocols or benchmark diagnostics beyond ReMoD-Mol's comparison with 14 baselines, so evidence on generalization and scoring reliability remains limited.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-23"
}
