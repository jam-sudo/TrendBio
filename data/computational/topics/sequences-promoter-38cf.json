  "item_one_liners": {},
  "label": "Antibody Antigen Complex Model Selection",
  "related": [
    "framework-deep-residual-b311",
    "execution-topic-7655",
    "models-brain-b963"
  ],
  "secondary_categories": [],
  "slug": "sequences-promoter-38cf",
  "summary": "Several preprints add docking templates, epitope evidence or pool consensus to AF3 and Boltz-2 for antibody-antigen modeling, alongside new scoring benchmarks.",
  "synthesis": "The dominant thread is improving and filtering predicted biomolecular complexes, especially antibody-antigen ones, by adding external information or selection layers to co-folding predictors. One preprint adds PIPER rigid-body docking templates to AlphaFold 3 and Boltz-2 (success 56.2% to 63.4%). APEs uses retrieved public evidence to predict epitope residues that guide modeling. AbPoolRank ranks mixed predictor pools by cross-pose agreement and geometry. A benchmark of Boltz-2, Chai-1 and AlphaFold3 on viral nanobody complexes reports AF3 leading, with ipTM and CDR3 pLDDT cutoffs useful for filtering. Supporting work covers evaluation and scoring: ShEPhERD-score for differentiable 3D similarity, MDQ for reference-free interface comparison in MD, HiFiPL-Bench for protein-ligand scoring diagnosis, and BFEE3 for absolute binding free energies. The summaries do not support structure-free versus structure-based comparisons.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-25"
}
