  "item_one_liners": {},
  "label": "Antibody Antigen Complex Model Selection",
  "related": [
    "cryo-em-66f0",
    "immunoglobulin-topic-4ec4",
    "immrep25-unseen-peptides-fb4c"
  ],
  "secondary_categories": [],
  "slug": "sequences-promoter-38cf",
  "summary": "Antibody-antigen co-folding remains error-prone, and new work adds docking templates, epitope evidence, consensus ranking and confidence cutoffs to improve models.",
  "synthesis": "The dominant thread is improving or filtering predicted antibody-antigen complexes by wrapping co-folding predictors with external information or selection steps. One preprint adds PIPER rigid-body docking templates to AlphaFold 3 and Boltz-2, raising success from 56.2% to 63.4% on a leakage-free set. APEs predicts ranked epitope residues from retrieved public evidence to guide structure prediction and model selection. AbPoolRank ranks mixed predictor pools by cross-pose agreement and geometry, independent of the predictor. A viral nanobody benchmark finds AF3 ahead of Boltz-2 and Chai-1, with ipTM and CDR3 pLDDT cutoffs useful for filtering. GABIF (guided diffusion for antibody inverse folding) and Pep2Tcr (peptide-conditioned TCR CDR3β generation) address sequence generation rather than complex selection.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-26"
}
