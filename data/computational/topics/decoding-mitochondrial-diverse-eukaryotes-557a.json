  "item_one_liners": {},
  "label": "Transcript Quantification Benchmarking Methods",
  "related": [
    "blob-coalescent-a28c",
    "bioinformatics-bioworkflow-80e5",
    "activityfinder-automatic-8609"
  ],
  "secondary_categories": [
    "tools-infra"
  ],
  "slug": "decoding-mitochondrial-diverse-eukaryotes-557a",
  "summary": "Three preprints propose distinct ways to reduce isoform assignment ambiguity, while long-read tools extend to preprocessing, annotation and proteogenomics.",
  "synthesis": "The dominant thread is reducing ambiguity and bias in transcript-level quantification. GaussF is alignment-free, uses GC-stratified k-mer Gaussian CDF self-benchmarking, and is benchmarked against Kallisto and Salmon. A minimal-sharing k-mer strategy isolates transcript-specific regions to lower mapping ambiguity. CALMeR replaces fixed long-read MAPQ thresholds with transcript-context-conditioned filtering via zero-one inflated beta regression, improving spike-in transcript recovery. Adjacent long-read work addresses upstream and downstream steps: DirectClean handles artifacts and rescues ONT direct-cDNA reads, SQANTI-evidence annotates unannotated genomes, and LRP2 adds mass-spectrometry evidence for protein isoforms. Items such as tWhEEL, Edi-Set-Flow, tModBase v2.0 and the mitochondrial RNA processing tool address narrower questions and do not share the quantification focus.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-05"
}
