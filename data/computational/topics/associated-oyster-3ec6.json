  "item_one_liners": {},
  "label": "Cell Type Resolved Omics Databases",
  "related": [
    "intestinal-liver-mice-0dd6",
    "database-comprehensive-2096",
    "aspidoscelis-whiptail-0f6c"
  ],
  "secondary_categories": [],
  "slug": "associated-oyster-3ec6",
  "summary": "Several new database releases extend cell-type- and species-resolved annotation to isoforms, R-loops, perturbations and drug sensitivity in a single issue cycle.",
  "synthesis": "The dominant thread is re-analysis and integration of heterogeneous omics into queryable resources with cell-type or context resolution. scSpAS integrates single-cell and spatial isoform regulation (ATS, splicing, APA, full-length isoforms); R-loopBase v2.0 re-analyses 358 datasets from 16 technologies with quantitative confidence scoring across four species; iGPSC-DB infers a single-cell genetic perturbation atlas in tumors. RNAactDrug 2.0 and LncRNAfunc 2.0 link multi-omic and lncRNA evidence to drug sensitivity and cancer function, drawing on resources such as TCGA, GTEx and CCLE. RIFTT is a tool-level variant, combining Arriba and FusionCatcher with new scoring to reduce fusion false positives. The awesome-single-cell list catalogues related software. New contributions are mainly breadth, scoring and access, not new biological findings.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-06"
}
