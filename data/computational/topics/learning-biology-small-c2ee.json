  "item_one_liners": {},
  "label": "Protein Function Prediction Models",
  "related": [
    "metabolism-proteomics-41aa",
    "protein-generation-b3ca",
    "biological-brain-types-006a"
  ],
  "secondary_categories": [],
  "slug": "learning-biology-small-c2ee",
  "summary": "Recent preprints and one published study apply protein language models and graph learning to sequence-based function prediction.",
  "synthesis": "The common thread is supervised sequence-based prediction of protein function, with learned representations increasingly used alongside or instead of profile-based methods. CarmnaDD predicts nitrogenase activity from sequence alone using learnable dual-descriptor weights, while PhageLysClass applies ESM2 embeddings with a hierarchical classifier to separate phage lytic proteins and endolysins. At residue level, SCOPE and TREAD address catalytic residue prediction and repeat annotation; TREAD reports gains over HMMER on RepeatsDB and Pfam benchmarks. GlycanPUG extends this approach to structurally ambiguous glycans, encoding WURCS 2.0 strings as heterogeneous graphs with uncertainty-weighted edges. What is new is the pairing of pretrained representations with explicit uncertainty or evidence handling and benchmark-centred validation, though only SCOPE reports experimental mutagenesis support in these items.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-25"
}
