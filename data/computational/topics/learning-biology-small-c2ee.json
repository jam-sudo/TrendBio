  "label": "Enzyme Function Prediction Benchmarks",
  "related": [
    "end-ampair-ee7c",
    "conformational-protein-8241",
    "enzyme-database-7c50"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "learning-biology-small-c2ee",
  "summary": "Recent preprints and one publication test protein language models and graph learning for enzyme function prediction.",
  "synthesis": "The dominant thread is predicting enzyme catalytic behaviour from protein sequence and structure, with explicit attention to reaction context and benchmark rigour. EnzRef adapts frozen protein language models through reference-centred cross-attention and role-aware recomposition of reactant and product conditions for turnover prediction. CarmnaDD predicts nitrogenase activity from sequence alone using learnable dual-descriptor weights, and SCOPE performs residue-level graph learning for catalytic residue prediction from structure and evolution, validated by mutagenesis. PhageLysClass applies ESM2 embeddings with a hierarchical classifier to phage lytic proteins. MCDBench contributes a curated benchmark of 792 medium-chain dehydrogenase enzyme-substrate-cofactor combinations that includes validated inactives, targeting comparative evaluation. The publication on MSA Transformer features for reaction-conditioned enzyme recommendation reports mixed gains, a useful caution for evolutionary feature augmentation. What is new is the emphasis on reaction-aware inputs and inactive-inclusive benchmarking rather than generative capacity.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-24"
}
