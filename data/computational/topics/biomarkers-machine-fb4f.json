  "item_one_liners": {},
  "label": "Transcriptomic Machine Learning Biomarker Discovery",
  "related": [
    "promotes-progression-f353",
    "pathway-diabetic-c074",
    "fetal-preeclampsia-cfc2"
  ],
  "secondary_categories": [
    "single-cell"
  ],
  "slug": "biomarkers-machine-fb4f",
  "summary": "Public transcriptomic cohorts are routinely re-mined with WGCNA and machine learning to nominate candidate biomarker panels across diverse diseases.",
  "synthesis": "The dominant thread is re-analysis of public transcriptomic data, typically GEO or TCGA cohorts, combining differential expression or WGCNA with machine-learning feature selection to reduce gene sets to small candidate panels. Examples include TNFSF14 and CD83 in allergic rhinitis, JAK1 and GATA3 in sepsis, GLUL, GPX3 and KCND2 in preeclampsia with a nomogram reporting AUC 0.973, and PLG in clear cell renal cell carcinoma. Not all items share this approach: the insecticide and Parkinson's study generates 562,117 candidate adverse outcome pathways through knowledge-base integration, and the 6PPD-Q analysis is explicitly computational. Experimental validation appears in a subset, including TRIP10 in fetal growth restriction, RELB in ovarian cancer, and TFAP2E with IHC. Across the set, the principal output is candidate nomination, with experimental confirmation reported for only a subset.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-01"
}
