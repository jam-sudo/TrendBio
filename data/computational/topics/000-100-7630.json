  "label": "Llm Agents For Bioinformatics",
  "related": [
    "validated-gene-ad03",
    "machine-learning-3480",
    "diabetes-type-4df1"
  ],
  "secondary_categories": [
    "tools-infra"
  ],
  "slug": "000-100-7630",
  "summary": "Five preprints pair LLM agent scaffolding with benchmarks and ground-truth testing for biological analysis, from variant reinterpretation to clinical sequencing.",
  "synthesis": "The dominant thread is constraining and evaluating LLM-driven analysis in biology. PRISM runs an agentic pipeline over 3.9M health community posts to surface ClinVar variant reinterpretation needs. The Reasoning Paradox preprint reports that DTDR scaffolding raises accuracy in bioinformatics agent sandboxes from 0% to 9.09% and cuts steps by 66%. SPaRTA provides a text-to-spatial-SQL interface for spatial omics with a 7,500-pair benchmark and analysis of LLM failure modes. BioResearchBench adds 50 expert-written long-horizon research tasks. Separately, an in silico framework tests clinical sequencing pipelines against planted truth variants, with stage-localized failure attribution. What is new is the combination of agent scaffolding with task benchmarks and truth-based regression testing. Reported figures come from distinct tasks and are not comparable across papers.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-08"
}
