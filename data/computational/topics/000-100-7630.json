  "item_one_liners": {},
  "label": "Reliability Audits For Biological Design",
  "related": [
    "phylogenetic-scalable-0e43",
    "targeting-design-7b7f",
    "visualization-exploration-8b6a"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "000-100-7630",
  "summary": "Four new preprints audit whether conformal guarantees, activity models, and protein model confidence support the design decisions they inform.",
  "synthesis": "The dominant thread is a shift from reporting predictive performance toward asking what a model's output can actually support in guide and sequence design. The conformal selection study argues that finite-sample certification of CRISPR off-target candidates would require roughly 20,000 guides, compared with 10 in public cohorts, and flags grouping leakage in CIRCLE-seq benchmarks alongside free baselines. Silscore models siRNA potency from guide-only positional nearest-neighbour thermodynamics with sparse nucleotide-identity terms and reports transfer to external data. TriCasRank combines sequence features, EasyDesign reference mapping, and fold-internal historical summaries to rank Cas12a crRNA activity, and its gains depend on when ensembling helps and when context matters more. The protein language model audit documents a steering cliff in generate-and-screen design and finds that predicted confidence cannot certify outcomes. These items differ in task and are not directly comparable; the shared element is explicit scrutiny of evaluation design and of what confidence or ranking scores license.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-13"
}
