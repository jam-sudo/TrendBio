  "label": "Llm Agents Bioinformatics Evaluation",
  "related": [
    "validated-gene-ad03",
    "repeat-bacterial-c56b",
    "graphs-reasoning-cc09"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "000-100-7630",
  "summary": "Three preprints apply LLMs to biological reasoning tasks and probe their limits, from variant outreach to identifiability to protein design confidence.",
  "synthesis": "The common thread is applying LLMs to biological analysis while testing what their outputs can support. PRISM uses an agentic pipeline over 3.9M online health community posts to surface ClinVar variant reinterpretation needs and draft outreach. A benchmark of LLMs classifying parameter-level structural identifiability in epidemic ODE models reports top accuracy of about 88%. A protein language model audit examines steering and ESMFold confidence readouts for generate-and-screen design, reporting a steering cliff and arguing that predicted confidence cannot certify outcomes. The items span different tasks and are not comparable, but each pairs an LLM-based capability with an explicit evaluation of its reliability. The first is an applied population-scale screen, the second a benchmark, and the third a diagnostic audit.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-12"
}
