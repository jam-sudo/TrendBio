  "label": "Llm Agents For Bioinformatics Workflows",
  "related": [
    "validated-gene-ad03",
    "diabetes-type-4df1",
    "machine-learning-3480"
  ],
  "secondary_categories": [],
  "slug": "000-100-7630",
  "summary": "Five preprints pair LLM-agent pipelines with benchmarks and truth-based testing, probing where automated genomic and omics analysis fails.",
  "synthesis": "The dominant thread is tooling that constrains and evaluates LLM-driven analysis in biology. PRISM applies an agentic pipeline to 3.9M health community posts to surface ClinVar variant reinterpretation needs. The Reasoning Paradox preprint reports that DTDR scaffolding lifts accuracy in bioinformatics agent sandboxes from 0% to 9.09% while cutting steps 66%. SPaRTA offers a text-to-spatial-SQL interface for spatial omics with a 7,500-pair benchmark, and BioResearchBench contributes 50 expert-written long-horizon research tasks. Separately, an in silico framework tests clinical sequencing pipelines against planted truth variants from reads to reportable findings, with stage-localized failure attribution. What is new is the pairing of agent scaffolding with benchmarks and truth-based regression testing. Reported figures come from distinct tasks and are not comparable across papers.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-07"
}
