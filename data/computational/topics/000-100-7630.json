  "label": "Reliability Audits For Biological Design",
  "related": [
    "database-genome-3c30",
    "phylogenetic-scalable-0e43",
    "visualization-exploration-8b6a"
  ],
  "secondary_categories": [
    "structural"
  ],
  "slug": "000-100-7630",
  "summary": "New preprints test what confidence and ranking scores support in CRISPR, siRNA and protein design, exposing benchmark leakage, cohort limits and steering failures.",
  "synthesis": "The dominant thread is scrutiny of what a model's output licenses in sequence design, beyond reporting predictive performance. The conformal selection study finds public CRISPR off-target cohorts (10 guides) fall far short of the roughly 20,000 needed for finite-sample certification, and reports CIRCLE-seq grouping leakage and free baselines. The protein language model audit reports a steering cliff and finds that predicted confidence cannot certify design outcomes. Silscore and TriCasRank are constructive by comparison: a compact positional-thermodynamic siRNA potency model with external transfer, and a Cas12a crRNA ranker whose gains depend on when ensembling or context matters. PEEK is a tooling paper validated in silico and by whole-plasmid sequencing. Tasks differ and results are not directly comparable.",
  "synthesis_model": "claude-sonnet-5-5",
  "synthesized_on": "2026-11-14"
}
