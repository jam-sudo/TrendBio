  "item_one_liners": {},
  "label": "Population Scale Expression Modeling",
  "related": [
    "transcriptome-automated-read-8fb5",
    "graph-spatially-resolved-transcriptional-1f48",
    "graph-neural-networks-a7c7"
  ],
  "secondary_categories": [],
  "slug": "scalable-commodity-1353",
  "summary": "Large GTEx and single-cell cohorts now allow expression variation to be tested at population scale across tissues, cell types and sexes.",
  "synthesis": "The dominant thread is statistical modeling of expression and composition variation across large population cohorts. A preprint benchmarks 12 differential composition methods on three population-scale scRNA-seq datasets using real-data analysis, permutations and simulations. SAIGE-QTL, a Poisson mixed model for single-cell read counts, is reported to improve calibrated, scalable eQTL mapping over pseudobulk approaches. A preprint adapts Shannon evenness to quantify isoform diversity across 4,814 GTEx samples, presenting it as a distinct gene-expression dimension that varies by tissue. A published study quantifies enhancer RNA from GTEx RNA-seq and finds that 47% of active enhancers show sex bias across 41 tissues. What is new is that isoform usage, enhancer activity and single-cell counts are each modeled as population-scale readouts. The head MRI bone marrow adiposity study is an imaging-derived genetic-association analysis that sits alongside these items.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-09"
}
