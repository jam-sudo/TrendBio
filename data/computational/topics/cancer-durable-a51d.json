  "item_one_liners": {},
  "label": "Prognostic Signatures Across Cancers",
  "related": [
    "pharmacology-validation-6359",
    "metabolomic-ms-5119",
    "comparative-antimicrobial-68c6"
  ],
  "secondary_categories": [
    "epigenomics"
  ],
  "slug": "cancer-durable-a51d",
  "summary": "Public bulk and single-cell cohorts now routinely pair survival-based gene signatures with microenvironment profiling across multiple tumor types.",
  "synthesis": "The dominant thread is risk stratification from public transcriptomic cohorts, in which bulk survival modeling is paired with single-cell or spatial profiling to place prognostic genes within immune and stromal programs. Colorectal cancer contributes several models, including a four-gene READ-derived recurrence score and a neuro-immune score linked to a stromal-neural, immune-segregated microenvironment and poor prognosis. Related signatures appear in melanoma (15-gene post-translational modification score), head and neck squamous cell carcinoma (eight-gene T cell-associated RiskScore), hepatocellular carcinoma (adrenomedullin receptor signaling model), and lung adenocarcinoma (TRPM4-related sodium overload signature). What distinguishes this work is explicit linkage of scores to microenvironment states and, in limited cases, experimental validation, as with RNPEPL1 in lung adenocarcinoma. Several findings are explicitly exploratory, and most remain correlative.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-08-19"
}
