  "label": "Transformers For Gene Regulatory Inference",
  "related": [
    "language-large-018c",
    "learning-prediction-f8b4",
    "metabolic-algorithms-4214"
  ],
  "secondary_categories": [
    "systems"
  ],
  "slug": "species-specific-10f8",
  "summary": "Public transcriptomes and single-cell perturbation data now train graph and transformer models to recover regulatory and functional gene relationships.",
  "synthesis": "The dominant thread is the application of transformer and graph neural network architectures to gene-level regulatory prediction from transcriptomic and genomic data. GRNPred pairs a multimodal graph transformer with masked gene-expression pretraining and supervised fine-tuning for TF-target network inference, while PSGRN uses self-training with synthetic gold standards on single-cell perturbational RNA-seq. TEA-GCN builds condition-specific ensemble co-expression networks from public RNA-seq and is benchmarked on gene function and GRN tasks. GlncDDR applies a graph neural network embedding with supervised learning to predict DNA damage response-associated lncRNAs, and APMF applies multi-granularity transformer contrastive learning to disease-related miRNA prediction. CASER extends the pattern to semi-supervised integration of multi-omics data for cancer-associated epigenetic regulator genes. What is new is the combination of masked expression pretraining, graph-structured encoders, and self-training on synthetic gold standards applied to network inference.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-04-30"
}
