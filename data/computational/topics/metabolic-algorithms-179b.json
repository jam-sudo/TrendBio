  "item_one_liners": {},
  "label": "Agentic Tools For Molecular Discovery",
  "related": [
    "eeg-topic-c715",
    "molecular-graph-18ef",
    "graph-predicting-38af"
  ],
  "secondary_categories": [
    "metabolomics",
    "ml-ai"
  ],
  "slug": "metabolic-algorithms-179b",
  "summary": "Agentic platforms now autonomously train PPI predictors, induce readable rules, and ground LLM outputs in deterministic tool execution.",
  "synthesis": "The dominant thread is agentic orchestration of learned models and domain tools for molecular and biomedical discovery. Two platforms autonomously train human-human and virus-human PPI predictors and induce human-readable rules, reporting 87.3% and 86.5%. MSAgent orchestrates more than 50 mass spectrometry tools for evidence-grounded molecular identification, improving CASMI retrieval MRR by over 10%. BioChirp separates LLM interpretation from deterministic Steiner-tree retrieval, recovering more complete and reproducible records. OptimusKG contributes a multimodal biomedical labeled property graph built from 18 ontologies, with schema constraints and provenance. What is new across these items is the explicit separation of language-model interpretation from deterministic execution, paired with evidence grounding. This pattern is explicit in BioChirp and MSAgent rather than universal across the set.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-04-30"
}
