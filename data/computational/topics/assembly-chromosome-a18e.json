  "item_one_liners": {},
  "label": "Variant And Repeat Inference Tools",
  "related": [
    "inference-species-b1d2",
    "bacterial-genetic-32fc",
    "phylogenetic-scalable-9728"
  ],
  "secondary_categories": [],
  "slug": "assembly-chromosome-a18e",
  "summary": "Recent preprints and papers present read-based tools for variant calling, shared-haplotype queries and tandem repeat sizing designed for scale.",
  "synthesis": "The dominant thread is inference of variation, shared haplotype structure and repeat architecture directly from sequencing reads, with minimal model assumptions. SNooPy calls SNPs in long-read metagenomic data without assuming haplotype number, relationships, or divergence. bronko detects viral SNPs and minor variants through alignment-free k-mer pseudo-mapping that scales near-linearly. PBML enumerates SMEMs shared by at least k haplotypes over at least L sites on a reusable run-length PBWT index. For tandem repeats, ScatTR estimates copy number of large expansions from short reads using a maximum-likelihood Monte Carlo method, and EquiRep reconstructs repeat units from error-prone reads. What is new is explicit design for computational scale, index reuse and assumption-light inference. The repeat tools address different data types and methods rather than sharing the haplotype-index approach.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-12-08"
}
