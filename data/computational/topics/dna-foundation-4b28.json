  "item_one_liners": {},
  "label": "De Novo Peptide Sequencing Benchmarks",
  "related": [
    "spectrum-prediction-35c1",
    "arny-comprehensive-web-6066",
    "metabolomics-ms-dcd7"
  ],
  "secondary_categories": [
    "proteomics"
  ],
  "slug": "dna-foundation-4b28",
  "summary": "Benchmarks show shared de novo peptide errors from limited fragment coverage, alongside new fragment-ion and structural priors for MS/MS identification.",
  "synthesis": "The dominant thread is that MS/MS identification is being evaluated against explicit reference data and constrained by learned or structural priors. The published benchmark of eight de novo peptide sequencing models on three proteomics datasets reports shared errors tied to limited fragment coverage, indicating that model class alone does not resolve sequence ambiguity. The preprints extend this logic beyond peptides: FACET enumerates the complete feasible set of molecular formulas from precursor mass before neural ranking, Carafe uses deep learning fragment-ion intensity prediction to prune the Comet fragment ion index, and DEEPNET-LLM restricts de novo metabolite structure prediction to molecular-community neighborhoods. What is new is treating fragment-ion evidence and the priors placed on it as the variables under validation.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-04"
}
