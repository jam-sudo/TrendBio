  "item_one_liners": {},
  "label": "Binding Prediction Validation Benchmarks",
  "related": [
    "immrep25-unseen-peptides-fb4c",
    "immunoglobulin-topic-4ec4",
    "controlled-peptide-2d9b"
  ],
  "secondary_categories": [
    "proteomics",
    "structural",
    "tools-infra"
  ],
  "slug": "dna-foundation-4b28",
  "summary": "Recent preprints and papers tie binding-model claims to explicit input scope and reference-standard benchmarking.",
  "synthesis": "The dominant thread is that binding and presentation claims are being anchored to explicit inputs and reproducible reference standards. LangAAI conditions an antibody language model on antigen sequence without structure, reporting improved CDR3 modeling and affinity ranking. BenchMHC reproduces and retrains peptide-MHC presentation models on public data, reporting NetMHCpan-4.1 reproduction. POISK benchmarks six structure predictors on binder versus decoy discrimination across 89,074 antibody-antigen records. Hi-TPH pairs a hierarchical dataset with on-the-fly nonbinding selection for TCR-pHLA prediction, and a published AlphaFold 3 study reports median AUCs of 0.81-0.92 across more than 9000 TCRs. IgScope and PepPr sit at the periphery, centring on humanness scoring and proteome-trained sequence priors rather than binding benchmarks. What is new is treating input scope and benchmark construction, including negative selection, as first-class validation variables.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-10-30"
}
