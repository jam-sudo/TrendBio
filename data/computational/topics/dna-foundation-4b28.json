  "item_one_liners": {},
  "label": "De Novo Peptide Sequencing Benchmarks",
  "related": [
    "arny-comprehensive-web-6066",
    "spectrum-prediction-35c1",
    "design-automated-f642"
  ],
  "secondary_categories": [],
  "slug": "dna-foundation-4b28",
  "summary": "Benchmarks now expose shared de novo sequencing errors while priors and deep learning fragment prediction target search efficiency.",
  "synthesis": "Across these items, the common thread is that peptide sequencing and tandem MS database search are being evaluated against explicit reference data and constrained by learned priors. PepPr adds a proteome-trained language-model peptide prior to de novo sequencing, reporting improved identification of reference and variant peptides. Carafe's deep learning fragment-ion intensity prediction prunes the Comet fragment ion index, reducing index memory and accelerating database searches. A benchmark of eight de novo models on three proteomics datasets reports shared errors attributed to limited fragment coverage, suggesting that model architecture alone does not resolve sequence ambiguity. What is new is treating fragment-ion evidence and the priors placed on it as the variables under validation, rather than the model class itself.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-03"
}
