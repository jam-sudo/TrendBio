  "label": "Interpretable Sequence Models For Regulation",
  "related": [
    "learning-prediction-f8b4",
    "gene-models-b8d8",
    "inference-gene-4e7e"
  ],
  "secondary_categories": [],
  "slug": "omics-integration-network-oriented-e5ce",
  "summary": "Recent work pairs sequence models with interpretable units, now extending from DNA motifs to protein and miRNA sequence inputs.",
  "synthesis": "The common thread is sequence-based prediction of regulatory outcomes in which model architecture is tied to interpretable biological units. InfluenceNet uses a transparent convolutional model whose position- and motif-specific influence profiles expose cis-regulatory syntax, while Bag-of-Motifs reduces distal enhancers to unordered TF motif counts modeled with gradient-boosted trees to predict cell type-specific enhancers. MiRformer instead applies a dual-transformer encoder with sliding-window attention to raw miRNA-mRNA sequence pairs, predicting interactions and binding or cleavage sites. The new element is extension beyond DNA motifs: protein language models are fine-tuned to identify transcription factors and predict methylated-DNA binding preference, with attention-based interpretation. The U2-type intron study in A. thaliana is more distinct, reporting that shorter introns aid acceptor but not donor site prediction.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-11-30"
}
