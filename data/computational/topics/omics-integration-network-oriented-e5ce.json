  "item_one_liners": {},
  "label": "Dna Sequence Representation Learning",
  "related": [
    "drug-prediction-fce1",
    "kinetic-learning-interpretable-f729",
    "ancient-plants-0668"
  ],
  "secondary_categories": [],
  "slug": "omics-integration-network-oriented-e5ce",
  "summary": "Recent preprints and a published benchmark of five DNA foundation models test how input representation shapes variant effect and genomic prediction.",
  "synthesis": "The dominant thread is input representation: how biological sequence is converted into model inputs before learning. Mut-BPE adds single-nucleotide resolution at variant sites to training-free BPE and improves variant effect prediction in DNABERT-2. PatchDNA replaces tokenization with patches whose boundaries follow evolutionary conservation. TEA derives a 20-letter protein alphabet from contrastive learning on protein language model embeddings, a related move toward redefined units. deepFEPS consolidates k-mer, transformer, autoencoder and graph embeddings in one toolkit for DNA, RNA and protein. A published benchmark of five DNA foundation models on zero-shot genomic tasks supplies comparative context. TIDE and DPCMHC address peptide-MHC and TCR binding with different architectures and are adjacent rather than DNA-specific. What is new is emphasis on biologically informed boundaries and resolution rather than a shared model class.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2025-12-04"
}
