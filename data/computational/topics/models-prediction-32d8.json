  "item_one_liners": {},
  "label": "Learned Models For Biological Prediction",
  "related": [
    "protein-generation-b3ca",
    "prediction-drug-0697",
    "ancestry-inference-0cee"
  ],
  "secondary_categories": [],
  "slug": "models-prediction-32d8",
  "summary": "Recent preprints and one 2026 publication test whether learned models can rank, audit, and steer predictions of mutation and editing outcomes.",
  "synthesis": "The dominant thread is evaluating learned sequence and structure models against defined biological targets, often without task-specific training. VenusRAR ranks and audits protein language model zero-shot mutation predictions under biophysical constraints, reporting ProteinGym Spearman 0.551. DETANGO decomposes protein language model mutation effects into stability and functional components to flag stable-but-inactive variants. Protein2PAM predicts Cas PAM specificity from sequence and guides computational evolution. Beyond protein sequence, an open-weights LLM benchmark on three CRISPR screens reaches 0.715 AUROC for zero-shot synthetic lethal prediction, and AdarEdit applies structure-explicit graph attention to A-to-I RNA editability across GTEx tissues. What is new is the explicit structuring of objectives: biophysical constraints, separated stability and function terms, and zero-shot reasoning over screen data.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-02-05"
}
