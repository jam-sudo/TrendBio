  "item_one_liners": {},
  "label": "Inferring Single Cell Dynamics",
  "related": [
    "insect-technique-4c71",
    "size-detection-antimicrobial-da52",
    "lineage-aware-stochastic-8331"
  ],
  "secondary_categories": [
    "transcriptomics"
  ],
  "slug": "scientific-fair-5429",
  "summary": "Time-resolved and spatial transcriptomics now supply the data to infer cell-state transitions and their drivers directly from expression.",
  "synthesis": "The dominant thread is inferring dynamical behaviour of cells from transcriptomic data rather than describing static states. ST-FateFlow uses flow matching to jointly model gene-expression and spatial velocity fields, together with a time-conditioned differentiation potential learned from time-resolved spatial transcriptomics. CellVocal integrates spatial RNA velocity with cell-cell communication to attribute cell-state transitions to intrinsic and signalling components in mouse data. SpOTr applies Fused Gromov-Wasserstein optimal transport with a spot deconvolution model to integrate single-cell and spatial transcriptomics, mapping tumor data. Spectrast recasts spatial autocorrelation statistics as FFT-based convolutions for multiscale per-gene analysis, a descriptive rather than dynamical approach. The Fish Metastasis Atlas addresses organ-specific Ewing sarcoma dissemination in zebrafish, a distinct question. What is new is the explicit inclusion of signalling and interaction terms within inferred dynamics, most directly realized in CellVocal, while ST-FateFlow contributes a learned differentiation potential over time.",
  "synthesis_model": "claude-haiku-5-5",
  "synthesized_on": "2026-11-18"
}
