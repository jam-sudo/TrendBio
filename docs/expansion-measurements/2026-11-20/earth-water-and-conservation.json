  "review_outcomes": {
    "weekly_rank": "The November 4 ocean-data group retained the same order, three papers, headline, short summary and full brief. Its papers combine in situ measurements with other observations or a model to build ocean datasets. One collocated temperature and salinity with satellite-tracked eddies, one assimilated observations in Ise Bay, and one reconstructed historical sea-surface winds.",
    "rank_sources": [
      "https://doi.org/10.5194/essd-18-7817-2026",
      "https://doi.org/10.5194/essd-18-7839-2026",
      "https://doi.org/10.5194/essd-18-7963-2026"
    ],
    "model_status": "All five primary collections and group reviews completed. Three repeat editions carry the same individual enrichment fallback as their nine-journal baselines. All three concern earlier journals. No new-journal fallback or summary fallback occurred.",
    "control_selection": "Among all relevant three-paper combinations with at least one article from the focal journal, choose the unranked one with the highest minimum pairwise cosine similarity across the four comparison weeks. Repeat separately on the reserved September week. A group review may see a larger candidate containing the full triple. One reader checked the source abstracts and methods.",
    "controls": [
      {
        "branch": "hydrology",
        "sample": "comparison",
        "date": "2026-11-04",
        "minimum_pair_similarity": 0.927137,
        "reached_group_review_together": true,
        "judgment": "supported exclusion",
        "evidence": "The three teams estimated groundwater storage and soil moisture in the Brahmaputra basin, hourly rainfall in Australia, and snow water equivalent in Italy. They evaluate different quantities and offer no common three-paper result.",
        "sources": [
          "https://doi.org/10.5194/hess-30-6623-2026",
          "https://doi.org/10.5194/hess-30-6701-2026",
          "https://doi.org/10.5194/hess-30-6763-2026"
        ]
      },
      {
        "branch": "hydrology",
        "sample": "independent",
        "date": "2026-09-16",
        "minimum_pair_similarity": 0.917446,
        "reached_group_review_together": false,
        "judgment": "supported exclusion",
        "evidence": "A Chinese benchmark reconstructed half-hourly latent heat flux. A station-network study tested spatial interpolation of rainfall and temperature. A French study evaluated a climate model against observed extremes. They address different targets, even where precipitation appears in two of the studies.",
        "sources": [
          "https://doi.org/10.5194/essd-18-6707-2026",
          "https://doi.org/10.5194/hess-30-5791-2026",
          "https://doi.org/10.5194/hess-30-5833-2026"
        ]
      },
      {
        "branch": "conservation",
        "sample": "comparison",
        "date": "2026-11-04",
        "minimum_pair_similarity": 0.902088,
        "reached_group_review_together": true,
        "judgment": "supported exclusion",
        "evidence": "The Indian elephant study primarily analyzed existing policy documents and other secondary sources. The Zimbabwean ostrich and Pakistani wolf studies collected household responses. A three-survey comparison would misstate the evidence. The publisher identified the Indian contribution as Original Research. Field screening admitted it and the group review excluded it.",
        "sources": [
          "https://doi.org/10.3389/fcosc.2026.1839149",
